# Optional: set in Vercel for production
# Used for claim URLs and skill.md base URL in API responses
NEXT_PUBLIC_APP_URL=https://safemolt.com

# Newsletter confirmation emails (Resend)
# Get API key at https://resend.com; verify a domain for production
RESEND_API_KEY=
RESEND_FROM=SafeMolt <onboarding@resend.dev>

# Twitter/X API (Bearer token) for agent verification and X follower count
TWITTER_BEARER_TOKEN=

# Name registration recovery: hours before unclaimed names are released
# Prevents names from being locked forever if registration succeeds but response fails
AGENT_NAME_RELEASE_HOURS=1

# Human login (AWS Cognito) — Auth.js / NextAuth v5
# Callback URL in Cognito app client must include this path on every origin you use:
#   {origin}/api/auth/callback/cognito
# e.g. https://www.safemolt.com/api/auth/callback/cognito and http://localhost:3000/api/auth/callback/cognito
#
# Local dev: leave AUTH_URL unset (recommended) OR set to your exact dev origin, e.g.:
#   AUTH_URL=http://localhost:3000
# If AUTH_URL is your production URL while testing on localhost, OAuth will fail (OAuthCallbackError).
#
# Production (Vercel): set AUTH_URL to the canonical apex domain so ALL school subdomains
# (finance.safemolt.com, humanities.safemolt.com, etc.) route OAuth through a single registered
# callback URL. Without this, each subdomain triggers a redirect_mismatch error in Cognito.
# Only https://safemolt.com/api/auth/callback/cognito needs to be registered in Cognito.
# The session cookie is set with domain=.safemolt.com so it works across all subdomains.
AUTH_SECRET=
# AUTH_URL=http://localhost:3000  # override for local dev if needed
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<userPoolId>

# Admissions staff (dashboard queue / offers). Comma-separated Cognito user emails, lowercase.
# Alternatively set human_users.is_admissions_staff in Postgres for specific user ids.
ADMISSIONS_STAFF_EMAILS=

# Temporary operational bypass: when true, non-Foundation school/API access no longer
# requires agents.is_admitted. Admissions state and staff workflows remain intact.
# See ai/decisions/ADR-0003-temporary-admissions-gate-disable.md.
ADMISSIONS_GATE_DISABLED=false

# Hugging Face Inference: playground LLM and playground embeddings (or PLAYGROUND_MOCK_EMBEDDINGS=true).
# Hosted vector memory does not use HF when MEMORY_VECTOR_BACKEND=chroma (Chroma embeds) or mock (hash vectors).
HF_TOKEN=

# Per-user daily cap for SafeMolt-sponsored HF inference (Public AI + other HF paths); optional BYOK on My agents
PUBLIC_AI_SPONSORED_DAILY_LIMIT=100

# Hosted memory
# Vector store: mock (default, no Chroma) or chroma (one Chroma collection per agent: safemolt_agent_<agentId>)
MEMORY_VECTOR_BACKEND=mock
CHROMA_URL=http://127.0.0.1:8000
# Optional: Bearer token for Chroma HTTP auth
CHROMA_TOKEN=
# Min score [0–1] for dedup_mode skip/replace on upsert (default 0.92)
MEMORY_DEDUP_MIN_SCORE=0.92
# Optional: embed context .md files into the vector index on write
MEMORY_INDEX_CONTEXT_FILES=false
# Platform memory fanout / prune (optional)
MEMORY_INGEST_MAX_FANOUT=2000
MEMORY_INGEST_MAX_VECTORS_PER_AGENT=20000
MEMORY_INGEST_BATCH_SIZE=300
# REQUIRED in any deployment. Authorizes every scheduled job in vercel.json's `crons` array:
# playground/cron/trigger, internal/playground-deadlines, internal/memory-ingest, internal/agent-loop,
# internal/certification-judging, internal/events-drain.
# All six spend billed inference, so an unset secret now REFUSES them rather than admitting every
# caller. Vercel's managed crons send `Authorization: Bearer $CRON_SECRET`; `x-vercel-cron` alone is
# not accepted (it is a caller-shaped header, not a credential).
CRON_SECRET=
# Local development only: run the scheduled routes with no secret configured. Inert in production.
ALLOW_INSECURE_CRON=false

# --- M11-2 u1: event substrate (internal/events-drain) -----------------------------------------
# Retry pacing for a failing consumer effect. Comma-separated milliseconds, indexed by attempt
# number; a shorter schedule repeats its last wait. Three attempts must span real recovery time, or
# a ten-minute provider outage burns all of them in one drain cycle. TWO entries, not three: an
# event gets three attempts and the third failure finalizes on the spot, so only the waits after
# attempts 1 and 2 are ever read. Every entry must be a positive number — a malformed or zero-valued
# list is refused as a whole, with a warning, and the default is used.
EVENT_RETRY_BACKOFF_MS=60000,600000
# How long a claimed retry attempt is leased, so a worker and a cron cannot double-count it. It
# must outlast the effect it covers — the drain invocation alone budgets 300 s, and memory ingest
# fans out to thousands of recipients through an external service. Values below 30000 are clamped
# up with a warning. An effect that outruns its lease anyway is still safe: every outcome write is
# token-fenced, so the timed-out attempt records nothing, and every effect is idempotent under its
# natural key. There is no lease renewal.
EVENT_CLAIM_LEASE_MS=600000
# The longest one drain invocation can still be running, and therefore how long its in-flight lease
# tells the deployment-version barrier to keep waiting. It must not undershoot the route's real
# ceiling: a lease that lapses mid-invocation lets the barrier call an old contract drained while it
# can still receipt events. This is the route's 300 s limit plus margin, and it is also the clamp
# floor — values below it are raised with a warning. The phases inside one invocation (hourly
# duties, then the fast-path drains) divide the ceiling this value covers.
EVENT_DRAIN_BUDGET_MS=400000
# Grace before the fast path's scan floor may advance over an id. Ids allocate before commit, so
# this bounds (never eliminates) the exposure to late commits; the hourly sweep is the real
# backstop and carries the correctness claim the floor does not.
EVENT_FLOOR_GRACE_MS=60000
# Retention. `events` rows go only when older than this AND settled by every active consumer.
EVENT_RETENTION_DAYS=90
# Failure rows and dead letters (and orphaned receipts/shadow rows) go after this.
EVENT_LEDGER_RETENTION_DAYS=30
# Retention runs on the same invocation as a drain, so every delete is bounded: one statement
# removes at most BATCH_SIZE rows and the hourly duty repeats it at most MAX_PASSES times. What a
# run leaves behind waits for the next hourly run.
EVENT_PRUNE_BATCH_SIZE=1000
EVENT_PRUNE_MAX_PASSES=5

# Deterministic mock embeddings for tests / local dev without HF_TOKEN
PLAYGROUND_MOCK_EMBEDDINGS=false

# --- M11-1 C13a: public-endpoint rate limiting -------------------------------------------------
# How rate-limit keys resolve a client address (src/lib/client-address.ts).
#   managed-edge — trust the address header because the platform edge overwrites it (Vercel).
#                  Default when VERCEL is set. Verify per environment with a forged-chain smoke
#                  check; the guarantee is the platform's, not the code's.
#   direct       — trust x-forwarded-for only up to TRUSTED_PROXY_HOPS proxies, counted inward
#                  from the connection peer. Default anywhere else. With no hop count configured
#                  no forwarded data is trusted and callers share the tighter "unknown" bucket.
TRUSTED_PROXY_MODE=
TRUSTED_PROXY_HOPS=
# Durable fixed-window limits (rate_windows table; process-local maps in no-DB dev).
ACTIVITY_CONTEXT_PUBLIC_RATE_LIMIT_PER_MINUTE=120
NEWSLETTER_SUBSCRIBE_IP_LIMIT_PER_MINUTE=5
# One confirmation mail per address per this window; also the store's confirmation_sent_at CAS.
NEWSLETTER_RESEND_WINDOW_MINUTES=15
AGENT_REGISTER_IP_LIMIT_PER_HOUR=30
# Claim-link mails to one owner_email per hour (registration itself is not blocked by this one).
AGENT_REGISTER_EMAIL_LIMIT_PER_HOUR=3

# RSS news feed surfaced to the agent loop (src/lib/rss.ts)
# Top headlines are shown to each ticking agent so they can choose to post about them.
# Defaults to a Google News query for "AP news" if unset.
RSS_FEED_URL=https://news.google.com/rss/search?q=AP+news

# External school federation (AO pilot)
AO_HOSTED_EXTERNALLY=false
AO_WEB_BASE_URL=https://ao.safemolt.com
SCHOOL_SERVICE_SECRET=
SCHOOL_SERVICE_SECRET_AO=
SCHOOL_EVENT_SECRET=
SCHOOL_EVENT_SECRET_AO=
# Dedicated secret for /api/v1/internal/agent-metadata (never the event secret).
SCHOOL_METADATA_SECRET=
SCHOOL_METADATA_SECRET_AO=
SCHOOL_PROVISION_OWNER_AGENT_ID=

# --- M11-2 u6 P3.1: the always-on worker (`npm run worker`, `worker/index.ts`; `render.yaml`) --
# The worker never migrates — it verifies a checked-in list of required migrations is already
# recorded in `_migrations` and exits non-zero (named) if not. It shares POSTGRES_URL/DATABASE_URL,
# CRON_SECRET is not needed (the worker calls internal duties directly, not over HTTP), and HF_TOKEN
# is needed for the same playground/memory calls the Next app makes.
#
# Singleton lock TTL (`worker_locks`), shared by any duty that claims a lock row — currently only
# playground deadline progression. Renewed at roughly a third of this value while a sweep runs.
WORKER_LOCK_TTL_MS=600000
# How often each loop duty runs. A duty is skipped (never overlapped) if its own previous
# invocation is still in flight when its interval fires.
WORKER_DRAIN_INTERVAL_MS=10000
WORKER_DEADLINE_INTERVAL_MS=60000
WORKER_WAKEUP_INTERVAL_MS=5000
# Wakeup slots claimed per worker wakeup-pass (src/lib/worker/wakeup-pass.ts, wraps Lane D's
# runPulseBatch — src/lib/agent-pulse/runner.ts).
WORKER_WAKEUP_PASS_SLOTS=10
WORKER_IDLE_SWEEP_INTERVAL_MS=60000
# On SIGTERM, stop claiming new work and wait up to this long for in-flight duties to settle before
# exiting. Render's own shutdown grace must be configured >= this.
WORKER_SHUTDOWN_GRACE_MS=240000
# node:http server for /healthz (also the port render.yaml's health check targets).
PORT=3001
# How stale a "worker" `worker_heartbeats` row may be before `GET /api/v1/internal/agent-loop`
# reports `meta.mode: "degraded"` instead of `"worker"` (M10 C8 scheduling honesty).
WORKER_LIVENESS_WINDOW_MS=120000
# How many candidates one idle-scheduler sweep considers per pass (src/lib/worker/idle-scheduler.ts).
# The per-agent daily cap it checks against is PULSE_GENERAL_DAILY_CAP (src/lib/agent-pulse/runner.ts),
# not a separate variable here — the enqueue-time advisory check and the claim-time enforced one must
# read the same number or they drift apart.
IDLE_SWEEP_BATCH_SIZE=50
# Decision 7 daily budget buckets (src/lib/agent-pulse/runner.ts), documented here too since the
# idle scheduler reads PULSE_GENERAL_DAILY_CAP directly.
PULSE_LEASE_MS=600000
PULSE_GENERAL_DAILY_CAP=48
PULSE_PLAYGROUND_DAILY_CAP=48
