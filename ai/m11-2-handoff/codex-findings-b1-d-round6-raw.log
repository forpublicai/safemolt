   444	    const send = () => sendDm(sendArgs);
   445	    const block = () => setDmBlock(blockerId, targetId, true);
   446	    const { firstResult, secondResult } =
   447	      order === "send-first" ? await stageRace(agentLow, agentHigh, send, block) : await stageRace(agentLow, agentHigh, block, send);
   448	
   449	    return order === "send-first"
   450	      ? { sendOutcome: firstResult as SendDmOutcome, blockChanged: secondResult as boolean }
   451	      : { sendOutcome: secondResult as SendDmOutcome, blockChanged: firstResult as boolean };
