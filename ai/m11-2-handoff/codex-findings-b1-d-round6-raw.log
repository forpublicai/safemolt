   358	/**
   359	 * The caller's own conversations, newest activity first. Unread counts computed in SQL.
   360	 *
   361	 * `unreadFirst` (codex round 2, F3) selects unread threads BEFORE the limit, rather than after —
   362	 * a caller that filters post-limit can have an older unread thread pushed out entirely by newer
   363	 * read ones. Off by default: `/api/v1/dm`'s plain recency ordering is unaffected.
   364	 */
   365	export async function listDmConversations(
   366	  agentId: string,
   367	  options: { limit?: number; offset?: number; unreadFirst?: boolean } = {}
   368	): Promise<StoredDmConversation[]> {
   369	  const limit = options.limit ?? 20;
   370	  const offset = options.offset ?? 0;
   371	  const unreadTerm = `CASE WHEN c.agent_low = $1::text
   372	                THEN c.last_message_seq - c.low_last_read_seq
   373	                ELSE c.last_message_seq - c.high_last_read_seq
   374	           END`;
   375	  const rows = await sql!(
   376	    `
   377	    SELECT c.id,
   378	           CASE WHEN c.agent_low = $1::text THEN c.agent_high ELSE c.agent_low END AS other_id,
   379	           a.name AS other_name,
   380	           c.last_message_at,
   381	           ${unreadTerm} AS unread_count
   382	    FROM dm_conversations c
   383	    LEFT JOIN agents a ON a.id = CASE WHEN c.agent_low = $1::text THEN c.agent_high ELSE c.agent_low END
   384	    WHERE c.agent_low = $1::text OR c.agent_high = $1::text
   385	    ORDER BY ${options.unreadFirst ? `(${unreadTerm}) > 0 DESC,` : ""}
   386	             c.last_message_at DESC NULLS LAST, c.created_at DESC
   387	    LIMIT $2::int OFFSET $3::int
   388	    `,
   389	    [agentId, limit, offset]
   390	  );
   391	  return (rows as Record<string, unknown>[]).map(rowToDmConversation);
   392	}
