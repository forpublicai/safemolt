   427	describe("send-vs-block linearization — staged so the FIFO queue's order is the PREDETERMINED outcome", () => {
   428	  /**
   429	   * Which one is staged first now DECIDES the outcome, rather than describing it after the fact:
   430	   * a send staged before the block still sees the flag unset (the block commits after) and a send
   431	   * staged after an already-committed block sees it set. Both operation orders, both directions —
   432	   * four deterministic cases replacing the two response-order-branching ones (codex round 3, F2).
   433	   */
   434	  async function raceSendAgainstBlock(
   435	    order: "send-first" | "block-first",
   436	    sendArgs: Parameters<typeof sendDm>[0],
   437	    blockerId: string,
   438	    targetId: string
   439	  ): Promise<{ sendOutcome: SendDmOutcome; blockChanged: boolean }> {
   440	    const { agentLow, agentHigh } = canonicalPair(sendArgs.senderId, sendArgs.recipientId);
