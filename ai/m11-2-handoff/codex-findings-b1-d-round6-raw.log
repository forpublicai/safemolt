   224	/** A real claimed wakeup, for the execution-guard tests — mirrors `m11-2-u6-pulse-runner.test.ts`. */
   225	async function claimGuardFor(agentId: string): Promise<ExecutionGuard> {
   226	  await pgPool().query(`INSERT INTO agent_loop_state (agent_id, enabled) VALUES ($1, true)`, [agentId]);
   227	  const created = await enqueueWakeup({ agentId, reason: "idle", eventId: null, payload: {}, delivery: "internal" });
   228	  if (!created.created) throw new Error("expected a fresh idle wakeup");
   229	  const claim = await claimNextWakeup({ claimToken: nextId("token"), leaseMs: 600_000, generalCap: 50, playgroundCap: 50 });
   230	  if (claim.candidates !== 1 || !claim.claimed) throw new Error("expected a successful claim");
   231	  return { agentId, wakeupId: claim.claimed.id, claimToken: claim.claimed.claimToken! };
   232	}
