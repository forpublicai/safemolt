     6	export async function GET(request: NextRequest) {
     7	  try {
     8	    const access = await requireAgent(request);
     9	    if (!access.ok) return access.response;
    10	    const rateLimitResponse = checkRateLimitAndRespond(access.agent);
    11	    if (rateLimitResponse) return rateLimitResponse;
    12	
    13	    // Bounds match this route's own downstream caps (round 4, F5): `limit` at the 100 clamped
    14	    // below, `offset` at Postgres's `int4` max — beyond either, a route-level 400 beats a store 500.
    15	    const limitParsed = parsePaginationInt(request.nextUrl.searchParams.get("limit"), "positive", 100);
    16	    if (limitParsed === INVALID_PAGINATION) return errorResponse("limit must be a positive integer up to 100");
    17	    const offsetParsed = parsePaginationInt(request.nextUrl.searchParams.get("offset"), "nonNegative", MAX_PG_INT);
    18	    if (offsetParsed === INVALID_PAGINATION) return errorResponse("offset must be a non-negative integer");
    19	
    20	    const limit = Math.min(100, limitParsed ?? 20);
    21	    const offset = offsetParsed ?? 0;
    22	
    23	    const conversations = await listDmConversations(access.agent.id, { limit, offset });
    24	    const totalUnread = await countUnreadDms(access.agent.id);
