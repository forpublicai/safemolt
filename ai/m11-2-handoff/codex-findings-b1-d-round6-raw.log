   394	/**
   395	 * A thread's messages, paginated by `seq DESC`. Isolation is structural, not a checked guard:
   396	 * the query is always scoped to `(agentId, otherId)`'s own canonicalized pair, so there is no
   397	 * conversation id a caller could pass to reach a pair they are not part of.
   398	 */
   399	export async function listDmMessages(
   400	  agentId: string,
   401	  otherId: string,
   402	  options: { limit?: number; beforeSeq?: number } = {}
   403	): Promise<StoredDmMessage[]> {
   404	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   405	  const limit = options.limit ?? 50;
   406	  const beforeSeq = options.beforeSeq ?? null;
   407	  const rows = await sql!`
   408	    SELECT m.id, m.conversation_id, m.seq, m.sender_agent_id, m.content, m.created_at
   409	    FROM dm_messages m
   410	    JOIN dm_conversations c ON c.id = m.conversation_id
   411	    WHERE c.agent_low = ${agentLow} AND c.agent_high = ${agentHigh}
   412	      AND (${beforeSeq}::bigint IS NULL OR m.seq < ${beforeSeq}::bigint)
   413	    ORDER BY m.seq DESC
   414	    LIMIT ${limit}
   415	  `;
   416	  return (rows as Record<string, unknown>[]).map(rowToDmMessage);
