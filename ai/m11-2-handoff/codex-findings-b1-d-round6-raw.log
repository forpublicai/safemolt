   570	  const gateTable = `b1dm_pause_gate_${RUN}`;
   571	  const pauseFn = `b1dm_pause_fn_${RUN}`;
   572	  const pauseTrigger = `b1dm_pause_trigger_${RUN}`;
   573	
   574	  beforeAll(async () => {
   575	    await pgPool().query(`CREATE TABLE ${gateTable} (id int PRIMARY KEY)`);
