   153	/**
   154	 * Every backend that is blocked, and by whom — unfiltered, for the transitive check below. Postgres
   155	 * reports only the IMMEDIATE blocker(s) via `pg_blocking_pids`, and two contenders kicked off
   156	 * concurrently race for which one becomes the other's immediate blocker (round 5, F2: unlike the
   157	 * staged tests elsewhere in this file, these two are not sequenced against each other) — so the
   158	 * caller must walk the chain rather than assume either contender blocks on `rootPid` directly.
   159	 */
   160	async function blockedBackends(): Promise<Map<number, number[]>> {
   161	  const { rows } = await pgPool().query<{ pid: number; blockers: number[] }>(
   162	    `SELECT pid, pg_blocking_pids(pid) AS blockers
   163	     FROM pg_stat_activity
   164	     WHERE datname = current_database() AND pid <> pg_backend_pid() AND cardinality(pg_blocking_pids(pid)) > 0`
   165	  );
   166	  return new Map(rows.map((r) => [r.pid, r.blockers]));
   167	}
   168	
   169	/** Does `pid`'s blocker chain reach `rootPid`, walking through any number of intermediate waiters? */
   170	function chainReaches(graph: Map<number, number[]>, pid: number, rootPid: number, seen = new Set<number>()): boolean {
   171	  if (seen.has(pid)) return false;
   172	  seen.add(pid);
   173	  const blockers = graph.get(pid) ?? [];
   174	  return blockers.includes(rootPid) || blockers.some((b) => chainReaches(graph, b, rootPid, seen));
   175	}
   176	
   177	/**
   178	 * Wait until at least `count` DISTINCT backends (other than `excludePids`) are transitively blocked
   179	 * by `rootPid` — never assuming a fixed chain order between two contenders started concurrently.
   180	 */
   181	async function waitUntilCountTransitivelyBlockedBy(
   182	  rootPid: number,
   183	  count: number,
   184	  excludePids: number[],
   185	  timeoutMs = 5000
   186	): Promise<number[]> {
   187	  const deadline = Date.now() + timeoutMs;
   188	  while (Date.now() < deadline) {
   189	    const graph = await blockedBackends();
   190	    const matched = [...graph.keys()].filter((pid) => !excludePids.includes(pid) && chainReaches(graph, pid, rootPid));
   191	    if (matched.length >= count) return matched;
   192	    await new Promise((resolve) => setTimeout(resolve, 25));
   193	  }
   194	  throw new Error(`fewer than ${count} backends transitively blocked by pid ${rootPid} within ${timeoutMs}ms`);
   195	}
   196	
   197	/**
   198	 * Stage two contenders so Postgres's FIFO row-lock queue — not wall-clock scheduling — decides the
   199	 * winner: start `first`, prove ITS OWN backend waits on THIS holder, THEN start `second` and prove
   200	 * ITS backend waits on `first`'s (PostgreSQL queues row-lock waiters, so the second contender's
   201	 * direct blocker is the first waiter, never the original holder), and only then release. `first` is
   202	 * thereby guaranteed to commit before `second` (codex round 4, F3 — by backend, not by a count that
   203	 * an unrelated blocked query could also satisfy).
   204	 */
   205	async function stageRace<A, B>(
   206	  agentLow: string,
   207	  agentHigh: string,
   208	  first: () => Promise<A>,
   209	  second: () => Promise<B>
   210	): Promise<{ firstResult: A; secondResult: B }> {
   211	  const staged = await withHeldPairRow(agentLow, agentHigh, async (holderPid) => {
   212	    const firstPromise = first();
   213	    const firstPid = await waitForContenderBehind(holderPid, null);
   214	    const secondPromise = second();
   215	    const secondPid = await waitForContenderBehind(firstPid, firstPid);
   216	    return { firstPromise, secondPromise, firstPid, secondPid };
   217	  });
   218	  expect(staged.firstPid).toBeGreaterThan(0);
   219	  expect(staged.secondPid).toBeGreaterThan(0);
   220	  const [firstResult, secondResult] = await Promise.all([staged.firstPromise, staged.secondPromise]);
   221	  return { firstResult, secondResult };
   222	}
