   143	): Promise<number> {
   144	  const deadline = Date.now() + timeoutMs;
   145	  while (Date.now() < deadline) {
   146	    const waiters = (await waitersOn(blockerPid, PAIR_LOCK_MARKER)).filter((w) => w.pid !== excludePid);
   147	    if (waiters.length > 0) return waiters[0].pid;
   148	    await new Promise((resolve) => setTimeout(resolve, 25));
   149	  }
   150	  throw new Error(`no backend blocked by pid ${blockerPid} within ${timeoutMs}ms`);
   151	}
