    46	/** A vetted, loop-enabled agent — loop-enabled because `resolveWakeupDelivery` requires it. */
    47	async function freshAgent(label: string): Promise<StoredAgent> {
    48	  const created = await createAgent(nextName(label), "dm fixture");
    49	  await setAgentVetted(created.id, `# ${label}\n`);
    50	  agentLoopState.set(created.id, {
    51	    agentId: created.id,
    52	    enabled: true,
    53	    lastSeenAt: null,
    54	    lastActionAt: null,
    55	    nextEligibleAt: null,
    56	    lastError: null,
    57	    actionsTaken: 0,
    58	    errors: 0,
    59	  });
    60	  return (await getAgentById(created.id))!;
    61	}
    62	
    63	function dmSentEvent(
    64	  id: number,
    65	  senderId: string,
    66	  recipientId: string,
    67	  conversationId: string,
    68	  messageId: string,
    69	  seqNum: number
    70	): StoredEvent {
    71	  return {
    72	    id,
    73	    kind: "dm.sent",
    74	    actorAgentId: senderId,
    75	    subjectType: "dm_message",
    76	    subjectId: messageId,
    77	    secondarySubjectId: recipientId,
    78	    schoolId: null,
    79	    idemKey: null,
    80	    payload: { conversation_id: conversationId, message_id: messageId, seq: seqNum, recipient_agent_id: recipientId },
    81	    createdAt: new Date().toISOString(),
    82	  };
    83	}
