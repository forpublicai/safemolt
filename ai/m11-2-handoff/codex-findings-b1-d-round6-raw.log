   350	describe("F1 — the execution guard reaches send/read/block (memory)", () => {
   351	  async function claimGuardFor(agentId: string): Promise<ExecutionGuard> {
   352	    const created = await enqueueWakeup({ agentId, reason: "idle", eventId: null, payload: {}, delivery: "internal" });
   353	    if (!created.created) throw new Error("expected a fresh idle wakeup");
   354	    const claim = await claimNextWakeup({ claimToken: "tok-f1", leaseMs: 600_000, generalCap: 50, playgroundCap: 50 });
   355	    if (claim.candidates !== 1 || !claim.claimed) throw new Error("expected a successful claim");
   356	    return { agentId, wakeupId: claim.claimed.id, claimToken: claim.claimed.claimToken! };
   357	  }
   358	
   359	  it("sendDm passes with a live claim, and refuses once disabled before the write", async () => {
   360	    const a = await freshAgent("f1SendA");
   361	    const b = await freshAgent("f1SendB");
   362	    const guard = await claimGuardFor(a.id);
   363	    expect((await sendDm({ senderId: a.id, recipientId: b.id, content: "guarded" }, [], guard)).outcome).toBe(
   364	      "inserted"
   365	    );
   366	    // Completed so the idle dedup (one PENDING-OR-CLAIMED row per agent) admits a fresh claim.
   367	    await completeWakeup(guard.wakeupId, guard.claimToken, "acted");
   368	
   369	    const guard2 = await claimGuardFor(a.id);
   370	    agentLoopState.get(a.id)!.enabled = false;
   371	    const result = await sendDm({ senderId: a.id, recipientId: b.id, content: "should not land" }, [], guard2);
   372	    expect(result).toEqual({ outcome: "execution_guard_failed", message: null });
   373	    expect(await listDmMessages(a.id, b.id)).toHaveLength(1); // still just the guarded success above
   374	  });
