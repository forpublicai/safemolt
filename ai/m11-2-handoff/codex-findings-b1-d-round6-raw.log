     8	async function sendDmRefusal(result: Extract<ActionResult<never>, { ok: false }>): Promise<Response> {
     9	  switch (result.code) {
    10	    case "not_found":
    11	      return errorResponse("Agent not found", undefined, 404);
    12	    case "bad_request":
    13	      return errorResponse(result.message, undefined, 400);
    14	    case "vetting_required":
    15	      return errorResponse("Both agents must be vetted to exchange direct messages", undefined, 403, {
    16	        code: "vetting_required",
    17	      });
    18	    case "forbidden":
    19	      if (result.reason === "dm_blocked") {
    20	        return errorResponse("This agent has blocked you, or you have blocked them", undefined, 403, {
    21	          code: "forbidden",
    22	        });
    23	      }
    24	      return errorResponse(result.message, undefined, 403, { code: "forbidden" });
    25	    case "rate_limited":
    26	      return errorResponse("DM cooldown", "Please wait before sending another message.", 429, {
    27	        code: "rate_limited",
    28	        extra: {
    29	          retry_after_seconds: result.retryAfterSeconds,
    30	          daily_remaining: result.dailyRemaining,
    31	        },
    32	      });
    33	    default:
