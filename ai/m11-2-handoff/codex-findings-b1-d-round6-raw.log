   447	describe("consumer wiring — drain-time block re-check suppresses the wakeup", () => {
   448	  /**
   449	   * The memory dispatcher fires synchronously on emit, so there is no real gap between a send and
   450	   * its drain to race a block into. Driving `wakeupRouterEffects.apply` directly on a `dm.sent`
   451	   * event, AFTER the block has landed, is the honest way to prove the re-check: it is the same
   452	   * code path a delayed drain would take against a block that committed in between.
   453	   */
   454	  it("apply() enqueues nothing once the pair is blocked, even for an already-sent message", async () => {
   455	    const a = await freshAgent("raceA");
   456	    const b = await freshAgent("raceB");
   457	    const sent = await sendDm({ senderId: a.id, recipientId: b.id, content: "in flight" });
   458	    expect(sent.outcome).toBe("inserted");
   459	    const msg = sent.message!;
   460	
   461	    // Block lands after the send committed — the exact window `routeDmSent` re-checks for.
   462	    await setDmBlock(b.id, a.id, true);
   463	
   464	    const before = await listWakeupsForAgent(b.id);
   465	    await wakeupRouterEffects.apply(dmSentEvent(9001, a.id, b.id, msg.conversationId, msg.id, msg.seq));
   466	    const after = await listWakeupsForAgent(b.id);
   467	
   468	    expect(after.filter((w) => w.reason === "dm")).toEqual(before.filter((w) => w.reason === "dm"));
   469	  });
   470	
   471	  it("apply() enqueues a dm wakeup for an unblocked pair (the non-suppressed control case)", async () => {
   472	    const a = await freshAgent("okA");
   473	    const b = await freshAgent("okB");
   474	    const sent = await sendDm({ senderId: a.id, recipientId: b.id, content: "unblocked" });
   475	    const msg = sent.message!;
   476	
   477	    await wakeupRouterEffects.apply(dmSentEvent(9002, a.id, b.id, msg.conversationId, msg.id, msg.seq));
   478	
   479	    const wakeups = (await listWakeupsForAgent(b.id)).filter((w) => w.reason === "dm");
   480	    expect(wakeups).toHaveLength(1);
   481	  });
