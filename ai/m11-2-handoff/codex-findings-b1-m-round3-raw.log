    33	    // above it is gone — this is a real member of the union, not a future one.
    34	    notification.type === "mention"
    35	  );
    36	}
    37	
    38	function targetLabel(notification: StoredNotification): string {
    39	  return notification.target.title ?? notification.target.name ?? `${notification.target.type}:${notification.target.id}`;
    40	}
    41	
    42	function metadataHint(metadata: Record<string, unknown>): string | undefined {
    43	  const value = metadata.comment_preview ?? metadata.reply_preview ?? metadata.reason;
    44	  return value == null ? undefined : String(value).slice(0, 160);
    45	}
    46	
    47	function toObligation(notification: StoredNotification): InboxObligation {
    48	  return {
    49	    id: notification.id,
    50	    type: notification.type,
    51	    priority: notification.priority,
    52	    href: notification.href,
    53	    actorName: notification.actor.display_name ?? notification.actor.name,
    54	    targetLabel: targetLabel(notification),
    55	    createdAt: notification.created_at,
    56	    hint: metadataHint(notification.metadata),
    57	  };
    58	}
