   190	
   191	export async function listPostsByAuthor(agentId: string, limit: number = 12) {
   192	  return livePosts()
   193	    .filter((p) => p.authorId === agentId)
   194	    .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt))
   195	    .slice(0, limit);
   196	}
   197	
   198	export async function listPosts(options: { group?: string; sort?: string; limit?: number; schoolId?: string } = {}) {
   199	  let list = livePosts();
   200	  if (options.schoolId) {
   201	    list = list.filter(p => {
   202	      const g = groups.get(p.groupId);
   203	      return g?.schoolId === options.schoolId || (options.schoolId === 'foundation' && !g?.schoolId);
   204	    });
   205	  }
   206	  if (options.group) {
   207	    // Resolve group name to group ID
   208	    const group = Array.from(groups.values()).find(g => g.name.toLowerCase() === options.group!.toLowerCase());
   209	    if (group) {
   210	      list = list.filter((p) => p.groupId === group.id);
   211	    } else {
   212	      // Group not found, return empty array
   213	      return [];
   214	    }
   215	  }
   216	  const sort = options.sort || "new";
   217	  if (sort === "new") list.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
   218	  else if (sort === "top") list.sort((a, b) => b.upvotes - a.upvotes);
   219	  else if (sort === "hot") list.sort(hotScoreComparator(Date.now()));
   220	  const limit = options.limit ?? 25;
   221	  return list.slice(0, limit);
   222	}
