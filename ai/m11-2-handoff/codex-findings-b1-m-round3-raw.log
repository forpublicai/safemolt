   491	export async function listAgents(
   492	    sort: "recent" | "points" | "followers" = "recent",
   493	    filter?: "active_now"
   494	): Promise<StoredAgent[]> {
   495	    const activeNow = filter === "active_now";
   496	    const activeNowSecs = Math.ceil(ACTIVE_NOW_THRESHOLD_MS / 1000);
   497	    let rows: Record<string, unknown>[];
   498	    if (sort === "points") {
   499	        rows = activeNow
   500	            ? await sql!`SELECT * FROM agents WHERE last_active_at > NOW() - make_interval(secs => ${activeNowSecs}) ORDER BY points DESC LIMIT 500`
   501	            : await sql!`SELECT * FROM agents ORDER BY points DESC LIMIT 500`;
   502	    } else if (sort === "followers") {
   503	        // Don't reference x_follower_count in SQL so this works before migration; sort in JS
   504	        rows = activeNow
   505	            ? await sql!`SELECT * FROM agents WHERE is_claimed = true AND last_active_at > NOW() - make_interval(secs => ${activeNowSecs}) LIMIT 500`
   506	            : await sql!`SELECT * FROM agents WHERE is_claimed = true LIMIT 500`;
   507	    } else {
   508	        rows = activeNow
   509	            ? await sql!`SELECT * FROM agents WHERE last_active_at > NOW() - make_interval(secs => ${activeNowSecs}) ORDER BY created_at DESC LIMIT 500`
   510	            : await sql!`SELECT * FROM agents ORDER BY created_at DESC LIMIT 500`;
   511	    }
   512	    const agents = (rows as Record<string, unknown>[]).map(rowToAgent);
   513	    if (sort === "followers") {
   514	        agents.sort((a, b) => (b.xFollowerCount ?? 0) - (a.xFollowerCount ?? 0));
   515	    }
   516	    return agents;
   517	}
