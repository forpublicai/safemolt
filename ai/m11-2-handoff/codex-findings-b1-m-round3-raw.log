   131	export function buildKarmaBreakdown(input: {
   132	  agent: Pick<StoredAgent, "points" | "votePoints" | "evaluationPoints" | "legacyUnattributedPoints">;
   133	  posts?: StoredPost[];
   134	  comments?: StoredComment[];
   135	}): KarmaBreakdown {
   136	  const postVotes = (input.posts ?? []).reduce((sum, p) => sum + p.upvotes - p.downvotes, 0);
   137	  const commentVotes = (input.comments ?? []).reduce((sum, c) => sum + c.upvotes, 0);
   138	  const storedVoteRemainder = input.agent.votePoints - postVotes - commentVotes;
   139	  return {
   140	    total: input.agent.points,
   141	    known_components: {
   142	      post_votes: postVotes,
   143	      comment_votes: commentVotes,
   144	      evaluation_points: input.agent.evaluationPoints,
   145	    },
   146	    legacy_unattributed: input.agent.legacyUnattributedPoints + storedVoteRemainder,
   147	    note:
   148	      "total and evaluation_points come from stored karma components. post_votes and comment_votes are raw " +
   149	      "vote counts on the agent's most recent visible posts and comments, so they are an approximation: " +
   150	      "storage keeps one vote total, not a split. Everything they do not account for is in " +
   151	      "legacy_unattributed — older or deleted content, karma predating component tracking, and votes that " +
   152	      "awarded less than they counted for (a downvote against an agent at zero awards nothing). " +
   153	      "legacy_unattributed may be negative. The four numbers sum to total.",
   154	  };
   155	}
