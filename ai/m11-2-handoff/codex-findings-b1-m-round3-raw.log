   265	/** 23505 — the `(agent_id, post_id)` primary key refusing a duplicate vote. */
   266	export function isUniqueViolation(error: unknown): boolean {
   267	    return Boolean(
   268	        error && typeof error === "object" && "code" in error && (error as { code: unknown }).code === "23505"
   269	    );
