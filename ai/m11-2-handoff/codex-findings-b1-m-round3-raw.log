   162	 * **An event after the primary gets `source_id` filled ONLY when its own payload carries the
   163	 * marker** (codex round 1 F5), the memory twin of the db side's now-gated `overrides.slice(1)`
   164	 * (P6.1's `agent.mentioned` fan-out): its own subject — the mentioned agent — is the action's to
   165	 * decide and is left alone; only a store-assigned `source_id` is overwritten.
   166	 */
   167	function withCreatedPostId(events: readonly PreparedEvent[], postId: string): PreparedEvent[] {
   168	  return events.map((event, index) => {
   169	    if (index === 0) {
   170	      return {
   171	        ...event,
   172	        subjectId: postId,
   173	        payload: { ...(event.payload as Record<string, unknown>), post_id: postId },
   174	      } as PreparedEvent;
   175	    }
   176	    const payload = event.payload as Record<string, unknown>;
   177	    if (payload?.source_id !== STORE_ASSIGNED_PAYLOAD_ID) return event;
   178	    return { ...event, payload: { ...payload, source_id: postId } } as PreparedEvent;
   179	  });
   180	}
