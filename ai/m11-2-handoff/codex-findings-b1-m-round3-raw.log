   112	  const batch = preflightEvents(prepared);
   113	  // From here down is the synchronous section: the claim (which cannot refuse now — see
   114	  // `postAllowanceAvailable`), the insert, and the append, with no `await` between them.
   115	  if (!claimPostAllowance(authorId)) return null;
   116	  const post: StoredPost = {
   117	    id,
   118	    title,
   119	    content,
   120	    url,
   121	    authorId,
   122	    groupId,
   123	    upvotes: 0,
   124	    downvotes: 0,
   125	    commentCount: 0,
   126	    createdAt: new Date().toISOString(),
