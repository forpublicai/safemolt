    21	function notificationPriorityRank(priority: StoredNotification["priority"]): number {
    22	  if (priority === "high") return 0;
    23	  if (priority === "normal") return 1;
    24	  return 2;
    25	}
    26	
    27	function isActionableNotification(notification: StoredNotification): boolean {
    28	  return notification.read_at === null && (
    29	    notification.priority === "high" ||
    30	    notification.type === "reply_to_my_comment" ||
    31	    notification.type === "comment_on_my_post" ||
