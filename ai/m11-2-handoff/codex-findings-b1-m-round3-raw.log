   239	        else
   240	            rows = (await sql!`SELECT * FROM posts WHERE group_id = ${groupId} AND deleted_at IS NULL ORDER BY created_at DESC LIMIT ${limit}`) as Record<string, unknown>[];
   241	    } else if (options.schoolId) {
   242	        if (sort === "top")
   243	            rows = (await sql!`SELECT p.* FROM posts p JOIN groups g ON p.group_id = g.id WHERE p.deleted_at IS NULL AND (g.school_id = ${options.schoolId} OR (${options.schoolId} = 'foundation' AND g.school_id IS NULL)) ORDER BY p.upvotes DESC LIMIT ${limit}`) as Record<string, unknown>[];
   244	        else if (sort === "hot")
   245	            rows = (await sql!(
   246	                `SELECT p.* FROM posts p JOIN groups g ON p.group_id = g.id WHERE p.deleted_at IS NULL AND (g.school_id = $1::text OR ($1::text = 'foundation' AND g.school_id IS NULL)) ${hotScoreOrderBy("$2", "p.")} LIMIT $3::int`,
   247	                [options.schoolId, new Date().toISOString(), limit]
   248	            )) as Record<string, unknown>[];
   249	        else
   250	            rows = (await sql!`SELECT p.* FROM posts p JOIN groups g ON p.group_id = g.id WHERE p.deleted_at IS NULL AND (g.school_id = ${options.schoolId} OR (${options.schoolId} = 'foundation' AND g.school_id IS NULL)) ORDER BY p.created_at DESC LIMIT ${limit}`) as Record<string, unknown>[];
   251	    } else {
   252	        if (sort === "top")
   253	            rows = (await sql!`SELECT * FROM posts WHERE deleted_at IS NULL ORDER BY upvotes DESC LIMIT ${limit}`) as Record<string, unknown>[];
   254	        else if (sort === "hot")
   255	            rows = (await sql!(
   256	                `SELECT * FROM posts WHERE deleted_at IS NULL ${hotScoreOrderBy("$1")} LIMIT $2::int`,
   257	                [new Date().toISOString(), limit]
   258	            )) as Record<string, unknown>[];
   259	        else
   260	            rows = (await sql!`SELECT * FROM posts WHERE deleted_at IS NULL ORDER BY created_at DESC LIMIT ${limit}`) as Record<string, unknown>[];
