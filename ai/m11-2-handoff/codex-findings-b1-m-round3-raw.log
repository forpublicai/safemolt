    60	/** Find the preview text (max 160 chars) of the last message the agent RECEIVED in this thread. */
    61	async function getDmThreadPreview(agentId: string, otherId: string): Promise<string> {
    62	  const messages = await listDmMessages(agentId, otherId, { limit: 10 });
    63	  // Find most recent message where we did NOT send it (i.e., we received it).
    64	  for (const msg of messages) {
    65	    if (msg.senderId !== agentId) {
    66	      return msg.content.slice(0, 160);
    67	    }
    68	  }
    69	  return "";
    70	}
    71	
    72	export async function gatherInbox(
    73	  agentId: string,
    74	  opts: GatherInboxOptions = {}
    75	): Promise<InboxSection> {
    76	  const limit = opts.limit ?? DEFAULT_INBOX_LIMIT;
    77	  try {
    78	    // Read wider than the window: the actionable filter runs in app, not in the query.
    79	    const notifications = await listNotifications(agentId, { limit: limit * 3 });
    80	    const items = notifications
    81	      .filter(isActionableNotification)
    82	      .sort((a, b) => {
    83	        const priority = notificationPriorityRank(a.priority) - notificationPriorityRank(b.priority);
    84	        if (priority !== 0) return priority;
    85	        return Date.parse(b.created_at) - Date.parse(a.created_at);
    86	      })
    87	      .slice(0, limit)
    88	      .map(toObligation);
    89	
    90	    // Gather DM thread summaries: unread count + previews of top unread threads. `unreadFirst`
    91	    // selects unread conversations BEFORE the limit in the store — a fixed scan-then-filter window
    92	    // let a newer read conversation push an older unread one out entirely (codex round 2, F3).
    93	    const dmUnreadCount = await countUnreadDms(agentId);
    94	    const conversations = await listDmConversations(agentId, {
    95	      limit: DM_THREAD_DISPLAY_LIMIT,
    96	      unreadFirst: true,
    97	    });
    98	    const dmThreads: DmThreadSummary[] = await Promise.all(
    99	      conversations
   100	        .filter((c) => c.unreadCount > 0)
   101	        .map(async (c) => ({
   102	          otherAgentId: c.other.id,
   103	          otherAgentName: c.other.name,
   104	          unreadCount: c.unreadCount,
   105	          preview: await getDmThreadPreview(agentId, c.other.id),
   106	        }))
   107	    );
   108	
   109	    return { items, degraded: false, dmUnreadCount, dmThreads };
   110	  } catch (e) {
   111	    console.error("[agent-senses] gatherInbox failed:", e);
   112	    return { items: [], degraded: true, dmUnreadCount: 0, dmThreads: [] };
   113	  }
   114	}
