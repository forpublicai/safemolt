   271	
   272	/**
   273	 * Cast a vote on a post and award its author — in **one statement** (M11-1C).
   274	 *
   275	 * Four things used to happen here as four separately auto-committed statements: the vote row, the
   276	 * decisive counter, the points award, and (on failure) a compensating delete. This collapses all
   277	 * of them into a single statement, and each arm is load-bearing:
   278	 *
   279	 * **`counted` is first, and everything gates on it.** The obvious shape — award atomically with the
   280	 * vote row, leave C25's counter update where it was — is wrong. C25's order is: record the vote,
   281	 * increment the counter gated on `deleted_at IS NULL`, and if that matches zero rows (the post was
   282	 * deleted mid-flight) undo the vote. An atomic vote-plus-award placed *before* that check would
   283	 * award karma and then have only the **vote row** rolled back, leaving points behind on a
   284	 * tombstone — the exact defect C25 exists to close. So the counter becomes the first arm and the
   285	 * rest hangs off its `RETURNING`. Zero returned rows now means nothing happened at all, and the
   286	 * compensating `removeVote` disappears along with the window it was patching.
   287	 *
   288	 * **The lock is `FOR NO KEY UPDATE`, not `FOR UPDATE`, and the difference is a deadlock.** Inserting
   289	 * the vote row makes Postgres check `post_votes.agent_id REFERENCES agents(id)`, and an FK check
   290	 * takes an implicit `FOR KEY SHARE` on the **voter's** agents row. `FOR UPDATE` conflicts with
   291	 * `FOR KEY SHARE`; `FOR NO KEY UPDATE` does not. With `FOR UPDATE`, two agents upvoting each
   292	 * other's posts at the same moment each hold the other's row and each wait for their own —
   293	 * a 40P01 deadlock, and one upvote becomes a 500. `FOR NO KEY UPDATE` is also exactly what the
   294	 * outer `UPDATE agents` takes on its own (it changes no key column), so nothing is weakened: two
   295	 * votes against the SAME author still serialise, because `FOR NO KEY UPDATE` conflicts with itself.
   296	 *
   297	 * **The lock is load-bearing; a snapshot-only version is unsound.** Computing the recorded
   298	 * delta from the statement snapshot and letting the outer `UPDATE` do its own arithmetic breaks
   299	 * under Read Committed: a contending writer makes the outer update re-evaluate against the *newer*
   300	 * row version while the `INSERT` has already recorded a delta from the older one. With
   301	 * `points = 1`, two concurrent downvotes would both record `points_delta = -1` while the second
   302	 * actually awards 0 at the floor — and reversing that vote later mints a point, which is precisely
   303	 * OQ-1's failure reappearing inside its own fix. Pinning the row in `locked` takes the lock
   304	 * *before* the delta is computed, so the value the `INSERT` records and the value the `UPDATE`
   305	 * applies come from the same pinned version. The outer statement therefore writes **absolute**
   306	 * values (`l.points + l.delta`) and never references `a.points`: a bare `a.points` would read the
   307	 * statement snapshot and reintroduce exactly the divergence the lock removes.
   308	 *
   309	 * **`locked` cannot come up empty while `counted` produced a row**, because
   310	 * `posts.author_id REFERENCES agents(id)` — so there is no path where the counter moves and the
   311	 * vote row is skipped.
   312	 *
   313	 * Both directions share one shape so there is one path to reason about; an upvote's
   314	 * `GREATEST(0, …)` never binds, since no writer can drive `points` below zero.
   315	 *
   316	 * **M11-2 P1.2 adds the event arm and nothing else.** P1.2's problem statement describes four
   317	 * separately auto-committed statements — the shape M11-1C already replaced — so the karma arms,
   318	 * their order, the recorded `points_delta` and the `FOR NO KEY UPDATE` mode are untouched, and the
   319	 * decisive counter stays the FIRST arm. The only structural change is that the final `UPDATE agents`
   320	 * becomes a named CTE so a `post.voted` insert can be gated beside it and the statement can still
   321	 * end in a SELECT (the same transformation P1.1 made to `pinPost`). The two directions stay written
   322	 * out as two statements rather than being folded into one parameterized text: `points_delta` is
   323	 * recorded by the awarding statement, and `karma-writer-ownership.test.ts` counts those statements.
   324	 *
   325	 * @returns the author's id when the vote was cast, or null when the post was absent or a tombstone,
   326	 *          or when a concurrent voter won the primary key.
   327	 */
   328	async function castPostVote(
   329	    postId: string,
   330	    agentId: string,
   331	    voteType: 1 | -1,
   332	    events?: readonly PreparedEvent[]
   333	): Promise<string | null> {
   334	    const votedAt = new Date().toISOString();
   335	    // $1 post, $2 voter, $3 votedAt.
   336	    const params: unknown[] = [postId, agentId, votedAt];
   337	    // **Gated on `voted` — the vote row itself, not the counter.** The counter moves for any live
   338	    // post; the fact this event reports is that THIS agent's vote landed. A duplicate raises 23505
   339	    // and rolls the whole statement back, counter and event together, so the refusal path writes
   340	    // nothing and emits nothing (the no-write-without-event rule, in both directions).
   341	    //
   342	    // Rendered ONCE and spliced into whichever direction runs: the two branches bind the same
   343	    // parameters in the same positions, and the two statements stay written out separately on
   344	    // purpose — `karma-writer-ownership.test.ts` enumerates karma writers by statement text, and
   345	    // collapsing them into one would silently reduce the population that scan guards.
   346	    const emitted = emitEventCtes(events, "voted", { firstParamIndex: params.length + 1 });
   347	    const eventCtes = emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : "";
   348	    try {
   349	        const rows = await sql!(
   350	            voteType === 1
   351	                ? `
   352	        /* race:m11-1c-post-vote */
   353	        WITH counted AS (
   354	          UPDATE posts SET upvotes = upvotes + 1
   355	          WHERE id = $1::text AND deleted_at IS NULL
   356	          RETURNING id, author_id
   357	        ),
   358	        locked AS (
   359	          SELECT ag.id, ag.points, ag.vote_points,
   360	                 GREATEST(0, ag.points + 1) - ag.points AS delta
   361	          FROM agents ag JOIN counted c ON c.author_id = ag.id
   362	          FOR NO KEY UPDATE OF ag
   363	        ),
   364	        voted AS (
   365	          INSERT INTO post_votes (agent_id, post_id, vote_type, voted_at, points_delta)
     1	import type { PostDeletionResult, StoredPost, StoredComment, StoredCommentWithPost, StoredPostVote, StoredCommentVote } from "@/lib/store-types";
     2	import { agents, claimPostAllowance, COMMENT_COOLDOWN_MS, commentCountToday, comments, commentVotes, following, getVoteKey, groups, lastCommentAt, lastPostAt, MAX_COMMENTS_PER_DAY, forgetActivityProjection, forgetNotification, nextPostId, notifications, POST_COOLDOWN_MS, postAllowanceAvailable, posts, postVotes } from "../_memory-state";
     3	import { hotScoreComparator } from "../hot-score";
     4	import { recordPostActivityEvent } from "../activity/events";
     5	import { secondsUntilUtcMidnight } from "../rate-limit-windows";
     6	import { toKarmaScale } from "../karma-scale";
     7	import { deleteReactionsForPostBatchElement } from "../reactions/memory";
     8	import { STORE_ASSIGNED_PAYLOAD_ID, type PreparedEvent } from "@/lib/events/kinds";
     9	import { orderAndCapPostAudience } from "@/lib/memory/fanout-cap";
    10	import type { StoredEvent } from "@/lib/store-types";
    11	import { appendPreparedBatch, prepareEventBatch, validatePreparedEvents, type PreparedEventBatch } from "../events/memory";
    12	
    13	/**
    14	 * Preflight the Decision-2 prepared events. **Runs BEFORE the mutation, over the whole batch.**
    15	 *
    16	 * Everything that can reject a caller happens here: the kind check, the JSON normalization of every
    17	 * payload, and the idempotency check against both the log and the batch itself. What it returns
    18	 * cannot fail to append — which is the property Decision 4 asks for, and which a kind-only check did
    19	 * not give: a duplicate `idem_key` or an unserializable payload used to surface *inside* the append,
    20	 * leaving the mutation applied and its events missing. Postgres rolls the mutation back with the
    21	 * event insert, so memory mode has to refuse before it writes anything.
    22	 *
    23	 * **It runs AFTER the mutation's eligibility check, and that placement is the db parity.** The
    24	 * uniqueness half is the reason: the db event insert is gated on the decisive CTE, so a refused
    25	 * mutation writes no event row and a duplicate `idem_key` raises nothing at all. Running it first
    26	 * turned a cooldown-refused retry — the ordinary shape of a client retrying with the same key — into
    27	 * a 23505 here and a `null` there.
    28	 *
    29	 * `validatePreparedEvents` — the half Postgres performs while RENDERING — goes wherever the db store
    30	 * renders, which is not always first. `createPost` and the four post mutations render before any
    31	 * refusal, so it runs first there; the vote paths keep a friendly `hasVoted` pre-check that returns
    32	 * *before* their statement is built, so validating ahead of it would throw where Postgres answers
    33	 * `false`. Same rule, read off the db store rather than assumed.
    34	 */
    35	function preflightEvents(events: readonly PreparedEvent[] | undefined): PreparedEventBatch {
    36	  return prepareEventBatch(events);
    37	}
    38	
    39	/**
    40	 * Append a preflighted batch. **Call it with no `await` between the mutation and this line**
    41	 * (Decision 4): it is synchronous as far as the array push, so the whole "mutation + events" section
    42	 * is unreachable by an interleaved promise. The returned promise covers the in-process consumer
    43	 * dispatch, which is what makes the projections visible when the store call resolves.
    44	 */
    45	function appendPreparedEvents(batch: PreparedEventBatch): Promise<StoredEvent[]> {
    46	  const { stored, dispatched } = appendPreparedBatch(batch);
    47	  return dispatched.then(() => stored);
    48	}
    49	
    50	export async function checkPostRateLimit(agentId: string) {
    51	  const last = lastPostAt.get(agentId);
    52	  if (!last) return { allowed: true };
    53	  const elapsed = Date.now() - last;
    54	  if (elapsed >= POST_COOLDOWN_MS) return { allowed: true };
    55	  return { allowed: false, retryAfterMinutes: Math.ceil((POST_COOLDOWN_MS - elapsed) / 60000) };
    56	}
    57	
    58	export async function checkCommentRateLimit(agentId: string) {
    59	  const last = lastCommentAt.get(agentId);
    60	  const today = new Date().toISOString().slice(0, 10);
    61	  const dayState = commentCountToday.get(agentId);
    62	  const dailyCount = dayState?.date === today ? dayState.count : 0;
    63	  // The daily cap resets at UTC midnight — the db checker's schedule exactly.
    64	  if (dailyCount >= MAX_COMMENTS_PER_DAY)
    65	    return { allowed: false, retryAfterSeconds: secondsUntilUtcMidnight(), dailyRemaining: 0 };
    66	  if (!last) return { allowed: true, dailyRemaining: MAX_COMMENTS_PER_DAY - dailyCount };
    67	  const elapsed = Date.now() - last;
    68	  if (elapsed >= COMMENT_COOLDOWN_MS) return { allowed: true, dailyRemaining: MAX_COMMENTS_PER_DAY - dailyCount };
    69	  return {
    70	    allowed: false,
    71	    retryAfterSeconds: Math.ceil((COMMENT_COOLDOWN_MS - elapsed) / 1000),
    72	    dailyRemaining: MAX_COMMENTS_PER_DAY - dailyCount,
    73	  };
    74	}
