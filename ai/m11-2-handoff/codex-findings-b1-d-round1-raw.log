   222	describe("consumer wiring — drain-time block re-check suppresses the wakeup", () => {
   223	  /**
   224	   * The memory dispatcher fires synchronously on emit, so there is no real gap between a send and
   225	   * its drain to race a block into. Driving `wakeupRouterEffects.apply` directly on a `dm.sent`
   226	   * event, AFTER the block has landed, is the honest way to prove the re-check: it is the same
   227	   * code path a delayed drain would take against a block that committed in between.
   228	   */
   229	  it("apply() enqueues nothing once the pair is blocked, even for an already-sent message", async () => {
   230	    const a = await freshAgent("raceA");
   231	    const b = await freshAgent("raceB");
   232	    const sent = await sendDm({ senderId: a.id, recipientId: b.id, content: "in flight" });
   233	    expect(sent.outcome).toBe("inserted");
   234	    const msg = sent.message!;
   235	
   236	    // Block lands after the send committed — the exact window `routeDmSent` re-checks for.
   237	    await setDmBlock(b.id, a.id, true);
   238	
   239	    const before = await listWakeupsForAgent(b.id);
   240	    await wakeupRouterEffects.apply(dmSentEvent(9001, a.id, b.id, msg.conversationId, msg.id, msg.seq));
   241	    const after = await listWakeupsForAgent(b.id);
   242	
   243	    expect(after.filter((w) => w.reason === "dm")).toEqual(before.filter((w) => w.reason === "dm"));
   244	  });
   245	
   246	  it("apply() enqueues a dm wakeup for an unblocked pair (the non-suppressed control case)", async () => {
   247	    const a = await freshAgent("okA");
   248	    const b = await freshAgent("okB");
   249	    const sent = await sendDm({ senderId: a.id, recipientId: b.id, content: "unblocked" });
   250	    const msg = sent.message!;
   251	
   252	    await wakeupRouterEffects.apply(dmSentEvent(9002, a.id, b.id, msg.conversationId, msg.id, msg.seq));
   253	
   254	    const wakeups = (await listWakeupsForAgent(b.id)).filter((w) => w.reason === "dm");
   255	    expect(wakeups).toHaveLength(1);
   256	  });
   257	});
     1	/**
     2	 * M11b Lane D (P6.3) `[integration]` — direct messages against a real Postgres.
     3	 *
     4	 * The memory-mode suite (`src/__tests__/lib/store/dms-memory.test.ts`) proves the shapes; only a
     5	 * real statement under contention can prove:
     6	 *
     7	 *  - concurrent sends between the same pair get DISTINCT, increasing seqs, and commit order equals
     8	 *    seq order — the pair row's lock is the serialization point (`dms/db.ts`'s own doc comment);
     9	 *  - a send racing a block on the SAME pair resolves to exactly one self-consistent outcome, never
    10	 *    both "sent" and "blocked-before-it" for the same message;
    11	 *  - a block, once it lands, refuses BOTH directions;
    12	 *  - a burst of sends racing a concurrent `markDmRead` never strands a message: nothing that
    13	 *    committed after the read returned is missing from the unread count;
    14	 *  - a withdrawn participant's history survives, tombstoned.
    15	 *
    16	 * Store functions are imported directly from `dms/db.ts` (not the `pickStore` facade), matching
    17	 * `m11-2-u3b-social.test.ts`'s own precedent for statement-level races.
    18	 *
    19	 * @jest-environment node
    20	 */
    21	import {
    22	  sendDm,
    23	  setDmBlock,
    24	  listDmMessages,
    25	  markDmRead,
    26	  countUnreadDms,
    27	  listDmConversations,
    28	  type SendDmResult,
    29	} from "@/lib/store/dms/db";
    30	import { deleteAgent } from "@/lib/store/agents/db";
    31	
    32	type SendDmOutcome = SendDmResult;
    33	
    34	import { runConcurrently, rejections } from "./helpers/concurrency";
    35	import { closeIntegrationConnections, pgPool } from "./helpers/db";
    36	
    37	const RUN = `${Date.now().toString(36)}_${Math.floor(Math.random() * 1e6).toString(36)}`;
    38	let seq = 0;
    39	const nextId = (kind: string) => `b1dm_${kind}_${RUN}_${(seq += 1)}`;
    40	
    41	async function seedAgent(): Promise<{ id: string; name: string }> {
    42	  const id = nextId("agent");
    43	  await pgPool().query(
    44	    `INSERT INTO agents (id, name, description, api_key, points, vote_points, evaluation_points,
    45	                         legacy_unattributed_points, follower_count, is_claimed, created_at, is_vetted)
    46	     VALUES ($1, $2, '', $3, 0, 0, 0, 0, 0, false, NOW(), true)`,
    47	    [id, `${id}_named`, `b1dm_key_${id}`]
    48	  );
    49	  return { id, name: `${id}_named` };
    50	}
    51	
    52	afterAll(async () => {
    53	  const like = `b1dm_%_${RUN}%`;
    54	  await pgPool().query(
    55	    `DELETE FROM dm_messages WHERE conversation_id IN (
    56	       SELECT id FROM dm_conversations WHERE agent_low LIKE $1 OR agent_high LIKE $1
    57	     )`,
    58	    [like]
    59	  );
    60	  await pgPool().query(`DELETE FROM dm_conversations WHERE agent_low LIKE $1 OR agent_high LIKE $1`, [like]);
    61	  await pgPool().query(`DELETE FROM agent_rate_limits WHERE agent_id LIKE $1`, [like]);
    62	  await pgPool().query(`DELETE FROM agents WHERE id LIKE $1`, [like]);
    63	  await closeIntegrationConnections();
    64	});
    65	
    66	describe("concurrent sends — distinct increasing seqs, commit order = seq order", () => {
    67	  /**
    68	   * **A pair has exactly two possible senders, and each is capped at one send per cooldown
    69	   * window** (DMs share the comment cooldown — `dms/db.ts`'s own doc comment). A same-sender
    70	   * burst therefore cannot exercise the row-lock race at all: everything past the first send
    71	   * would legitimately refuse as `rate_limited`, which is a different gate. The concurrency this
    72	   * test can genuinely produce for ONE pair is the two directions firing at once.
    73	   */
    74	  it("A→B and B→A firing at once land distinct seqs with no gap or duplicate", async () => {
    75	    const a = await seedAgent();
    76	    const b = await seedAgent();
    77	
    78	    const outcomes = await runConcurrently<SendDmOutcome>([
    79	      () => sendDm({ senderId: a.id, recipientId: b.id, content: "from a" }),
    80	      () => sendDm({ senderId: b.id, recipientId: a.id, content: "from b" }),
    81	    ]);
    82	
    83	    expect(rejections(outcomes)).toEqual([]);
    84	    expect(outcomes.every((o) => o.ok && o.value.outcome === "inserted")).toBe(true);
    85	
    86	    const messages = await listDmMessages(a.id, b.id, { limit: 10 });
    87	    const seqs = messages.map((m) => m.seq).sort((x, y) => x - y);
    88	    expect(seqs).toEqual([1, 2]);
    89	    // `listDmMessages` orders DESC by seq — commit order (by seq, ascending) is exactly the
    90	    // reverse of read order, i.e. the read is self-consistent with the seq assignment.
    91	    expect(messages.map((m) => m.seq)).toEqual([2, 1]);
    92	  });
    93	});
    94	
    95	describe("send-vs-block linearization", () => {
    96	  /**
    97	   * Exactly one self-consistent outcome: either the send won the row first (block applies after,
    98	   * so a FOLLOW-UP send from the same sender is what gets refused), or the block won first (the
    99	   * racing send itself comes back `blocked`). Never both "sent" and "the block predates it".
   100	   */
   101	  async function assertLinearized(
   102	    sendOutcome: { outcome: string },
   103	    laterProbe: { outcome: string }
   104	  ): Promise<void> {
   105	    if (sendOutcome.outcome === "inserted") {
   106	      // The send won the row before the block (or the block had not yet landed) — a send AFTER
   107	      // both have settled must now be refused, proving the block did land, just second.
   108	      expect(laterProbe.outcome).toBe("blocked");
   109	    } else {
   110	      // The block won the row first — the racing send itself was refused as blocked.
   111	      expect(sendOutcome.outcome).toBe("blocked");
   112	    }
   113	  }
   114	
   115	  it("the blocker's own send races their own block (forward direction)", async () => {
   116	    const a = await seedAgent();
   117	    const b = await seedAgent();
   118	
   119	    const [sendOutcome, blockOutcome] = await runConcurrently<SendDmOutcome | boolean>([
   120	      () => sendDm({ senderId: a.id, recipientId: b.id, content: "racing my own block" }),
   121	      () => setDmBlock(a.id, b.id, true),
   122	    ]);
   123	    expect(rejections([sendOutcome, blockOutcome])).toEqual([]);
   124	    expect(sendOutcome.ok && blockOutcome.ok).toBe(true);
   125	
   126	    const probe = sendOutcome.ok ? (sendOutcome.value as SendDmOutcome) : { outcome: "blocked" as const };
   127	    const followUp = await sendDm({ senderId: a.id, recipientId: b.id, content: "after settling" });
   128	    await assertLinearized(probe, followUp);
   129	    // Whichever order won, the pair is blocked once both operations have settled.
   130	    expect(followUp.outcome).toBe("blocked");
   131	  });
   132	
   133	  it("the about-to-be-blocked agent races a send against the block (reverse direction)", async () => {
   134	    const a = await seedAgent();
   135	    const b = await seedAgent();
   136	
   137	    const [sendOutcome, blockOutcome] = await runConcurrently<SendDmOutcome | boolean>([
   138	      () => sendDm({ senderId: b.id, recipientId: a.id, content: "racing the block against me" }),
   139	      () => setDmBlock(a.id, b.id, true),
   140	    ]);
   141	    expect(rejections([sendOutcome, blockOutcome])).toEqual([]);
   142	    expect(sendOutcome.ok && blockOutcome.ok).toBe(true);
   143	
   144	    const probe = sendOutcome.ok ? (sendOutcome.value as SendDmOutcome) : { outcome: "blocked" as const };
   145	    const followUp = await sendDm({ senderId: b.id, recipientId: a.id, content: "after settling" });
   146	    await assertLinearized(probe, followUp);
   147	    expect(followUp.outcome).toBe("blocked");
   148	  });
   149	});
