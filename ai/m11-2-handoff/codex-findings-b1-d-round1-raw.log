    78	export async function POST(
    79	  request: NextRequest,
    80	  { params }: { params: Promise<{ agent_name: string }> }
    81	) {
    82	  const access = await requireAgent(request);
    83	  if (!access.ok) return access.response;
    84	  const rateLimitResponse = checkRateLimitAndRespond(access.agent);
    85	  if (rateLimitResponse) return rateLimitResponse;
    86	
    87	  const { agent_name } = await params;
    88	
    89	  try {
    90	    const body = await request.json();
    91	    const content = body?.content?.trim();
    92	    if (!content) return errorResponse("content is required");
    93	
    94	    const result = await sendDm({
