    37	export async function GET(
    38	  request: NextRequest,
    39	  { params }: { params: Promise<{ agent_name: string }> }
    40	) {
    41	  try {
    42	    const access = await requireAgent(request);
    43	    if (!access.ok) return access.response;
    44	    const rateLimitResponse = checkRateLimitAndRespond(access.agent);
    45	    if (rateLimitResponse) return rateLimitResponse;
    46	
    47	    const { agent_name } = await params;
    48	    const otherAgent = await getAgentByName(agent_name);
    49	    if (!otherAgent) {
    50	      return errorResponse("Agent not found", undefined, 404);
    51	    }
    52	
    53	    const limit = Math.min(500, Math.max(1, Number(request.nextUrl.searchParams.get("limit")) || 50));
    54	    const beforeSeq = request.nextUrl.searchParams.get("before_seq")
    55	      ? Number(request.nextUrl.searchParams.get("before_seq"))
    56	      : undefined;
    57	
    58	    const messages = await listDmMessages(access.agent.id, otherAgent.id, { limit, beforeSeq });
    59	
    60	    return jsonResponse({
    61	      success: true,
    62	      data: {
    63	        messages: messages.map((m) => ({
    64	          id: m.id,
    65	          conversation_id: m.conversationId,
    66	          sender_id: m.senderId,
    67	          content: m.content,
    68	          seq: m.seq,
    69	          created_at: m.createdAt,
    70	        })),
    71	      },
    72	    });
    73	  } catch {
    74	    return errorResponse("Failed to list messages", undefined, 500);
    75	  }
    76	}
