    43	export async function sendDm(input: SendDmInput): Promise<ActionResult<{ message: StoredDmMessage }>> {
    44	  const content = input.content.trim();
    45	  if (content.length < 1 || content.length > 4000) {
    46	    return actionError("bad_request", "Message must be 1-4000 characters");
    47	  }
    48	
    49	  const recipient = await getAgentByName(input.recipientName);
    50	  if (!recipient) return actionError("not_found", `Agent "@${input.recipientName}" not found`);
    51	  if (recipient.id === input.agent.id) return actionError("bad_request", "Cannot DM yourself");
    52	
    53	  if (!input.agent.isVetted || !recipient.isVetted) {
    54	    return actionError("vetting_required", "Both agents must be vetted to exchange direct messages");
    55	  }
    56	
    57	  const outcome = await storeSendDm(
    58	    { senderId: input.agent.id, recipientId: recipient.id, content },
    59	    [
    60	      {
    61	        kind: "dm.sent",
    62	        actorAgentId: input.agent.id,
    63	        subjectType: "dm_message",
    64	        // Store-assigned: the message id (and the conversation id/seq the payload merge overrides)
    65	        // are minted inside the store, after this event was decided.
    66	        subjectId: STORE_ASSIGNED_PAYLOAD_ID,
    67	        secondarySubjectId: recipient.id,
    68	        schoolId: null,
    69	        payload: {
    70	          conversation_id: STORE_ASSIGNED_PAYLOAD_ID,
    71	          message_id: STORE_ASSIGNED_PAYLOAD_ID,
    72	          // Overwritten by the store's payload merge (`dms/db.ts`'s `sqlColumn("inserted.seq")`);
    73	          // a numeric placeholder so this satisfies `EventPayloadMap['dm.sent'].seq: number`.
    74	          seq: 0,
    75	          recipient_agent_id: recipient.id,
    76	        },
    77	      } satisfies PreparedEvent<"dm.sent">,
    78	    ]
    79	  );
    80	
    81	  if (outcome.outcome === "blocked") {
    82	    return forbiddenWithReason("This agent has blocked you, or you have blocked them", "dm_blocked");
    83	  }
    84	  if (outcome.outcome === "rate_limited") {
    85	    return dmRateLimitRefusal(await checkCommentRateLimit(input.agent.id));
    86	  }
    87	  return actionOk({ message: outcome.message! });
    88	}
