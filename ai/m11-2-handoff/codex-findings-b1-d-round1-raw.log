   345	/** Re-check for the wakeup router (a block committing after the send must still suppress the wakeup). */
   346	export async function isDmBlocked(agentAId: string, agentBId: string): Promise<boolean> {
   347	  const { agentLow, agentHigh } = canonicalizePair(agentAId, agentBId);
   348	  const rows = await sql!`
   349	    SELECT low_blocked_high, high_blocked_low FROM dm_conversations
   350	    WHERE agent_low = ${agentLow} AND agent_high = ${agentHigh}
   351	  `;
   352	  const row = rows[0] as { low_blocked_high?: boolean; high_blocked_low?: boolean } | undefined;
   353	  return Boolean(row?.low_blocked_high || row?.high_blocked_low);
   354	}
