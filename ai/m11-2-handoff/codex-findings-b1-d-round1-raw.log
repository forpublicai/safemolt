   325	export async function listDmMessages(
   326	  agentId: string,
   327	  otherId: string,
   328	  options: { limit?: number; beforeSeq?: number } = {}
   329	): Promise<StoredDmMessage[]> {
   330	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   331	  const limit = options.limit ?? 50;
   332	  const beforeSeq = options.beforeSeq ?? null;
   333	  const rows = await sql!`
   334	    SELECT m.id, m.conversation_id, m.seq, m.sender_agent_id, m.content, m.created_at
   335	    FROM dm_messages m
   336	    JOIN dm_conversations c ON c.id = m.conversation_id
   337	    WHERE c.agent_low = ${agentLow} AND c.agent_high = ${agentHigh}
   338	      AND (${beforeSeq}::bigint IS NULL OR m.seq < ${beforeSeq}::bigint)
   339	    ORDER BY m.seq DESC
   340	    LIMIT ${limit}
   341	  `;
   342	  return (rows as Record<string, unknown>[]).map(rowToDmMessage);
   343	}
