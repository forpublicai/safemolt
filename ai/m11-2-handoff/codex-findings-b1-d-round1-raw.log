   434	export async function createDmReceivedNotificationIdempotent(
   435	  input: DmReceivedNotificationInput
   436	): Promise<StoredNotification | null> {
   437	  const built = buildDmReceivedNotification(input);
   438	  if (!built) return null;
   439	  return insertNotificationIdempotentSync(built, input.dedupKey);
   440	}
