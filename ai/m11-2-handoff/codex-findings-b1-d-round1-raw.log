   164	describe("concurrent send/mark-read never strands a message", () => {
   165	  /**
   166	   * Nothing that committed AFTER `markDmRead` returned may be missing from the unread count. A
   167	   * message that committed BEFORE the read is legitimately at-or-below the cursor; the spec's
   168	   * wording is one-directional on purpose, since `markDmRead`'s own lock (the pair row) makes it
   169	   * impossible for a send that commits strictly after it to be silently swept under the cursor.
   170	   */
   171	  it("unread count accounts for every send that committed after the read returned", async () => {
   172	    const a = await seedAgent();
   173	    const b = await seedAgent();
   174	    // One message the reader has already seen, so `last_read_seq` starts above zero.
   175	    expect((await sendDm({ senderId: a.id, recipientId: b.id, content: "seen" })).outcome).toBe("inserted");
   176	    expect(await markDmRead(b.id, a.id)).toBe(true);
   177	
   178	    const results = await runConcurrently<SendDmOutcome | boolean>([
   179	      ...[1, 2, 3].map((n) => () => sendDm({ senderId: a.id, recipientId: b.id, content: `burst ${n}` })),
   180	      () => markDmRead(b.id, a.id),
   181	    ]);
   182	    expect(rejections(results)).toEqual([]);
   183	
   184	    const conversations = await listDmConversations(b.id);
   185	    const unreadFromList = conversations[0]?.unreadCount ?? 0;
   186	    const unreadCounted = await countUnreadDms(b.id);
   187	    expect(unreadCounted).toBe(unreadFromList);
