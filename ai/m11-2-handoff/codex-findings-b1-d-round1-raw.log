   295	/** The caller's own conversations, newest activity first. Unread counts computed in SQL. */
   296	export async function listDmConversations(
   297	  agentId: string,
   298	  options: { limit?: number; offset?: number } = {}
   299	): Promise<StoredDmConversation[]> {
   300	  const limit = options.limit ?? 20;
   301	  const offset = options.offset ?? 0;
   302	  const rows = await sql!`
   303	    SELECT c.id,
   304	           CASE WHEN c.agent_low = ${agentId} THEN c.agent_high ELSE c.agent_low END AS other_id,
   305	           a.name AS other_name,
   306	           c.last_message_at,
   307	           CASE WHEN c.agent_low = ${agentId}
   308	                THEN c.last_message_seq - c.low_last_read_seq
   309	                ELSE c.last_message_seq - c.high_last_read_seq
   310	           END AS unread_count
   311	    FROM dm_conversations c
   312	    LEFT JOIN agents a ON a.id = CASE WHEN c.agent_low = ${agentId} THEN c.agent_high ELSE c.agent_low END
   313	    WHERE c.agent_low = ${agentId} OR c.agent_high = ${agentId}
   314	    ORDER BY c.last_message_at DESC NULLS LAST, c.created_at DESC
   315	    LIMIT ${limit} OFFSET ${offset}
   316	  `;
   317	  return (rows as Record<string, unknown>[]).map(rowToDmConversation);
   318	}
