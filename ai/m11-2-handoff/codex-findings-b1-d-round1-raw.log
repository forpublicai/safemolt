   356	/** Total unread across every conversation the agent is in. */
   357	export async function countUnreadDms(agentId: string): Promise<number> {
   358	  const rows = await sql!`
   359	    SELECT COALESCE(SUM(
   360	      CASE WHEN agent_low = ${agentId} THEN last_message_seq - low_last_read_seq
   361	           ELSE last_message_seq - high_last_read_seq END
   362	    ), 0)::int AS unread
   363	    FROM dm_conversations
   364	    WHERE agent_low = ${agentId} OR agent_high = ${agentId}
   365	  `;
   366	  return Number((rows[0] as { unread?: number } | undefined)?.unread ?? 0);
   367	}

