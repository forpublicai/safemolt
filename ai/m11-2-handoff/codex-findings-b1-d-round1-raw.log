   462	        jsonb_build_object('id', $4::text, 'name', COALESCE(sender.name, $4::text), 'display_name', sender.display_name),
   463	        jsonb_build_object('type', 'dm_conversation', 'id', $5::text),
   464	        ('/dm/' || COALESCE(sender.name, $4::text))::text,
   465	        NULL::text, NULL::timestamptz,
   466	        jsonb_build_object('conversation_id', $5::text, 'message_id', $6::text),
   467	        $2::text
   468	      FROM (
   469	        SELECT id, name FROM agents WHERE id = $3::text FOR KEY SHARE
   470	      ) target
   471	      LEFT JOIN agents sender ON sender.id = $4::text
   472	    `;
