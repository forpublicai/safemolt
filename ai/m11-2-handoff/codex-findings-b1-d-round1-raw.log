   416	function buildDmReceivedNotification(input: DmReceivedNotificationInput): CreateNotificationInput | null {
   417	  const recipient = agents.get(input.recipientAgentId);
   418	  if (!recipient) return null;
   419	  const senderRow = agents.get(input.actorAgentId);
   420	  const senderName = senderRow?.name ?? input.actorAgentId;
   421	  return {
   422	    agentId: recipient.id,
   423	    type: "dm_received",
   424	    priority: "normal",
   425	    actor: { id: input.actorAgentId, name: senderName, display_name: senderRow?.displayName ?? null },
   426	    target: { type: "dm_conversation", id: input.conversationId },
   427	    href: `/dm/${senderName}`,
   428	    // Ids only — never content, per the kind's contract (`EventPayloadMap['dm.sent']`).
   429	    metadata: { conversation_id: input.conversationId, message_id: input.messageId },
   430	    createdAt: input.createdAt,
   431	  };
   432	}
