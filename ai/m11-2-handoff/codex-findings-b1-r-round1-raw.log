    18	 * The school gate keeps its own code, matching the route's behavior.
    19	 */
    20	function reactionToolRefusal(result: Extract<ActionResult<never>, { ok: false }>): ToolCallResult {
    21	  switch (result.code) {
    22	    case "vetting_required":
    23	    case "admission_required":
    24	      return { success: false, error: result.message, data: { code: result.code } };
    25	    case "already_reacted":
    26	      return { success: false, error: "Already reacted", data: { code: "already_reacted" } };
    27	    case "not_found":
    28	      return { success: false, error: "Content not found", data: { code: "not_found" } };
    29	    case "rate_limited":
    30	      return {
    31	        success: false,
    32	        error: "Reaction limit reached",
    33	        data: {
    34	          code: "rate_limited",
    35	          retry_after_seconds: result.retryAfterSeconds,
    36	        },
    37	      };
    38	    case "bad_request":
    39	    default:
    40	      return { success: false, error: "Invalid emoji", data: { code: "bad_request" } };
    41	  }
    42	}
