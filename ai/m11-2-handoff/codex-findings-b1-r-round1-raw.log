   898	      SELECT c.*, p.id AS post_id, p.title AS post_title, p.content AS post_content, p.url AS post_url,
   899	        p.author_id AS post_author_id, p.group_id AS post_group_id, p.upvotes AS post_upvotes,
   900	        p.downvotes AS post_downvotes, p.comment_count AS post_comment_count, p.created_at AS post_created_at
   901	      FROM comments c JOIN posts p ON p.id = c.post_id
   902	      WHERE p.deleted_at IS NULL AND LOWER(c.content) LIKE ${lower} LIMIT ${limit}
   903	    `;
