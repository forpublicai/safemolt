   295	export interface CreateOrReArmPlaygroundRoundWakeupInput {
   296	  agentId: string;
   297	  /** ALWAYS non-null — this path is event-keyed dedup only, like `createOrReArmWakeup`. */
   298	  eventId: number;
   299	  payload: Record<string, unknown>;
   300	  delivery: WakeupDelivery;
   301	  dueAt?: string;
   302	  /** The session whose round this wakeup is for — the live-state gate's subject. */
   303	  sessionId: string;
   304	  round: number;
   305	}
   306	
   307	/**
   308	 * The one reason this gated path arms. A constant, not a parameter: the gate below reads playground
   309	 * tables, so the operation is playground-specific by nature, and both callers (the wakeup-router
   310	 * consumer and the deadline sweep) must spell the reason identically or the dedup triple splits.
   311	 */
   312	export const PLAYGROUND_ROUND_REASON = "playground_round";
   313	
   314	/**
   315	 * `createOrReArmWakeup`, but for `playground_round` — with the freshness check INSIDE the statement,
   316	 * under a lock (codex u5-C round 1 MAJOR).
   317	 *
   318	 * Both callers used to pre-read the session (active, `current_round` matches, agent un-acted) and
   319	 * then await other work before inserting. A pre-read that RETURNS competes with the decisive
   320	 * statement and loses (CLAUDE.md): a session advancing to round N+1 in that window let a stale
   321	 * round-N wakeup land beside the legitimate round-N+1 one — two claimable rows for one agent,
   322	 * double budget the moment P3.3's runner exists, because the event-keyed dedup index sees two
   323	 * different event ids.
   324	 *
   325	 * So `live` re-checks the session AND the agent's action at insert time, and takes the session row
   326	 * `FOR SHARE` — never a bare `EXISTS`, which is snapshot-evaluated and never re-checked. The
   327	 * advancement CAS is an `UPDATE` of that same row, so `FOR SHARE` either sees its committed round
   328	 * (and arms nothing) or blocks it until this statement commits (and the CAS then advances a session
   329	 * whose stale-round wakeup was never created). The action `NOT EXISTS` stays unlocked deliberately:
   330	 * a just-acted agent's wakeup is only wasted budget, and `submitAction`'s duplicate-per-round
   331	 * rejection already refuses the turn — the plan frames that check as budget protection, not
   332	 * correctness. Both arms — the insert AND the re-arm — gate on `live`, so a dead round can neither
   333	 * gain a new row nor resurrect a completed one.
   334	 *
   335	 * Lock order is `playground_sessions → agents` (the insert's FK takes `FOR KEY SHARE` on the
   336	 * agent), the same order `submitAction`'s gated insert takes; nothing in the tree takes an agent
   337	 * lock before a session lock, so no cycle is introduced.
   338	 *
   339	 * F1: `ins`/`rearmed` also gate on the locked webhook registration when `delivery = 'webhook'` —
   340	 * see `insertWakeupSql`'s own doc comment for why a ledger-less webhook-primary row is a defect.
   341	 */
   342	export async function createOrReArmPlaygroundRoundWakeup(
   343	  input: CreateOrReArmPlaygroundRoundWakeupInput
   344	): Promise<CreateOrReArmWakeupResult> {
   345	  const rows = await sql!(
   346	    `
   347	    /* p3.2:playground-round-arm */
   348	    WITH live AS (
   349	      SELECT s.id FROM playground_sessions s
   350	      WHERE s.id = $7 AND s.status = 'active' AND s.current_round = $8
   351	        AND NOT EXISTS (
   352	          SELECT 1 FROM playground_actions a
   353	          WHERE a.session_id = s.id AND a.agent_id = $1 AND a.round = $8
   354	        )
   355	      FOR SHARE OF s
   356	    ),
   357	    ${registrationCte("reg")},
   358	    ins AS (
   359	      INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at)
   360	      SELECT $1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW())
   361	      FROM live
   362	      WHERE $5::text <> 'webhook' OR EXISTS (SELECT 1 FROM reg)
   363	      ON CONFLICT DO NOTHING
   364	      RETURNING *
   365	    ),
   366	    rearmed AS (
   367	      UPDATE agent_wakeups
   368	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   369	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   370	        AND EXISTS (SELECT 1 FROM live)
   371	        AND completed_at IS NOT NULL
   372	        AND result IS DISTINCT FROM 'acted'
   373	        AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   374	        AND ${rearmWebhookGate("reg")}
   375	      RETURNING *
   376	    ),
   377	    ${webhookLedgerCte(["ins", "rearmed"], "wh", "rearmed", "reg")}
   378	    SELECT (SELECT to_jsonb(ins) FROM ins) AS created_row,
   379	           (SELECT to_jsonb(rearmed) FROM rearmed) AS rearmed_row
   380	  `,
   381	    [
   382	      ...insertParams({
   383	        agentId: input.agentId,
   384	        reason: PLAYGROUND_ROUND_REASON,
   385	        eventId: input.eventId,
   386	        payload: input.payload,
   387	        delivery: input.delivery,
   388	        dueAt: input.dueAt,
   389	      }),
   390	      input.sessionId,
   391	      input.round,
   392	    ]
   393	  );
   394	  const row = rows[0] as { created_row: unknown; rearmed_row: unknown } | undefined;
   395	  return {
   396	    created: row?.created_row != null,
   397	    reArmed: row?.rearmed_row != null,
   398	  };
   399	}
   400	
   401	/**
   402	 * The NORMATIVE re-arm predicate, standalone, by a KNOWN numeric id.
   403	 *
   404	 * For a caller that already holds the row — a future runner will; nothing in THIS lane does. The
   405	 * predicate is `ai/PLAN_M11_2.md` P3.2's normative text verbatim: **do not add, remove or reorder a
   406	 * clause.** Each one is load-bearing:
   407	 *  - `completed_at IS NOT NULL` — a live claim, even a lease-expired one housekeeping has not
   408	 *    abandoned yet, is never touched;
   409	 *  - `result IS DISTINCT FROM 'acted'` — an agent that actually acted does not get a second turn;
   410	 *  - `result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE` — a wakeup
   411	 *    refused for budget is re-armable tomorrow, when the daily bucket rolls over, and not before.
   412	 *
   413	 * Clearing `claim_token` is what makes abandonment final for a superseded runner: its own renewal
   414	 * (`… WHERE claim_token = $token AND completed_at IS NULL`) fails from that moment on.
   415	 */
   416	export async function reArmWakeupById(id: number): Promise<boolean> {
   417	  const rows = await sql!(
   418	    `
   419	    UPDATE agent_wakeups
   420	    SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   421	    WHERE id = $1 AND completed_at IS NOT NULL AND result IS DISTINCT FROM 'acted'
   422	      AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   423	    RETURNING id
   424	  `,
   425	    [id]
   426	  );
   427	  return rows.length > 0;
   428	}
   429	
   430	export async function getWakeupByAgentReasonEvent(
   431	  agentId: string,
   432	  reason: string,
   433	  eventId: number
   434	): Promise<StoredWakeup | null> {
   435	  const rows = await sql!(
   436	    `SELECT * FROM agent_wakeups
   437	     WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   438	     LIMIT 1`,
   439	    [agentId, reason, eventId]
   440	  );
   441	  return rows.length > 0 ? rowToWakeup(rows[0]) : null;
   442	}
   443	
   444	/**
   445	 * One agent's wakeups, newest first.
   446	 *
   447	 * Ordered by `id`, not by `due_at`: a sweep arms a whole round's participants from one `NOW()`, so
   448	 * `due_at` ties are the ordinary case and an order that can tie makes a limited read
   449	 * nondeterministic. This is a diagnostic/adjacent-caller read, not the runner's scan — the runner's
   450	 * scan is `idx_wakeups_due` and belongs to P3.3.
   451	 */
   452	export async function listWakeupsForAgent(
   453	  agentId: string,
   454	  options?: { reason?: string; limit?: number }
   455	): Promise<StoredWakeup[]> {
