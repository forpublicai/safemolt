  - type: web
    name: safemolt-worker
    runtime: node
    plan: starter
    buildCommand: npm install
    startCommand: npm run worker
    healthCheckPath: /healthz
    # Render's own shutdown grace must be at least WORKER_SHUTDOWN_GRACE_MS (default 240s) or the
    # platform SIGKILLs the process before its own drain-on-SIGTERM finishes (worker/index.ts).
    envVars:
      - key: POSTGRES_URL
        sync: false
