   720	describe("F5(a): a forced failure between the ledger write and the wakeup completion rolls both back", () => {
   721	  const TRIGGER_FN = `b1w_fail_wakeup_${RUN}`;
   722	  const FAIL_REASON = `b1w_f5a_fail_${RUN}`;
   723	
   724	  /** A trigger on `agent_wakeups`, not `webhook_deliveries`: it fires strictly AFTER the ledger's own
   725	   * UPDATE has run inside the same statement, proving the two are one atomic unit, not two writes. */
   726	  async function withRefusedWakeupCompletion<T>(run: () => Promise<T>): Promise<T> {
   727	    await pgPool().query(`
   728	      CREATE OR REPLACE FUNCTION ${TRIGGER_FN}() RETURNS trigger LANGUAGE plpgsql AS $fn$
   729	      BEGIN
   730	        IF NEW.reason = '${FAIL_REASON}' THEN
   731	          RAISE EXCEPTION 'b1w injected wakeup-completion failure';
   732	        END IF;
   733	        RETURN NEW;
   734	      END;
   735	      $fn$;
   736	    `);
   737	    await pgPool().query(`
   738	      CREATE TRIGGER ${TRIGGER_FN} BEFORE UPDATE ON agent_wakeups
   739	      FOR EACH ROW EXECUTE FUNCTION ${TRIGGER_FN}()
   740	    `);
   741	    try {
   742	      return await run();
   743	    } finally {
   744	      await pgPool().query(`DROP TRIGGER IF EXISTS ${TRIGGER_FN} ON agent_wakeups`);
   745	      await pgPool().query(`DROP FUNCTION IF EXISTS ${TRIGGER_FN}()`);
   746	    }
   747	  }
   748	
   749	  it("neither the ledger row nor the wakeup change when the wakeup completion is refused", async () => {
