   179	/**
   180	 * F1: the wakeup row itself, gated on the locked registration whenever it would be webhook-primary
   181	 * — a fresh row for a delivery no live registration backs would have no ledger to ever claim it
   182	 * through. `$5` is `delivery`; non-webhook deliveries (internal/none) need no registration at all.
   183	 */
   184	function insertWakeupSql(regName: string): string {
   185	  return `
   186	    INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at)
   187	    SELECT $1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW())
   188	    WHERE $5::text <> 'webhook' OR EXISTS (SELECT 1 FROM ${regName})
   189	    ON CONFLICT DO NOTHING`;
   190	}
   191	
   192	/** F1: the same registration gate as `insertWakeupSql`, applied to a re-arm of an EXISTING row's own `delivery`. */
   193	function rearmWebhookGate(regName: string): string {
   194	  return `(delivery <> 'webhook' OR EXISTS (SELECT 1 FROM ${regName}))`;
   195	}
