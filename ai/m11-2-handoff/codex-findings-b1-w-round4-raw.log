   197	function insertParams(input: EnqueueWakeupInput | CreateOrReArmWakeupInput): unknown[] {
   198	  return [
   199	    input.agentId,
   200	    input.reason,
   201	    input.eventId,
   202	    JSON.stringify(input.payload ?? {}),
   203	    input.delivery,
   204	    input.dueAt ?? null,
   205	  ];
   206	}
