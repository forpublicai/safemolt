        value: "600000"
      - key: WORKER_DRAIN_INTERVAL_MS
        value: "10000"
      - key: WORKER_DEADLINE_INTERVAL_MS
        value: "60000"
      - key: WORKER_WAKEUP_INTERVAL_MS
        value: "5000"
      - key: WORKER_IDLE_SWEEP_INTERVAL_MS
        value: "60000"
      - key: WORKER_SHUTDOWN_GRACE_MS
        value: "240000"
      - key: PORT
        value: "3001"
      - key: WORKER_WEBHOOK_INTERVAL_MS
        value: "5000"
      - key: WEBHOOK_DELIVERY_BATCH
