   751	    await upsertAgentWebhook({ agentId: agent, url: "https://example.com/hook", secret: "s", mode: "primary" });
   752	    const wakeupId = await seedWebhookWakeup(agent, FAIL_REASON);
   753	    const claimed = await claimNextWebhookDelivery({ claimToken: `b1w_f5a_${RUN}`, leaseMs: 30_000 });
   754	    expect(claimed?.wakeupId).toBe(wakeupId); // the claim scans globally — pin it to THIS test's row
   755	
   756	    await withRefusedWakeupCompletion(async () => {
   757	      await expect(
   758	        recordWebhookAttempt({ id: claimed!.id, claimToken: claimed!.claimToken, status: 200, ok: true })
   759	      ).rejects.toThrow(/b1w injected wakeup-completion failure/);
   760	    });
   761	
   762	    const ledger = await ledgerRowForWakeup(wakeupId);
   763	    expect(ledger.attempts).toBe(0);
   764	    expect(ledger.terminal_reason).toBeNull();
   765	    expect(ledger.claim_token).toBe(claimed!.claimToken); // the claim itself also rolled back with it
   766	    const wakeup = await wakeupRow(wakeupId);
   767	    expect(wakeup.completed_at).toBeNull();
   768	  });
   769	});
