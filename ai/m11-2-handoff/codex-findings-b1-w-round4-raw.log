   238	/**
   239	 * Find-or-create-or-re-arm in ONE statement, keyed by the dedup TRIPLE `(agent_id, reason,
   240	 * event_id)` — never by a numeric row id, because the caller does not know one yet.
   241	 *
   242	 * `eventId` is always non-null on this path, so the bare `ON CONFLICT DO NOTHING` in `ins` can only
   243	 * ever match `idx_wakeups_dedup_event`; the idle index cannot apply to a row with an event id.
   244	 *
   245	 * **The two CTEs are mutually exclusive by construction, so this needs no arbiter.** A freshly
   246	 * inserted row has `completed_at IS NULL`, which `rearmed`'s predicate cannot match, so there is no
   247	 * torn state and no deadlock shape for CLAUDE.md's "sibling data-modifying CTEs need an ARBITER"
   248	 * rule to apply to — the only reachable interleaving is the benign one below.
   249	 *
   250	 * **`created: false, reArmed: false` is a LEGITIMATE outcome, not a bug.** Two callers racing this
   251	 * statement for the same triple when no row exists yet — the router and the sweep reacting to one
   252	 * freshly drained `round_opened` — can BOTH answer false/false: the loser's `ins` correctly no-ops
   253	 * against the winner's now-committed row, while its own `rearmed` CTE is evaluated against a
   254	 * statement snapshot taken before that commit and therefore also sees nothing. After both statements
   255	 * complete exactly one row exists — never zero, never two, because the unique index says so — and
   256	 * that is the only invariant a best-effort nudge queue needs. Do NOT add `FOR UPDATE` or any other
   257	 * arbiter to force one caller to "win" and see it: that buys serialization contention for a
   258	 * reporting gap with no correctness payoff. The loser sees the row already in the state it wanted,
   259	 * next pass.
   260	 */
   261	export async function createOrReArmWakeup(
   262	  input: CreateOrReArmWakeupInput
   263	): Promise<CreateOrReArmWakeupResult> {
   264	  const rows = await sql!(
   265	    `
   266	    /* p3.2:create-or-rearm */
   267	    WITH ${registrationCte("reg")},
   268	    ins AS (
   269	      ${insertWakeupSql("reg")}
   270	      RETURNING *
   271	    ),
   272	    rearmed AS (
   273	      UPDATE agent_wakeups
   274	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   275	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   276	        AND completed_at IS NOT NULL
   277	        AND result IS DISTINCT FROM 'acted'
   278	        AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   279	        AND ${rearmWebhookGate("reg")}
   280	      RETURNING *
   281	    ),
   282	    ${webhookLedgerCte(["ins", "rearmed"], "wh", "rearmed", "reg")}
   283	    SELECT (SELECT to_jsonb(ins) FROM ins) AS created_row,
   284	           (SELECT to_jsonb(rearmed) FROM rearmed) AS rearmed_row
   285	  `,
   286	    insertParams(input)
   287	  );
   288	  const row = rows[0] as { created_row: unknown; rearmed_row: unknown } | undefined;
   289	  return {
   290	    created: row?.created_row != null,
   291	    reArmed: row?.rearmed_row != null,
   292	  };
   293	}
