   132	/**
   133	 * F1/F3: the registration lock the WHOLE domain takes first — `FOR SHARE`, one agent ($1) per
   134	 * statement — so every enqueue/re-arm serializes against `deleteAgentWebhook`'s row-owning `DELETE`
   135	 * and against `recordWebhookAttempt`'s own registration lock (same order there, F4).
   136	 */
   137	function registrationCte(name: string): string {
   138	  return `${name} AS (
   139	      SELECT mode FROM agent_webhooks WHERE agent_id = $1 AND disabled_at IS NULL FOR SHARE
   140	    )`;
   141	}
   142	
   143	/**
   144	 * The ledger row is a CTE of the SAME insert as its wakeup, never a second auto-committed call, so a
   145	 * crash between the two cannot leave a webhook-primary wakeup with no ledger. `regName` is the
   146	 * caller's already-locked `registrationCte`, reused under the same lock (F1). A stale row resets only
   147	 * when TERMINAL and its wakeup is webhook-primary — re-derived by id, since `EXCLUDED` cannot see it
   148	 * — or an internal re-arm of a `mode='both'` wakeup would clobber a live webhook attempt (F3).
   149	 */
   150	function webhookLedgerCte(rowCteNames: readonly string[], namePrefix: string, rearmCteName: string | undefined, regName: string): string {
   151	  const rowName = `${namePrefix}_row`;
   152	  const union = rowCteNames.map((name) => `SELECT id, agent_id, delivery FROM ${name}`).join("\n      UNION ALL\n      ");
   153	  const conflictClause = rearmCteName
   154	    ? `ON CONFLICT (wakeup_id) DO UPDATE
   155	        SET attempts = 0, delivered_at = NULL, last_status = NULL, last_attempt_at = NULL,
   156	            terminal_reason = NULL, claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL,
   157	            next_attempt_at = NOW()
   158	        WHERE webhook_deliveries.terminal_reason IS NOT NULL
   159	          AND EXISTS (SELECT 1 FROM ${rearmCteName} WHERE ${rearmCteName}.id = webhook_deliveries.wakeup_id)
   160	          AND EXISTS (SELECT 1 FROM ${rowName} rr WHERE rr.id = webhook_deliveries.wakeup_id AND rr.delivery = 'webhook')`
   161	    : `ON CONFLICT (wakeup_id) DO NOTHING`;
   162	  return `
   163	    ${rowName} AS (
   164	      ${union}
   165	    ),
   166	    ${namePrefix}_ledger AS (
   167	      INSERT INTO webhook_deliveries (wakeup_id, agent_id, next_attempt_at)
   168	      SELECT r.id, r.agent_id, NOW()
   169	      FROM ${rowName} r
   170	      WHERE EXISTS (
   171	        SELECT 1 FROM ${regName} g
   172	        WHERE r.delivery = 'webhook' OR g.mode = 'both'
   173	      )
   174	      ${conflictClause}
   175	      RETURNING wakeup_id
   176	    )`;
   177	}
