   208	/**
   209	 * Plain insert. Never re-arms — a completed row stays completed.
   210	 *
   211	 * **The bare `ON CONFLICT DO NOTHING` carries no conflict target, and that is deliberate.** Postgres
   212	 * lets a plain `DO NOTHING` absorb a violation of *any* unique or exclusion constraint on the table,
   213	 * and exactly two partial unique indexes can fire here: `idx_wakeups_dedup_event` when `event_id IS
   214	 * NOT NULL`, and `idx_wakeups_dedup_idle` when `event_id IS NULL AND completed_at IS NULL`. Whichever
   215	 * applies to this row is the one that should suppress the insert, and the caller does not have to
   216	 * know which — naming a target would force it to, and would turn the other index's violation into a
   217	 * raised 23505.
   218	 *
   219	 * Note the asymmetry the two indexes encode: the event-keyed one is NOT partial on `completed_at`,
   220	 * so a completed event-keyed row blocks a second insert forever (only a re-arm reuses it), while a
   221	 * completed idle row stops blocking and a fresh idle wakeup may be enqueued again.
   222	 */
   223	export async function enqueueWakeup(input: EnqueueWakeupInput): Promise<EnqueueWakeupResult> {
   224	  const rows = await sql!(
   225	    `WITH ${registrationCte("reg")},
   226	    ins AS (
   227	      ${insertWakeupSql("reg")}
   228	      RETURNING *
   229	    ),
   230	    ${webhookLedgerCte(["ins"], "wh", undefined, "reg")}
   231	    SELECT ins.* FROM ins`,
   232	    insertParams(input)
   233	  );
   234	  if (rows.length === 0) return { created: false, wakeup: null };
   235	  return { created: true, wakeup: rowToWakeup(rows[0]) };
   236	}
