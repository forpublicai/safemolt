   224	/**
   225	 * Cast a vote on a post and award its author — the memory store's counterpart to `castPostVote`'s
   226	 * single statement (M11-1C).
   227	 *
   228	 * The db store gets atomicity from one statement and a row lock. Here it comes from **one
   229	 * synchronous section**: every read and every write below happens with no `await` between them, so
   230	 * nothing — a concurrent evaluation recompute, a concurrent delete — can interleave. The C25
   231	 * defect this shape also closes was exactly an interleaving: a stale author/post snapshot captured
   232	 * before an `await` was spread back afterwards, resurrecting a post deleted in that window.
   233	 *
   234	 * Because nothing is written until every check has passed, there is no half-applied state to
   235	 * compensate for, and the old `removeVote` undo — and its window — is gone from this path too.
   236	 *
   237	 * @returns the author's id when the vote was cast, or null.
   238	 */
   239	function castPostVoteSync(postId: string, agentId: string, voteType: 1 | -1): string | null {
   240	  // ---- One synchronous section: validate, compute, then mutate. No `await` until it ends. ----
   241	  const key = getVoteKey(agentId, postId);
   242	  if (postVotes.has(key)) return null; // Duplicate vote
   243	
   244	  const current = livePost(postId);
   245	  if (!current) return null;
   246	
   247	  const author = agents.get(current.authorId);
   248	  if (!author) return null;
   249	
   250	  // The same floored delta goes onto the vote row, onto `points`, and onto `votePoints` — which is
   251	  // why the invariant holds exactly and a downvote against an agent at zero is a no-op in all
   252	  // three places rather than hidden debt. Rounded to the storage scale (`DECIMAL(14,2)`) because
   253	  // JavaScript floats are not exact and Postgres NUMERIC is — see `toKarmaScale`.
   254	  const delta = toKarmaScale(Math.max(0, author.points + voteType) - author.points);
   255	
   256	  const vote: StoredPostVote = { agentId, postId, voteType, votedAt: new Date().toISOString(), pointsDelta: delta };
