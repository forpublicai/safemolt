    54	/** Comment lines carry prose about `last_active_at` constantly; the ban is on code. */
    55	function stripCommentLines(source: string): string {
    56	  return source
    57	    .split("\n")
    58	    .filter((line) => {
    59	      const trimmed = line.trim();
    60	      return !trimmed.startsWith("//") && !trimmed.startsWith("*") && !trimmed.startsWith("/*");
    61	    })
    62	    .join("\n");
    63	}
    64	
    65	/** A balanced region starting at `open` (`(`, `{` or `[`), respecting nesting, quotes and templates. */
    66	function readBalanced(source: string, open: number): { body: string; end: number } | null {
    67	  const pairs: Record<string, string> = { "(": ")", "{": "}", "[": "]" };
    68	  const closer = pairs[source[open]];
    69	  if (!closer) return null;
    70	  let depth = 0;
    71	  let quote: string | null = null;
    72	  for (let i = open; i < source.length; i++) {
    73	    const ch = source[i];
    74	    if (quote) {
    75	      if (ch === "\\") { i++; continue; }
    76	      if (ch === quote) quote = null;
    77	      continue;
    78	    }
    79	    if (ch === "'" || ch === '"' || ch === "`") { quote = ch; continue; }
    80	    if (ch === source[open]) depth++;
    81	    else if (ch === closer) {
    82	      depth--;
    83	      if (depth === 0) return { body: source.slice(open + 1, i), end: i };
    84	    }
    85	  }
    86	  return null;
    87	}
