   107	function lineOf(source: string, index: number): number {
   108	  return source.slice(0, index).split("\n").length;
   109	}
   110	
   111	/** The enclosing `function <name>(` — nearest preceding declaration, sufficient for this file's two flat functions. */
   112	function enclosingFunction(source: string, offset: number): string | null {
   113	  const decl = /function\s+([A-Za-z0-9_]+)\s*\(/g;
   114	  let best: { name: string; index: number } | null = null;
   115	  for (const m of source.matchAll(decl)) {
   116	    if (m.index <= offset && (!best || m.index > best.index)) best = { name: m[1], index: m.index };
