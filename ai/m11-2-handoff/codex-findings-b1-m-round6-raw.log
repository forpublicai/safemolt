   214	    const limit = options.limit ?? 25;
   215	    let rows: Record<string, unknown>[];
   216	    const groupName = options.group;
   217	    const sort = options.sort || "new";
   218	
   219	    // If filtering by group name, resolve it to group ID first
   220	    let groupId: string | undefined;
   221	    if (groupName) {
   222	        const groupRows = await sql!`SELECT id FROM groups WHERE LOWER(name) = LOWER(${groupName}) LIMIT 1`;
   223	        if (groupRows.length > 0) {
   224	            groupId = (groupRows[0] as { id: string }).id;
   225	        } else {
   226	            // Group not found, return empty array
