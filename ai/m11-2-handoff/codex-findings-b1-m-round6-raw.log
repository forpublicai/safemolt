    41	/** A `lastActiveAt:` key at the top level of an object literal — read the same way as `OBJECT_KARMA`. */
    42	const OBJECT_LAST_ACTIVE = /(?:^|[{,])\s*lastActiveAt\s*(?::|,|\}|$)/m;
