    31	/** `agents.set(` — the memory store's only way to persist an agent row. */
    32	const AGENTS_SET = /\bagents\s*\.\s*set\s*\(/g;
    33	
    34	/**
    35	 * A direct field assignment: `x.lastActiveAt = …`. `(?!=)` keeps `===`/`==` comparisons out. This
    36	 * shape needs no `agents.set(` guard — an in-place mutation of a live object IS the write, exactly
    37	 * like the karma scanner's `in-place-karma-assignment`.
