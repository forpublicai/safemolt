    44	function collectFiles(dir: string, out: string[] = []): string[] {
    45	  for (const entry of readdirSync(dir)) {
    46	    if (entry === "node_modules" || entry === ".next" || entry === "__tests__") continue;
    47	    const full = join(dir, entry);
    48	    if (statSync(full).isDirectory()) collectFiles(full, out);
    49	    else if (SCANNED_EXTENSIONS.some((ext) => entry.endsWith(ext))) out.push(full);
    50	  }
    51	  return out;
    52	}
