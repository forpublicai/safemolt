export function isPubliclyHiddenAgent(agent: Pick<StoredAgent, "metadata" | "name">): boolean {
  const m = metadata(agent);
  return m.system === true || m.test === true || m.source === "test" || TEST_NAME_PATTERN.test(agent.name);
