    93	 */
    94	function boundObjectLiteral(source: string, callArgs: string, callIndex: number): string | null {
    95	  const identifier = callArgs.match(/,\s*([A-Za-z_$][\w$]*)\s*$/)?.[1];
    96	  if (!identifier) return null;
    97	  const escaped = identifier.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    98	  const bindings = new RegExp(`(?:\\bconst\\s+|[^\\w$.=!<>+\\-*/%&|^])${escaped}\\s*=(?!=)\\s*\\{`, "g");
    99	  for (const binding of source.matchAll(bindings)) {
   100	    if (binding.index >= callIndex) break; // matchAll yields in source order
   101	    const body = readBalanced(source, binding.index + binding[0].length - 1)?.body ?? null;
   102	    if (body !== null && OBJECT_LAST_ACTIVE.test(body)) return body;
   103	  }
   104	  return null;
   105	}
