    96	  // The id is minted BEFORE anything else, because the events cannot be described until their
    97	  // `post_id` is final. `nextPostId` only advances an opaque counter, so a refused post spending one
    98	  // costs nothing; the db store mints its id before its statement for the same reason.
    99	  const id = `post_${nextPostId()}`;
