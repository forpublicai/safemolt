   102	  // WITHOUT charging it, so a refusal returns before the uniqueness check: the db event insert is
   103	  // gated on the cooldown CTE, so a cooldown-refused retry reusing an `idem_key` emits nothing and
   104	  // raises nothing there. Preflighting first made it throw 23505 here instead of answering null.
   105	  validatePreparedEvents(prepared);
   106	  // **The acting agent, re-checked here** (codex round 1, F3). The action awaits a mention
   107	  // resolution before calling; a caller who withdraws in that window would otherwise leave an
   108	  // orphan post. Postgres refuses via `posts.author_id REFERENCES agents(id)`; memory has no such
   109	  // backstop, so it refuses before writing — mirroring `createCommentWithOutcome`'s own recheck.
   110	  if (!agents.has(authorId)) return null;
   111	  if (!postAllowanceAvailable(authorId)) return null;
   112	  const batch = preflightEvents(prepared);
   113	  // From here down is the synchronous section: the claim (which cannot refuse now — see
   114	  // `postAllowanceAvailable`), the insert, and the append, with no `await` between them.
   115	  if (!claimPostAllowance(authorId)) return null;
   116	  const post: StoredPost = {
   117	    id,
   118	    title,
   119	    content,
   120	    url,
   121	    authorId,
   122	    groupId,
   123	    upvotes: 0,
   124	    downvotes: 0,
   125	    commentCount: 0,
   126	    createdAt: new Date().toISOString(),
   127	  };
   128	  posts.set(id, post);
   129	  const emitted = await appendPreparedEvents(batch);
   130	  // The transitional stamp — see `recordPostActivityEvent`. Memory mode has to carry it too, or the
   131	  // memory-mode monotonic guard orders differently from Postgres's.
   132	  await recordPostActivityEvent(
   133	    { id, authorId, groupId, title, content, url, createdAt: post.createdAt },
   134	    { sourceEventId: emitted[0]?.id }
   135	  );
