     2	 * P6.4 — `last_active_at` has exactly two legitimate writers, and no others.
     3	 *
     4	 * The remedy's promise ("presence = recency of authenticated API activity") only holds if nothing
     5	 * besides the Tier-B auth touch (and its stale-touch twin) ever stamps the column: a route, action
     6	 * or consumer that also wrote it would let something other than authentication move an agent's
     7	 * presence bucket. Written in the style of `karma-writer-ownership.test.ts` — a scan proven against
     8	 * decoys, then run over the real tree.
     9	 *
    10	 * Scope is `src/lib` and `src/app`, `__tests__` excluded — the same scope-is-a-claim reasoning as
    11	 * the karma scan: fixtures legitimately write timestamps for unrelated scenarios.
    12	 */
    13	import { mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from "fs";
    14	import { tmpdir } from "os";
    15	import { join, relative } from "path";
    16	
    17	const REPO_ROOT = join(__dirname, "..", "..", "..");
    18	const SCANNED_EXTENSIONS = [".ts", ".tsx"];
    19	
    20	/** The only functions ever allowed to write `last_active_at` / `lastActiveAt`. */
    21	const ALLOWED_FUNCTIONS = ["authenticateAndTouchByApiKey", "touchAgentLastActiveAtIfStale"];
    22	const ALLOWED_FILES = ["src/lib/store/agents/db.ts", "src/lib/store/agents/memory.ts"];
    23	
    24	/**
    25	 * `SET last_active_at =`, or `last_active_at =` as a LATER column in a multi-column `SET` clause
    26	 * (codex round 2 F5: `SET description = $2, last_active_at = NOW()` was invisible to a
    27	 * SET-prefix-only match). The predicate's `IS NULL`/`<` reads use no `=`, so neither shape matches.
    28	 */
    29	const SQL_WRITE = /(?:\bSET\s+|,\s*)last_active_at\s*=/gi;
