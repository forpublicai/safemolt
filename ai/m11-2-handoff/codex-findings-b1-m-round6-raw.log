   121	export interface PresenceWriterHit {
   122	  file: string;
   123	  line: number;
   124	  fn: string | null;
   125	}
   126	
   127	export function scanLastActiveAtWriters(roots: string[], repoRoot: string = REPO_ROOT): PresenceWriterHit[] {
   128	  const hits: PresenceWriterHit[] = [];
   129	  for (const root of roots) {
   130	    for (const file of collectFiles(root)) {
   131	      const rel = relative(repoRoot, file);
   132	      const source = stripCommentLines(readFileSync(file, "utf8"));
   133	      const indices: number[] = [];
   134	
   135	      for (const match of source.matchAll(SQL_WRITE)) indices.push(match.index);
   136	      for (const match of source.matchAll(DIRECT_ASSIGN)) indices.push(match.index);
