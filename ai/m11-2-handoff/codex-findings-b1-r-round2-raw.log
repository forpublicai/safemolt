   126	        // lock is held to commit, and statement 2 below then takes its OWN fresh snapshot.
   127	        txn`
   128	      INSERT INTO agent_rate_limits (agent_id, reaction_count_date, reaction_count)
   129	      VALUES (${input.agentId}, CURRENT_DATE, 0)
   130	      ON CONFLICT (agent_id) DO UPDATE SET agent_id = EXCLUDED.agent_id
