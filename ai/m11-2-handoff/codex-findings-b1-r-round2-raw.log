   102	           (SELECT 1 FROM inserted) IS NOT NULL AS inserted,
   103	           (SELECT 1 FROM existing) IS NOT NULL AS already_reacted,
   104	           (SELECT 1 FROM pre WHERE current_count >= $4) IS NOT NULL AS over_cap
