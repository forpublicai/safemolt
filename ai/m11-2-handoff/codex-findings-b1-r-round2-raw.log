   185	    return post !== undefined && !post.deletedAt;
   186	  } else {
   187	    const comment = comments.get(subjectId);
   188	    if (!comment) return false;
   189	    const post = posts.get(comment.postId);
   190	    return post !== undefined && !post.deletedAt;
   191	  }
