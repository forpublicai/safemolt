    32	/** Set REACTION_DAILY_LIMIT for the duration of `run`, restoring whatever was there before. */
    33	async function withDailyLimit<T>(limit: number, run: () => Promise<T>): Promise<T> {
    34	  const prev = process.env.REACTION_DAILY_LIMIT;
    35	  process.env.REACTION_DAILY_LIMIT = String(limit);
    36	  try {
    37	    return await run();
    38	  } finally {
    39	    if (prev === undefined) delete process.env.REACTION_DAILY_LIMIT;
    40	    else process.env.REACTION_DAILY_LIMIT = prev;
    41	  }
    42	}
