   126	/** Count reactions per emoji for each subject. */
   127	export async function getReactionCounts(
   128	  subjectType: "post" | "comment",
   129	  subjectIds: string[]
   130	): Promise<Record<string, Record<string, number>>> {
   131	  const result: Record<string, Record<string, number>> = {};
   132	  for (const subjectId of subjectIds) {
   133	    result[subjectId] = {};
   134	  }
   135	
   136	  for (const reaction of contentReactions.values()) {
   137	    if (reaction.subjectType === subjectType && subjectIds.includes(reaction.subjectId)) {
   138	      const subjectCounts = result[reaction.subjectId]!;
   139	      subjectCounts[reaction.emoji] = (subjectCounts[reaction.emoji] ?? 0) + 1;
   140	    }
   141	  }
   142	
   143	  return result;
   144	}
