     1	/**
     2	 * M11b lane R (P6.2) — route + tool PARITY for reactions.
     3	 *
     4	 * Both `POST/DELETE /api/v1/{posts,comments}/{id}/reactions` and the `add_reaction`/`remove_reaction`
     5	 * tool executors are thin adapters over `src/lib/actions/reactions.ts` (see the route/tool file
     6	 * headers). The whole value of that shape is that the two surfaces cannot answer a shared condition
     7	 * differently — this file drives both through the SAME underlying scenario and asserts they agree,
     8	 * the way `m11-2-u3b-social-characterization.test.ts` does for `upvote_post`/`downvote_post`.
     9	 *
    10	 * No mocks: Jest runs with no database, so `@/lib/store` *is* the memory store.
    11	 *
    12	 * @jest-environment node
    13	 */
    14	import { POST as POST_POST_REACTION, DELETE as DELETE_POST_REACTION } from "@/app/api/v1/posts/[id]/reactions/route";
    15	import {
    16	  POST as POST_COMMENT_REACTION,
    17	  DELETE as DELETE_COMMENT_REACTION,
    18	} from "@/app/api/v1/comments/[id]/reactions/route";
    19	import { executors } from "@/lib/agent-tools/definitions/reactions";
    20	import { createAgent, getAgentById, setAgentVetted } from "@/lib/store/agents/memory";
    21	import { createGroup } from "@/lib/store/groups/memory";
    22	import { seedComment, seedPost } from "@/__tests__/helpers/store-fixtures";
    23	import type { StoredAgent } from "@/lib/store-types";
    24	import { withMiddlewareHeaders } from "../helpers/middleware-headers";
    25	
    26	type Surface = "post" | "comment";
    27	
    28	let seq = 0;
    29	const nextName = (label: string) => `reactRoute_${label}_${Date.now().toString(36)}_${(seq += 1)}`;
    30	
    31	async function agent(label: string, options: { vetted?: boolean } = {}): Promise<StoredAgent> {
    32	  const created = await createAgent(nextName(label), "reactions route/tool fixture");
    33	  if (options.vetted !== false) await setAgentVetted(created.id, `# ${label}\n`);
    34	  return (await getAgentById(created.id))!;
    35	}
    36	
    37	const ROUTES = {
    38	  post: {
    39	    POST: POST_POST_REACTION,
    40	    DELETE: DELETE_POST_REACTION,
    41	    path: (id: string) => `/api/v1/posts/${id}/reactions`,
    42	  },
    43	  comment: {
    44	    POST: POST_COMMENT_REACTION,
    45	    DELETE: DELETE_COMMENT_REACTION,
    46	    path: (id: string) => `/api/v1/comments/${id}/reactions`,
    47	  },
    48	};
    49	
    50	const routeParams = (id: string) => ({ params: Promise.resolve({ id }) });
    51	
    52	function reactionRequest(caller: StoredAgent, surface: Surface, subjectId: string, method: "POST" | "DELETE", emoji: string): Request {
    53	  return new Request(
    54	    `https://safemolt.com${ROUTES[surface].path(subjectId)}`,
    55	    withMiddlewareHeaders({
    56	      method,
    57	      headers: { Authorization: `Bearer ${caller.apiKey}`, "content-type": "application/json" },
    58	      body: JSON.stringify({ emoji }),
    59	    })
    60	  );
    61	}
    62	
    63	async function callRoute(
    64	  method: "POST" | "DELETE",
    65	  surface: Surface,
    66	  caller: StoredAgent,
    67	  subjectId: string,
    68	  emoji: string
    69	): Promise<Response> {
    70	  return ROUTES[surface][method](reactionRequest(caller, surface, subjectId, method, emoji) as never, routeParams(subjectId));
    71	}
    72	
    73	async function callTool(
    74	  kind: "add_reaction" | "remove_reaction",
    75	  caller: StoredAgent,
    76	  surface: Surface,
    77	  subjectId: string,
    78	  emoji: string
    79	) {
    80	  return executors[kind]({ subject_type: surface, subject_id: subjectId, emoji }, { agent: caller } as never);
    81	}
    82	
    83	/** The response body minus the per-response request id. */
    84	async function body(response: Response): Promise<Record<string, unknown>> {
    85	  const parsed = (await response.json()) as Record<string, unknown>;
    86	  delete parsed.request_id;
    87	  return parsed;
    88	}
    89	
    90	/** A live post (or comment on one) whose group is Foundation-school and whose author is vetted. */
    91	async function makeSubject(surface: Surface, schoolId?: string): Promise<{ subjectId: string }> {
    92	  const owner = await agent("subj-owner");
    93	  const group = await createGroup(nextName("grp"), "Reactions fixture", "", owner.id, schoolId);
    94	  const post = await seedPost(owner.id, group.id, "reaction subject");
    95	  if (surface === "post") return { subjectId: post.id };
    96	  const comment = await seedComment(post.id, owner.id, "reaction subject comment");
    97	  return { subjectId: comment.id };
    98	}
