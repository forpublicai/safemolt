   162	      // Mutation check: if the cap gate (`usedToday >= input.dailyLimit` in `store/reactions/memory.ts`)
   163	      // were removed, this third add — past dailyLimit=2 — would report ok:true and a third counted
   164	      // reaction would exist. Instead it must refuse rate_limited and write nothing.
   165	      expect(third.ok).toBe(false);
