    63	    -- (postgresql.org/docs/current/queries-with.html#QUERIES-WITH-MODIFYING). \`pre\` only reads
    64	    -- and locks; \`rate_updated\` below is the sole writer of \`agent_rate_limits\` here.
    65	    WITH pre AS (
    66	      SELECT CASE WHEN reaction_count_date <> CURRENT_DATE THEN 0 ELSE reaction_count END AS current_count
    67	      FROM agent_rate_limits WHERE agent_id = $1 FOR UPDATE
    68	    ),
    69	    live_post AS (
    70	      ${livePostCte}
    71	    ),
    72	    subject AS (
    73	      ${subjectCte}
    74	    ),
    75	    under_cap AS (
    76	      SELECT 1 FROM pre WHERE current_count < $4
    77	    ),
    78	    -- Read BEFORE the insert, so a cap breach never masks a real pre-existing duplicate: without
    79	    -- this, an agent who already reacted and is separately over cap was misreported as rate
    80	    -- limited (the insert's WHERE requires under_cap, so ON CONFLICT never fires to tell them apart).
    81	    existing AS (
    82	      SELECT 1 FROM content_reactions
    83	      WHERE agent_id = $1 AND subject_type = ${subjectTypeLiteral} AND subject_id = $2 AND emoji = $3
    84	    ),
    85	    inserted AS (
    86	      INSERT INTO content_reactions (agent_id, subject_type, subject_id, emoji, created_at)
