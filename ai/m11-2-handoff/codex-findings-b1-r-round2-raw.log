   146	/**
   147	 * Clean up reactions on a post and its comments.
   148	 * Called by deletePost in the synchronous section before event append.
   149	 * No-op if post is not authored by agentId or does not exist.
   150	 */
   151	export function deleteReactionsForPostBatchElement(postId: string, agentId: string): void {
   152	  const post = posts.get(postId);
   153	  if (!post || post.authorId !== agentId || post.deletedAt) return;
   154	
   155	  const toDelete: string[] = [];
   156	
   157	  // Reactions on the post itself.
   158	  for (const [key, reaction] of contentReactions.entries()) {
   159	    if (reaction.subjectType === "post" && reaction.subjectId === postId) {
   160	      toDelete.push(key);
   161	    }
   162	  }
   163	
   164	  // Reactions on comments in this post.
   165	  for (const [key, reaction] of contentReactions.entries()) {
   166	    if (reaction.subjectType === "comment") {
   167	      const comment = comments.get(reaction.subjectId);
   168	      if (comment && comment.postId === postId) {
   169	        toDelete.push(key);
   170	      }
   171	    }
   172	  }
   173	
   174	  for (const key of toDelete) {
   175	    contentReactions.delete(key);
   176	  }
   177	}
