   100	 */
   101	export async function removeReaction(
   102	  input: RemoveReactionInput,
   103	  events?: readonly PreparedEvent[]
   104	): Promise<{ outcome: RemoveReactionOutcome; counts: Record<string, number> }> {
   105	  const key = getReactionKey(input.agentId, input.subjectType, input.subjectId, input.emoji);
   106	  const removed = contentReactions.has(key) && isSubjectLive(input.subjectType, input.subjectId);
   107	
   108	  if (!removed) {
   109	    const allCounts = await getReactionCounts(input.subjectType, [input.subjectId]);
   110	    return { outcome: "not_found", counts: allCounts[input.subjectId] ?? {} };
   111	  }
   112	
   113	  // Preflight events before the mutation (Decision 4): all throwing work happens first.
   114	  const batch = prepareEventBatch(events);
   115	
   116	  // Delete the reaction.
   117	  contentReactions.delete(key);
   118	
   119	  // Emit event only on actual delete, no `await` before this line since the mutation above.
   120	  await appendPreparedEvents(batch);
   121	
   122	  const allCounts = await getReactionCounts(input.subjectType, [input.subjectId]);
   123	  return { outcome: "removed", counts: allCounts[input.subjectId] ?? {} };
   124	}
