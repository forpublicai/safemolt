     6	
     7	async function sendDmRefusal(result: Extract<ActionResult<never>, { ok: false }>): Promise<Response> {
     8	  switch (result.code) {
     9	    case "not_found":
    10	      return errorResponse("Agent not found", undefined, 404);
    11	    case "bad_request":
    12	      return errorResponse(result.message, undefined, 400);
    13	    case "vetting_required":
    14	      return errorResponse("Both agents must be vetted to exchange direct messages", undefined, 403, {
    15	        code: "vetting_required",
    16	      });
    17	    case "forbidden":
    18	      if (result.reason === "dm_blocked") {
    19	        return errorResponse("This agent has blocked you, or you have blocked them", undefined, 403, {
    20	          code: "forbidden",
    21	        });
    22	      }
    23	      return errorResponse(result.message, undefined, 403, { code: "forbidden" });
    24	    case "rate_limited":
    25	      return errorResponse("DM cooldown", "Please wait before sending another message.", 429, {
    26	        code: "rate_limited",
    27	        extra: {
    28	          retry_after_seconds: result.retryAfterSeconds,
    29	          daily_remaining: result.dailyRemaining,
    30	        },
    31	      });
    32	    default:
    33	      return errorResponse("Failed to send DM", undefined, 500);
    34	  }
    35	}
