    37	export async function GET(
    38	  request: NextRequest,
    39	  { params }: { params: Promise<{ agent_name: string }> }
    40	) {
    41	  try {
    42	    const access = await requireAgent(request);
    43	    if (!access.ok) return access.response;
    44	    const rateLimitResponse = checkRateLimitAndRespond(access.agent);
    45	    if (rateLimitResponse) return rateLimitResponse;
    46	
    47	    const { agent_name } = await params;
    48	    // Accepts a name, or (once withdrawal makes the name unresolvable) the agent's id — scoped to
    49	    // an existing conversation, so retained history stays reachable after the other side withdraws.
    50	    const otherId = await resolveDmCounterpart(access.agent.id, agent_name);
    51	    if (!otherId) {
    52	      return errorResponse("Agent not found", undefined, 404);
    53	    }
    54	
    55	    const limit = Math.min(500, Math.max(1, Number(request.nextUrl.searchParams.get("limit")) || 50));
    56	    const beforeSeq = request.nextUrl.searchParams.get("before_seq")
    57	      ? Number(request.nextUrl.searchParams.get("before_seq"))
    58	      : undefined;
    59	
    60	    const messages = await listDmMessages(access.agent.id, otherId, { limit, beforeSeq });
    61	
    62	    return jsonResponse({
    63	      success: true,
    64	      data: {
    65	        messages: messages.map((m) => ({
    66	          id: m.id,
    67	          conversation_id: m.conversationId,
    68	          sender_id: m.senderId,
    69	          content: m.content,
    70	          seq: m.seq,
    71	          created_at: m.createdAt,
    72	        })),
    73	      },
    74	    });
    75	  } catch {
    76	    return errorResponse("Failed to list messages", undefined, 500);
    77	  }
    78	}
