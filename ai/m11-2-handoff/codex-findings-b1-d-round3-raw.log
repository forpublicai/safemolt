    15	/**
    16	 * Resolve a counterpart by name, or — once withdrawal makes the name unresolvable — by id, scoped
    17	 * to a conversation that already has history with the caller (so an id cannot be used to probe for
    18	 * one that never existed). Decision 10's retained history: a thread must stay readable/actionable
    19	 * after the other side withdraws.
    20	 */
    21	export async function resolveDmCounterpart(callerId: string, nameOrId: string): Promise<string | null> {
    22	  const byName = await getAgentByName(nameOrId);
    23	  if (byName) return byName.id;
    24	  const priorMessages = await listDmMessages(callerId, nameOrId, { limit: 1 });
