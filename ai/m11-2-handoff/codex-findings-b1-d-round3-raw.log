   252	  // Compute unread for each and determine other agent.
   253	  const withUnread = myConvs.map((c) => {
   254	    const amLow = c.agentLow === agentId;
   255	    const otherId = amLow ? c.agentHigh : c.agentLow;
   256	    const myReadCursor = amLow ? c.lowLastReadSeq : c.highLastReadSeq;
   257	    const unread = Math.max(0, c.lastMessageSeq - myReadCursor);
   258	    return { conv: c, otherId, unread };
   259	  });
   260	
   261	  // Sort by last_message_at DESC, then created_at DESC (nulls last); `unreadFirst` (codex round 2,
   262	  // F3) puts unread threads ahead of that, matching the db statement's ORDER BY term.
   263	  withUnread.sort((a, b) => {
   264	    if (options.unreadFirst) {
   265	      const unreadDiff = Number(b.unread > 0) - Number(a.unread > 0);
   266	      if (unreadDiff !== 0) return unreadDiff;
   267	    }
   268	    if (a.conv.lastMessageAt === null && b.conv.lastMessageAt === null) {
   269	      return new Date(b.conv.createdAt).getTime() - new Date(a.conv.createdAt).getTime();
   270	    }
   271	    if (a.conv.lastMessageAt === null) return 1;
   272	    if (b.conv.lastMessageAt === null) return -1;
   273	    const timeDiff =
   274	      new Date(b.conv.lastMessageAt).getTime() - new Date(a.conv.lastMessageAt).getTime();
   275	    if (timeDiff !== 0) return timeDiff;
   276	    return new Date(b.conv.createdAt).getTime() - new Date(a.conv.createdAt).getTime();
   277	  });
   278	
   279	  // Paginate.
   280	  const page = withUnread.slice(offset, offset + limit);
   281	
   282	  return page.map(({ conv, otherId, unread }) => {
   283	    const otherAgent = agents.get(otherId);
   284	    return {
   285	      id: conv.id,
   286	      other: { id: otherId, name: otherAgent?.name ?? null, deleted: !otherAgent },
   287	      lastMessageAt: conv.lastMessageAt,
   288	      unreadCount: unread,
   289	    };
   290	  });
   291	}
   292	
   293	/**
   294	 * List messages in a thread. Newest seq first (seq DESC). Scoped structurally to the canonical pair.
   295	 */
   296	export async function listDmMessages(
   297	  agentId: string,
   298	  otherId: string,
   299	  options: { limit?: number; beforeSeq?: number } = {}
   300	): Promise<StoredDmMessage[]> {
   301	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   302	  const limit = options.limit ?? 50;
   303	  const beforeSeq = options.beforeSeq ?? null;
   304	
   305	  // Find the conversation for this pair.
   306	  const conv = Array.from(dmConversations.values()).find(
   307	    (c) => c.agentLow === agentLow && c.agentHigh === agentHigh
   308	  );
   309	  if (!conv) return [];
   310	
   311	  // Filter messages to this conversation, apply beforeSeq filter, sort by seq DESC, paginate.
   312	  const msgs = Array.from(dmMessages.values()).filter(
   313	    (m) => m.conversationId === conv.id && (beforeSeq === null || m.seq < beforeSeq)
   314	  );
   315	
   316	  msgs.sort((a, b) => b.seq - a.seq);
   317	  return msgs.slice(0, limit);
   318	}
   319	
   320	/**
   321	 * Re-check for the wakeup router: has EITHER side of this pair blocked the other?
   322	 */
   323	export async function isDmBlocked(agentAId: string, agentBId: string): Promise<boolean> {
   324	  const { agentLow, agentHigh } = canonicalizePair(agentAId, agentBId);
   325	  const conv = Array.from(dmConversations.values()).find(
   326	    (c) => c.agentLow === agentLow && c.agentHigh === agentHigh
   327	  );
   328	  return Boolean(conv?.lowBlockedHigh || conv?.highBlockedLow);
   329	}
