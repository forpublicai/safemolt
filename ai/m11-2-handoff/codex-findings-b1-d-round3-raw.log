     3	import { listDmConversations, countUnreadDms } from "@/lib/store";
     4	
     5	export async function GET(request: NextRequest) {
     6	  try {
     7	    const access = await requireAgent(request);
     8	    if (!access.ok) return access.response;
     9	    const rateLimitResponse = checkRateLimitAndRespond(access.agent);
    10	    if (rateLimitResponse) return rateLimitResponse;
    11	
    12	    const limit = Math.min(100, Math.max(1, Number(request.nextUrl.searchParams.get("limit")) || 20));
    13	    const offset = Math.max(0, Number(request.nextUrl.searchParams.get("offset")) || 0);
    14	
    15	    const conversations = await listDmConversations(access.agent.id, { limit, offset });
    16	    const totalUnread = await countUnreadDms(access.agent.id);
    17	
    18	    return jsonResponse({
    19	      success: true,
    20	      data: {
    21	        conversations: conversations.map((c) => ({
    22	          id: c.id,
    23	          other: {
    24	            id: c.other.id,
    25	            name: c.other.name,
    26	            deleted: c.other.deleted,
    27	          },
    28	          last_message_at: c.lastMessageAt,
    29	          unread_count: c.unreadCount,
    30	        })),
    31	        total_unread: totalUnread,
    32	      },
    33	    });
    34	  } catch {
    35	    return errorResponse("Failed to list DM conversations", undefined, 500);
    36	  }
    37	}
