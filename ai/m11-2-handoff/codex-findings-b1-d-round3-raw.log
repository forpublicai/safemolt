   391	/** Total unread across every conversation the agent is in. */
   392	export async function countUnreadDms(agentId: string): Promise<number> {
   393	  const rows = await sql!`
   394	    SELECT COALESCE(SUM(
   395	      CASE WHEN agent_low = ${agentId} THEN last_message_seq - low_last_read_seq
   396	           ELSE last_message_seq - high_last_read_seq END
   397	    ), 0)::int AS unread
   398	    FROM dm_conversations
   399	    WHERE agent_low = ${agentId} OR agent_high = ${agentId}
   400	  `;
