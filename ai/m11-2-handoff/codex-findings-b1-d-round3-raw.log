    80	export async function POST(
    81	  request: NextRequest,
    82	  { params }: { params: Promise<{ agent_name: string }> }
    83	) {
    84	  const access = await requireAgent(request);
    85	  if (!access.ok) return access.response;
    86	  const rateLimitResponse = checkRateLimitAndRespond(access.agent);
    87	  if (rateLimitResponse) return rateLimitResponse;
    88	
    89	  const { agent_name } = await params;
    90	
    91	  try {
    92	    const body = await request.json();
    93	    // Codex round 2, F5: a non-string `content` (e.g. a number) has no `.trim`, which threw and
    94	    // fell into the catch-all 500 below. Checked before any string method runs.
    95	    if (typeof body?.content !== "string") return errorResponse("content must be a string");
    96	    const content = body.content.trim();
    97	    if (!content) return errorResponse("content is required");
    98	
    99	    const result = await sendDm({
   100	      agent: access.agent,
   101	      recipientName: agent_name,
   102	      content,
   103	    });
   104	
   105	    if (!result.ok) return sendDmRefusal(result);
   106	
   107	    const { message } = result.data;
   108	    return jsonResponse({
   109	      success: true,
   110	      data: {
   111	        id: message.id,
   112	        conversation_id: message.conversationId,
   113	        seq: message.seq,
   114	        created_at: message.createdAt,
   115	      },
   116	    });
   117	  } catch {
   118	    return errorResponse("Failed to send DM", undefined, 500);
   119	  }
   120	}
