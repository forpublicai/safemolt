   323	 * hand-rolled, so the reply/playground narrow surfaces read exactly as clearly as `tickAgent`'s own
   324	 * domain stage always has), run a single-terminal-call turn fenced by lease renewal, classify, and
   325	 * complete the wakeup. Every early return completes the wakeup exactly once, on the way out.
   326	 */
   327	async function runNarrowWakeup(
   328	  agent: StoredAgent,
   329	  wakeup: StoredWakeup,
   330	  claimToken: string,
   331	  focus: SensesFocus,
   332	  config: NarrowWakeupConfig
   333	): Promise<WakeupOutcome> {
   334	  let context;
   335	  try {
   336	    context = await buildAgentContext(agent.id, { focus });
   337	  } catch (e) {
   338	    await recordError(agent.id, e instanceof Error ? e.message : "context build failed").catch(() => {});
   339	    await completeWakeup(wakeup.id, claimToken, "error");
   340	    return "error";
   341	  }
   342	
   343	  let callLLM;
   344	  try {
   345	    callLLM = await resolveLoopCallLLM(agent);
   346	  } catch (e) {
   347	    await recordError(agent.id, e instanceof Error ? e.message : "no inference provider").catch(() => {});
   348	    await completeWakeup(wakeup.id, claimToken, "error");
   349	    return "error";
   350	  }
   351	
   352	  const recentActions = await listRecentLoopActions(agent.id, RECENT_ACTION_WINDOW);
   353	  const messages = await buildDecisionPrompt(agent, context, recentActions, {
   354	    kind: "domain",
   355	    domain: config.domain,
   356	  });
   357	
   358	  // The same bundle the idle path hands to `tickAgent` — one builder, so no reason this runner
   359	  // drives can be fenced differently from another (u6 D fix round 1, finding 1).
   360	  const fence = createPulseFence(wakeup, claimToken);
   361	
   362	  let turn;
   363	  try {
   364	    turn = await runAgenticTurn({
   365	      agent,
   366	      messages,
   367	      tools: toolsNamed(config.toolNames),
   368	      callLLM,
   369	      maxToolCalls: config.maxToolCalls,
   370	      requireFinalText: false,
   371	      terminalToolNames: config.terminalToolNames,
   372	      executionGuard: fence.executionGuard,
   373	      // The fence: renew the lease, token-checked, with the `agent_loop_state.enabled` EXISTS
   374	      // predicate baked into `renewWakeupLease` itself (P3.2 semantics). A `false` return here ends
   375	      // the turn without invoking the tool — see `beforeTerminalTool`'s own doc comment in
   376	      // `agent-runtime/index.ts` for exactly what that means for `turn.terminalToolExecuted` below.
   377	      beforeTerminalTool: fence.beforeTerminalTool,
   378	    });
   379	  } catch (e) {
   380	    await recordError(agent.id, e instanceof Error ? e.message : "runner turn failed").catch(() => {});
