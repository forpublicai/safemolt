   153	/**
   154	 * Mark messages read. Find the conversation (do not create), then set the reader's cursor to head.
   155	 */
   156	export async function markDmRead(
   157	  readerId: string,
   158	  otherId: string,
   159	  executionGuard?: ExecutionGuard
   160	): Promise<boolean> {
   161	  const { agentLow, agentHigh, aIsLow } = canonicalizePair(readerId, otherId);
   162	  const conv = Array.from(dmConversations.values()).find(
   163	    (c) => c.agentLow === agentLow && c.agentHigh === agentHigh
   164	  );
   165	  if (!conv) return false;
   166	  if (!executionGuardPasses(executionGuard)) return false;
   167	
   168	  const field = readCursorField(aIsLow);
   169	  conv[field] = conv.lastMessageSeq;
   170	  return true;
   171	}
