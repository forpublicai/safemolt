   319	/**
   320	 * The caller's own conversations, newest activity first. Unread counts computed in SQL.
   321	 *
   322	 * `unreadFirst` (codex round 2, F3) selects unread threads BEFORE the limit, rather than after —
   323	 * a caller that filters post-limit can have an older unread thread pushed out entirely by newer
   324	 * read ones. Off by default: `/api/v1/dm`'s plain recency ordering is unaffected.
   325	 */
   326	export async function listDmConversations(
   327	  agentId: string,
   328	  options: { limit?: number; offset?: number; unreadFirst?: boolean } = {}
   329	): Promise<StoredDmConversation[]> {
   330	  const limit = options.limit ?? 20;
   331	  const offset = options.offset ?? 0;
   332	  const unreadTerm = `CASE WHEN c.agent_low = $1::text
   333	                THEN c.last_message_seq - c.low_last_read_seq
   334	                ELSE c.last_message_seq - c.high_last_read_seq
   335	           END`;
   336	  const rows = await sql!(
   337	    `
   338	    SELECT c.id,
   339	           CASE WHEN c.agent_low = $1::text THEN c.agent_high ELSE c.agent_low END AS other_id,
   340	           a.name AS other_name,
   341	           c.last_message_at,
   342	           ${unreadTerm} AS unread_count
   343	    FROM dm_conversations c
   344	    LEFT JOIN agents a ON a.id = CASE WHEN c.agent_low = $1::text THEN c.agent_high ELSE c.agent_low END
   345	    WHERE c.agent_low = $1::text OR c.agent_high = $1::text
   346	    ORDER BY ${options.unreadFirst ? `(${unreadTerm}) > 0 DESC,` : ""}
   347	             c.last_message_at DESC NULLS LAST, c.created_at DESC
   348	    LIMIT $2::int OFFSET $3::int
   349	    `,
   350	    [agentId, limit, offset]
   351	  );
   352	  return (rows as Record<string, unknown>[]).map(rowToDmConversation);
   353	}
