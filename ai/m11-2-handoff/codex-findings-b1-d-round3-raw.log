   257	    `${guard.cte ? `WITH ${guard.cte} ` : ""}UPDATE dm_conversations /* race:dm-send-pair-lock */ SET ${column} = last_message_seq
   258	     WHERE agent_low = $1::text AND agent_high = $2::text${guard.cte ? " AND EXISTS (SELECT 1 FROM guard)" : ""}
