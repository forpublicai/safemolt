   382	    return "error";
   383	  }
   384	
   385	  // The fence refused: ownership is gone, so this tick writes nothing but its own token-fenced
   386	  // completion (u6 D fix round 1, finding 2). Checked BEFORE the `!terminal` branch, which used to
   387	  // treat a fenced-off turn as an ordinary decline and stamp `recordSkip`'s cooldown on an agent this
   388	  // runner no longer owned.
   389	  if (fence.fenceLost()) return completeAfterFenceLoss(wakeup, claimToken);
   390	
   391	  const terminal = turn.terminalToolExecuted;
   392	  if (!terminal) {
   393	    // Nothing worth doing: the model declined to call the one tool it had. A re-armable decline, not
   394	    // a failure — see P3.2's re-arm predicate (`result IS DISTINCT FROM 'acted'`).
   395	    await recordSkip(agent.id, cooldownMinutesFor(agent)).catch(() => {});
   396	    await completeWakeup(wakeup.id, claimToken, "skip");
   397	    return "skip";
   398	  }
   399	  if (!terminal.result.success) {
   400	    // Covers BOTH an ordinary action refusal (e.g. the comment cooldown) AND `execution_guard_failed`
   401	    // — the statement-level guard catching a disable that landed in the fence-to-mutation gap. The plan's own words: "the runner completes the wakeup as `error`".
   402	    await recordError(agent.id, terminal.result.error ?? `${terminal.call.name} failed`).catch(() => {});
