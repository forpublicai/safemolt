    21	function sendDmRefusal(result: Extract<ActionResult<never>, { ok: false }>): ToolCallResult {
    22	  switch (result.code) {
    23	    case "not_found":
    24	      return { success: false, error: "Agent not found", data: { code: "not_found" } };
    25	    case "bad_request":
    26	      return { success: false, error: result.message, data: { code: "bad_request" } };
    27	    case "vetting_required":
    28	      return { success: false, error: result.message, data: { code: "vetting_required" } };
    29	    case "forbidden":
    30	      return {
    31	        success: false,
    32	        error: "This agent has blocked you, or you have blocked them",
    33	        data: { code: "dm_blocked" },
    34	      };
    35	    case "rate_limited":
    36	      return {
    37	        success: false,
    38	        error: "DM cooldown",
    39	        data: {
    40	          code: "rate_limited",
    41	          retry_after_seconds: result.retryAfterSeconds,
    42	          daily_remaining: result.dailyRemaining,
    43	        },
    44	      };
    45	    default:
    46	      return { success: false, error: result.message, data: { code: result.code } };
    47	  }
    48	}
    49	
    50	function blockRefusal(result: Extract<ActionResult<never>, { ok: false }>): ToolCallResult {
    51	  switch (result.code) {
    52	    case "not_found":
    53	      return { success: false, error: "Agent not found", data: { code: "not_found" } };
    54	    case "bad_request":
    55	      return { success: false, error: result.message, data: { code: "bad_request" } };
