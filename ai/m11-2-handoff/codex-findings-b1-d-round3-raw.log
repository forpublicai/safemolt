   265	/**
   266	 * Conditional UPDATE of the pair row, gated on the flag ACTUALLY changing (duplicate-suppressing
   267	 * writer, per CLAUDE.md). Blocking may create the row (blocks can precede any message); unblocking
   268	 * never does — an absent pair was never blocked, so there is nothing to change or emit.
   269	 */
   270	export async function setDmBlock(
   271	  blockerId: string,
   272	  otherId: string,
   273	  blocked: boolean,
   274	  events?: readonly PreparedEvent[],
   275	  executionGuard?: ExecutionGuard
   276	): Promise<boolean> {
   277	  const { agentLow, agentHigh, aIsLow } = canonicalizePair(blockerId, otherId);
   278	  const flagColumn = blockFlagColumn(aIsLow);
   279	  const conversationId = `dmc_${Date.now()}_${Math.random().toString(36).slice(2, 9)}`;
   280	  const createdAt = new Date().toISOString();
   281	
   282	  const params: unknown[] = blocked ? [conversationId, agentLow, agentHigh, createdAt] : [agentLow, agentHigh];
   283	  const emitted = emitEventCtes(events, "changed", {
   284	    firstParamIndex: params.length + 1,
   285	    overrides: events?.length
   286	      ? [
   287	          {
   288	            rowSource: "changed",
   289	            columnSql: { subject_id: sqlColumn("changed.id", "text") },
   290	            payloadMergeSql: sqlPayloadObject({ conversation_id: sqlColumn("changed.id", "text") }),
   291	          },
   292	        ]
   293	      : [],
   294	  });
   295	  const guard = buildExecutionGuardCte(executionGuard, params.length + 1 + emitted.params.length);
   296	  // Blocked=true must gate the INSERT branch too, not only the ON CONFLICT branch — `SELECT ...
   297	  // FROM guard` makes the whole INSERT source zero rows when the guard fails, instead of a WHERE
   298	  // clause that only reaches the conflict path.
   299	  const changedSql = blocked
   300	    ? `
   301	      INSERT INTO dm_conversations /* race:dm-send-pair-lock */ (id, agent_low, agent_high, created_at, ${flagColumn})
   302	      SELECT $1::text, $2::text, $3::text, $4::timestamptz, true${guard.cte ? " FROM guard" : ""}
   303	      ON CONFLICT (agent_low, agent_high) DO UPDATE SET ${flagColumn} = true
   304	      WHERE NOT dm_conversations.${flagColumn}${guard.cte ? " AND EXISTS (SELECT 1 FROM guard)" : ""}
   305	      RETURNING id`
   306	    : `
   307	      UPDATE dm_conversations /* race:dm-send-pair-lock */ SET ${flagColumn} = false
   308	      WHERE agent_low = $1::text AND agent_high = $2::text AND ${flagColumn}${guard.cte ? " AND EXISTS (SELECT 1 FROM guard)" : ""}
   309	      RETURNING id`;
   310	
   311	  const rows = await sql!(
   312	    `WITH ${guard.cte ? `${guard.cte},\n     ` : ""}changed AS (${changedSql})${emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : ""}
   313	     SELECT (SELECT count(*) FROM changed)::int AS changed_count`,
   314	    [...params, ...emitted.params, ...guard.params]
   315	  );
   316	  return Number((rows[0] as { changed_count?: number } | undefined)?.changed_count ?? 0) > 0;
   317	}
