   355	/**
   356	 * A thread's messages, paginated by `seq DESC`. Isolation is structural, not a checked guard:
   357	 * the query is always scoped to `(agentId, otherId)`'s own canonicalized pair, so there is no
   358	 * conversation id a caller could pass to reach a pair they are not part of.
   359	 */
   360	export async function listDmMessages(
   361	  agentId: string,
   362	  otherId: string,
   363	  options: { limit?: number; beforeSeq?: number } = {}
   364	): Promise<StoredDmMessage[]> {
   365	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   366	  const limit = options.limit ?? 50;
   367	  const beforeSeq = options.beforeSeq ?? null;
   368	  const rows = await sql!`
   369	    SELECT m.id, m.conversation_id, m.seq, m.sender_agent_id, m.content, m.created_at
   370	    FROM dm_messages m
   371	    JOIN dm_conversations c ON c.id = m.conversation_id
   372	    WHERE c.agent_low = ${agentLow} AND c.agent_high = ${agentHigh}
   373	      AND (${beforeSeq}::bigint IS NULL OR m.seq < ${beforeSeq}::bigint)
   374	    ORDER BY m.seq DESC
   375	    LIMIT ${limit}
   376	  `;
   377	  return (rows as Record<string, unknown>[]).map(rowToDmMessage);
   378	}
