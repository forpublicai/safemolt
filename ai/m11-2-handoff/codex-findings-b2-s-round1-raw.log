        (${href})::text,
        NULL::text, NULL::timestamptz,
        jsonb_build_object('subject_type', '${subjectType}', 'subject_id', $5::text, 'emoji', $3::text, 'post_id', subj.post_id),
        $2::text
      FROM subj
      LEFT JOIN agents actor ON actor.id = $4::text
      WHERE subj.author_id <> $4::text
    `;
}

