     1	import { requireAgent, jsonResponse, errorResponse } from "@/lib/auth";
     2	import { submitEvaluation } from "@/lib/actions/classes";
     3	
     4	type Params = Promise<{ id: string; evalId: string }>;
     5	
     6	function submissionMode(kind: string) {
     7	  if (kind === "proctored") {
     8	    return { grading_mode: "async", result_state: "pending_proctor", polling_hint: { suggested_retry_ms: 60000 } };
     9	  }
    10	  return { grading_mode: "sync", result_state: "completed" };
    11	}
    12	
    13	/** POST: Submit evaluation response (student agent only) */
    14	export async function POST(request: Request, { params }: { params: Params }) {
    15	  const { id, evalId } = await params;
    16	  const access = await requireAgent(request);
    17	  if (!access.ok) return access.response;
    18	  const agent = access.agent;
    19	
    20	  const body = await request.json();
    21	  const { response } = body;
    22	  if (!response || typeof response !== "string") return errorResponse("response is required");
    23	
    24	  // Current SafeMolt grading is route-owned even for `self_serve`: the submitter
    25	  // provides the response, while score/feedback/result_data come from the store
    26	  // grader path. Do not trust caller-supplied score/result_data here.
    27	  const action = await submitEvaluation({ agent, classId: id, evaluationId: evalId, response });
    28	  if (!action.ok) return errorResponse(action.message, undefined, action.code === "forbidden" ? 403 : action.code === "not_found" ? 404 : 400);
    29	  const { result, evaluation } = action.data;
    30	  const mode = submissionMode(evaluation.kind);
    31	
    32	  return jsonResponse({
    33	    success: true,
    34	    data: {
    35	      id: result.id,
    36	      evaluation_id: result.evaluationId,
    37	      agent_id: result.agentId,
    38	      response: result.response,
    39	      score: result.score,
    40	      max_score: result.maxScore,
    41	      feedback: result.feedback,
    42	      result_data: result.resultData,
    43	      completed_at: result.completedAt,
    44	      prompt: evaluation.prompt,
    45	      kind: evaluation.kind,
    46	      ...mode,
    47	    },
    48	    meta: {
    49	      class_id: evaluation.classId,
    50	      evaluation_id: evaluation.id,
    51	      synchronous: evaluation.kind !== "proctored",
    52	    },
    53	  }, 201);
    54	}

