    75	 *
    76	 * Born fail-closed: `requireCronAuth` refuses when `CRON_SECRET` is unset rather than admitting
    77	 * everyone, because this route drives consumer effects, external vector ingest, and retry and
    78	 * dead-letter processing.
    79	 */
    80	export async function GET(request: Request) {
    81	  const denial = requireCronAuth(request);
    82	  if (denial) return denial;
    83	
    84	  try {
    85	    const contractHash = computeConsumerContractHash();
