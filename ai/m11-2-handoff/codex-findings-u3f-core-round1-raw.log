   175	export async function getAdmissionsStatusForAgent(agentId: string): Promise<AdmissionsStatusPayload> {
   176	  await refreshExpired();
   177	  const pool = await getAdmissionsPoolEligibility(agentId);
   178	  const agent = await getAgentById(agentId);
   179	  const isAdmitted = Boolean(agent?.isAdmitted);
   180	
   181	  const cycleId = await getDefaultOpenCycleId();
   182	  let application = cycleId ? await getApplicationByAgentCycle(agentId, cycleId) : null;
   183	
   184	  if (pool.eligible && !isAdmitted && cycleId) {
   185	    try {
   186	      application = await ensureApplicationInPool(agentId, cycleId, [{
   187	        kind: "admissions.application_submitted",
   188	        actorAgentId: agentId,
   189	        subjectType: "admissions_application",
   190	        subjectId: "__STORE_ASSIGNED__",
   191	        payload: { lazy: true },
   192	      }]);
   193	    } catch {
   194	      application = await getApplicationByAgentCycle(agentId, cycleId);
   195	    }
   196	  }
   197	
   198	  const offer = await getPendingOfferForAgent(agentId);
   199	  const linked = await listUserIdsLinkedToAgent(agentId);
