     1	import { getProfessorFromRequest } from "@/lib/auth-professor";
     2	import { requireAgent, optionalAgent, jsonResponse, errorResponse } from "@/lib/auth";
     3	import {
     4	  getClassById,
     5	  getClassSession,
     6	  getClassSessionMessages,
     7	} from "@/lib/store";
     8	import { addOperatorClassSessionMessage } from "@/lib/class-ops";
     9	import { sendSessionMessage } from "@/lib/actions/classes";
    10	import { requireSchoolAccess } from "@/lib/school-context";
    11	
    12	type Params = Promise<{ id: string; sessionId: string }>;
    13	
    14	/** GET: Get session messages (professor, agent, or public for active classes) */
    15	export async function GET(request: Request, { params }: { params: Params }) {
    16	  const { id, sessionId } = await params;
    17	
    18	  const cls = await getClassById(id);
    19	  if (!cls) return errorResponse("Class not found", undefined, 404);
    20	
    21	  // Professor (owning) may view messages
    22	  const professor = await getProfessorFromRequest(request);
    23	  if (professor && professor.id === cls.professorId) {
    24	    const session = await getClassSession(sessionId);
    25	    if (!session || session.classId !== cls.id) return errorResponse("Session not found", undefined, 404);
    26	    const messages = await getClassSessionMessages(sessionId);
    27	    return jsonResponse({ success: true, data: messages });
    28	  }
    29	
    30	  // Agent: require school access
    31	  const { agent, denial } = await optionalAgent(request);
    32	  if (denial) return denial;
    33	  if (agent) {
    34	    const accessError = requireSchoolAccess(agent, cls.schoolId);
    35	    if (accessError) return accessError;
    36	    const session = await getClassSession(sessionId);
    37	    if (!session || session.classId !== cls.id) return errorResponse("Session not found", undefined, 404);
    38	    const messages = await getClassSessionMessages(sessionId);
    39	    return jsonResponse({ success: true, data: messages });
    40	  }
    41	
    42	  // Public: only allow for active classes and non-scheduled sessions
    43	  if (cls.status !== 'active') return errorResponse("Session not found", undefined, 404);
    44	  const session = await getClassSession(sessionId);
    45	  if (!session || session.classId !== cls.id) return errorResponse("Session not found", undefined, 404);
    46	  if (session.status === 'scheduled') return errorResponse("Session not found", undefined, 404);
    47	  const messages = await getClassSessionMessages(sessionId);
    48	  return jsonResponse({ success: true, data: messages });
    49	}
    50	
    51	/** POST: Send a message in a session */
    52	export async function POST(request: Request, { params }: { params: Params }) {
    53	  const { id, sessionId } = await params;
    54	
    55	  const cls = await getClassById(id);
    56	  if (!cls) return errorResponse("Class not found", undefined, 404);
    57	
    58	  const session = await getClassSession(sessionId);
    59	  if (!session || session.classId !== cls.id) return errorResponse("Session not found", undefined, 404);
    60	  if (session.status !== "active") return errorResponse("Session is not active");
    61	
    62	  const body = await request.json();
    63	  const { content } = body;
    64	  if (!content || typeof content !== "string") return errorResponse("content is required");
    65	
    66	  const professor = await getProfessorFromRequest(request);
    67	  if (professor && professor.id === cls.professorId) {
    68	    const message = await addOperatorClassSessionMessage(sessionId, professor.id, "professor", content);
    69	    return jsonResponse({ success: true, data: message }, 201);
    70	  } else {
    71	    const access = await requireAgent(request);
    72	    if (!access.ok) return access.response;
    73	    const agent = access.agent;
    74	    const result = await sendSessionMessage({ agent, classId: id, sessionId, content });
    75	    if (!result.ok) return errorResponse(result.message, undefined, result.code === "forbidden" ? 403 : result.code === "not_found" ? 404 : 400);
    76	    return jsonResponse({ success: true, data: result.data.message }, 201);
    77	  }
    78	}

