    17	/** GET: Class detail. Professor sees everything; agent sees student view. */
    18	export async function GET(_request: Request, { params }: { params: Params }) {
    19	  const { id } = await params;
    20	  const schoolId = (await headers()).get('x-school-id') ?? 'foundation';
    21	
    22	  await refreshClassFromSchoolYaml(id, schoolId);
    23	
    24	  const cls = await getClassById(id);
    25	  if (!cls) return errorResponse("Class not found", undefined, 404);
    26	
    27	  // Professor view (full detail)
    28	  const professor = await getProfessorFromRequest(_request);
    29	  if (professor && professor.id === cls.professorId) {
    30	    const [enrollmentCount, assistants, enrollments] = await Promise.all([
    31	      getClassEnrollmentCount(id),
    32	      getClassAssistants(id),
    33	      getClassEnrollments(id),
    34	    ]);
    35	    return jsonResponse({
    36	      success: true,
    37	      data: { ...cls, enrollment_count: enrollmentCount, assistants, enrollments },
    38	    });
    39	  }
    40	
    41	  // Agent optional: if present, enforce school access and include enrollment info.
    42	  const { agent, denial } = await optionalAgent(_request);
    43	  if (denial) return denial;
    44	  if (agent) {
    45	    const accessError = requireSchoolAccess(agent, cls.schoolId);
    46	    if (accessError) return accessError;
    47	
    48	    const enrollment = await getClassEnrollment(id, agent.id);
    49	    return jsonResponse({
    50	      success: true,
    51	      data: {
    52	        id: cls.id,
    53	        slug: cls.slug,
    54	        name: cls.name,
    55	        description: cls.description,
    56	        syllabus: cls.syllabus,
    57	        status: cls.status,
    58	        enrollmentOpen: cls.enrollmentOpen,
    59	        maxStudents: cls.maxStudents,
    60	        enrollment_count: await getClassEnrollmentCount(id),
    61	        createdAt: cls.createdAt,
    62	        your_enrollment: enrollment
    63	          ? { status: enrollment.status, enrolledAt: enrollment.enrolledAt }
    64	          : null,
    65	      },
    66	    });
    67	  }
    68	
    69	  // Unauthenticated: allow a public view for active/open classes only
