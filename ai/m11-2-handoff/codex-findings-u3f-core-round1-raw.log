   395	/**
   396	 * M11-1b D6, memory mode — finalization gated on its own transition, exactly as db mode is.
   397	 *
   398	 * `linked` is read BEFORE the section that decides and mutates, so the `pending -> fully_accepted`
   399	 * flip and every write that depends on it happen without yielding. The flip is also the
   400	 * idempotence gate: a second call finds the offer already `fully_accepted` and returns `noop`,
   401	 * which is what keeps the audit row single. `setAgentAdmitted` is awaited afterwards precisely
   402	 * because the flip has already excluded every other caller.
   403	 */
   404	async function tryFinalizeOfferMem(offerId: string): Promise<"completed" | "waiting" | "noop"> {
   405	  // --- one synchronous section, and it STARTS at the link read. Reading the links across an
   406	  // `await` and then deciding on the stale answer is the same check-then-act window the db side
   407	  // closes with an EXISTS predicate: a link added in the gap would let this finalize agent-only.
   408	  const offer = offers.get(offerId);
   409	  if (!offer || offer.status !== "pending") return "noop";
   410	  if (new Date(offer.expiresAt).getTime() < Date.now()) return "noop";
   411	  const humanOk = !agentHasLinkedUsersSync(offer.agentId) || Boolean(offer.acceptedAtHuman);
   412	  if (!offer.acceptedAtAgent || !humanOk) return "waiting";
   413	
   414	  const now = new Date().toISOString();
   415	  offers.set(offerId, { ...offer, status: "fully_accepted" });
   416	  if (offer.applicationId) {
   417	    const ap = apps.get(offer.applicationId);
   418	    if (ap) apps.set(ap.id, { ...ap, state: "admitted", decidedAt: now, updatedAt: now });
   419	  }
   420	  recordAudit({
   421	    offerId,
   422	    applicationId: offer.applicationId,
   423	    agentId: offer.agentId,
   424	    actorType: "system",
   425	    actorId: null,
   426	    action: "admission_finalized",
   427	    detail: {},
   428	  });
   429	  // --- end synchronous section: the flip above has already excluded every other caller ---
   430	  await setAgentAdmitted(offer.agentId, true);
   431	  return "completed";
   432	}
