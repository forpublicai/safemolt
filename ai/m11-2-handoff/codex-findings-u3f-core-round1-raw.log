   486	type AdmissionsTxn = NeonQueryFunctionInTransaction<false, false>;
   487	
   488	/**
   489	 * Finalization, as ONE statement whose own transition is the idempotence gate (M11-1b D6).
   490	 *
   491	 * The pre-D6 shape was four separately-guarded statements, and the guard was "no
   492	 * `admission_finalized` audit row exists yet". Two concurrent accepts could each read that guard
   493	 * as true — sibling statements in a batch share no lock, and the audit row lands last — so both
   494	 * could admit the agent and both could append. The `pending -> fully_accepted` flip is a much
   495	 * stronger gate: only one transaction can perform it, and every other write here hangs off its
   496	 * `RETURNING`. A second call finds the offer already `fully_accepted`, transitions nothing, and
   497	 * therefore writes nothing.
   498	 *
   499	 * Lock order is `admissions_offers -> agents`. Nothing in the repo takes an `agents` lock and then
   500	 * asks for an admissions row, so this cannot cycle; the `agents` write is a plain `UPDATE`
   501	 * (`FOR NO KEY UPDATE`), which does not conflict with the `FOR KEY SHARE` an offer insert's FK
   502	 * takes on the same row.
   503	 */
   504	function finalizeOfferStatement(txn: AdmissionsTxn, offerId: string) {
   505	  return txn`
   506	      WITH locked_agent AS (
   507	        -- Agents first (see createOfferDb): this statement UPDATES the agent row, and agent
   508	        -- deletion holds that row while cascading into offers. Reaching the agent through the
   509	        -- offer would be the reverse order.
   510	        SELECT a.id FROM admissions_offers o JOIN agents a ON a.id = o.agent_id
   511	        WHERE o.id = ${offerId}
   512	        FOR KEY SHARE OF a
   513	      ), finalized AS (
   514	        UPDATE admissions_offers o
   515	        SET status = 'fully_accepted'
   516	        FROM locked_agent la
   517	        WHERE o.id = ${offerId}
   518	          AND o.agent_id = la.id
   519	          AND o.status = 'pending'
   520	          AND o.expires_at > NOW()
   521	          AND o.accepted_at_agent IS NOT NULL
   522	          AND (
   523	            o.accepted_at_human IS NOT NULL
   524	            OR NOT EXISTS (SELECT 1 FROM user_agents ua WHERE ua.agent_id = o.agent_id)
   525	          )
   526	        RETURNING o.id, o.agent_id, o.application_id
   527	      ), admitted AS (
   528	        UPDATE agents SET is_admitted = TRUE
   529	        WHERE id IN (SELECT agent_id FROM finalized)
   530	        RETURNING id
   531	      ), decided AS (
   532	        UPDATE admissions_applications
   533	        SET state = 'admitted', decided_at = NOW(), updated_at = NOW()
   534	        WHERE id IN (SELECT application_id FROM finalized WHERE application_id IS NOT NULL)
   535	        RETURNING id
   536	      )
   537	      INSERT INTO admissions_audit (offer_id, application_id, agent_id, actor_type, actor_id, action, detail)
   538	      SELECT f.id, f.application_id, f.agent_id, 'system', null, 'admission_finalized', '{}'::jsonb
   539	      FROM finalized f
   540	    `;
   541	}
   542	
   543	/**
   544	 * M11-1b D6 — acceptance, made idempotent by its own predicate.
   545	 *
   546	 * The pre-D6 shape ran as a batch whose audit element asked only whether `accepted_at_agent IS NOT
   547	 * NULL` — which stays true on every retry, so each repeated call appended another audit row and
   548	 * rewrote the timestamp. A later fixed element cannot tell whether THIS invocation won. So the
   549	 * timestamp write carries `accepted_at_agent IS NULL` and its `RETURNING` drives the audit insert
   550	 * in the same statement: the second call transitions nothing and writes nothing.
   551	 *
   552	 * Finalization is the second element, and it is one statement for the same reason (see
   553	 * `finalizeOfferStatement`). It needs to observe this element's write, which a later statement in
   554	 * the same transaction does — each takes a fresh snapshot.
   555	 */
   556	export async function acceptOfferAsAgentDb(offerId: string, agentId: string, events?: readonly PreparedEvent[]): Promise<"ok" | "invalid"> {
   557	  const offer = await getOfferByIdDb(offerId);
   558	  if (!offer || offer.agentId !== agentId || offer.status !== "pending") return "invalid";
   559	  if (new Date(offer.expiresAt).getTime() < Date.now()) return "invalid";
   560	
   561	  const emitted = emitEventCtes(events, "accepted", { firstParamIndex: 3, overrides: events?.length ? [{ rowSource: "accepted", columnSql: { secondary_subject_id: sqlColumn("accepted.application_id", "text") } }] : [] });
   562	  if (!events?.length) {
   563	    await sql!.transaction((txn) => [
   564	      txn`SELECT id FROM agents WHERE id = ${agentId} FOR KEY SHARE`,
   565	      txn`
   566	        WITH accepted AS (
   567	          UPDATE admissions_offers
   568	          SET accepted_at_agent = NOW()
   569	          WHERE id = ${offerId} AND agent_id = ${agentId} AND status = 'pending' AND expires_at > NOW()
   570	            AND accepted_at_agent IS NULL
   571	          RETURNING id, agent_id, application_id
   572	        )
   573	        INSERT INTO admissions_audit (offer_id, application_id, agent_id, actor_type, actor_id, action, detail)
   574	        SELECT a.id, a.application_id, a.agent_id, 'agent', ${agentId}, 'accept_agent', '{}'::jsonb
   575	        FROM accepted a
   576	      `,
   577	      finalizeOfferStatement(txn, offerId),
   578	    ]);
   579	  } else {
   580	    await sql!.transaction((txn) => [
   581	      txn`SELECT id FROM agents WHERE id = ${agentId} FOR KEY SHARE`,
   582	      txn(`
   583	      WITH accepted AS (
   584	        UPDATE admissions_offers
   585	        SET accepted_at_agent = NOW()
   586	        WHERE id = $1 AND agent_id = $2 AND status = 'pending' AND expires_at > NOW()
   587	          AND accepted_at_agent IS NULL
   588	        RETURNING id, agent_id, application_id
   589	      )${emitted.ctes.length ? `, ${emitted.ctes.join(", ")}` : ""}
   590	      INSERT INTO admissions_audit (offer_id, application_id, agent_id, actor_type, actor_id, action, detail)
   591	      SELECT a.id, a.application_id, a.agent_id, 'agent', $2, 'accept_agent', '{}'::jsonb
   592	      FROM accepted a
   593	      `, [offerId, agentId, ...emitted.params]),
   594	      finalizeOfferStatement(txn, offerId),
   595	    ]);
   596	  }
   597	  return classifyAcceptOutcomeDb(offerId, "agent");
   598	}
   599	
   600	/**
   601	 * What an acceptance actually achieved, read back after the transaction.
   602	 *
   603	 * A decisive statement writing zero rows is NOT automatically `"ok"`: a decline could have won
   604	 * after the pre-read, or the offer could have lapsed, in which case the caller must hear `invalid`
   605	 * rather than a success that recorded nothing. But a REPEATED acceptance also writes zero rows and
   606	 * is genuinely `"ok"` — the offer is accepted, this call simply added nothing. The stored
   607	 * timestamp is what separates the two, so it is what this reads.
   608	 */
   609	async function classifyAcceptOutcomeDb(offerId: string, side: "agent" | "human"): Promise<"ok" | "invalid"> {
   610	  const offer = await getOfferByIdDb(offerId);
   611	  if (!offer) return "invalid";
   612	  const stamped = side === "agent" ? offer.acceptedAtAgent : offer.acceptedAtHuman;
   613	  if (!stamped) return "invalid";
   614	  // `fully_accepted` is a success too — this side's acceptance is what got it there.
   615	  return offer.status === "pending" || offer.status === "fully_accepted" ? "ok" : "invalid";
   616	}
