   707	export async function declineOfferAsAgentDb(offerId: string, agentId: string, events?: readonly PreparedEvent[]): Promise<boolean> {
   708	  const rows = await declineOfferStatement(offerId, { type: "agent", agentId }, events);
   709	  return rows.length > 0;
   710	}
