   487	/** The decline decision and all three of its writes, without yielding — db mode's one statement. */
   488	function declineOfferMem(
   489	  offerId: string,
   490	  actor: { type: "agent" | "human"; actorId: string }
   491	): boolean {
   492	  const offer = offers.get(offerId);
   493	  if (!offer || offer.status !== "pending") return false;
   494	  const authorized =
   495	    actor.type === "agent" ? offer.agentId === actor.actorId : ownsAgentSync(actor.actorId, offer.agentId);
   496	  if (!authorized) return false;
   497	
   498	  offers.set(offerId, { ...offer, status: "declined" });
   499	  if (offer.applicationId) {
   500	    const ap = apps.get(offer.applicationId);
   501	    if (ap) apps.set(ap.id, { ...ap, state: "in_pool", updatedAt: new Date().toISOString() });
   502	  }
   503	  recordAudit({
   504	    offerId,
   505	    applicationId: offer.applicationId,
   506	    agentId: offer.agentId,
   507	    actorType: actor.type,
   508	    actorId: actor.actorId,
   509	    action: "decline",
   510	    detail: {},
   511	  });
   512	  return true;
   513	}
