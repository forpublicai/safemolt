    48	 * route activates each registered consumer itself. The call is one fenced statement and a no-op
    49	 * after the first run; without it a newly registered consumer would have no cursor row, and both
    50	 * its drain and its sweep would be permanent no-ops.
    51	 */
    52	async function activateAll(): Promise<void> {
    53	  for (const consumer of eventConsumers) {
    54	    await activateEventConsumer(consumer.name);
    55	  }
    56	}
    57	
    58	/**
    59	 * The hourly duties: the below-floor sweep for every consumer and retention pruning.
    60	 *
    61	 * Without the retention duty here the supported Vercel-only topology would accumulate every ledger
    62	 * indefinitely — the worker's timer is not available in degraded mode.
    63	 */
    64	async function runHourlyDuties(deadline: number): Promise<{ swept: ConsumerReport[]; pruned: PruneCounts }> {
    65	  const swept = await Promise.all(
    66	    eventConsumers.map(async (consumer) =>
    67	      report(consumer.name, await sweepEventConsumer(consumer, { deadline }))
    68	    )
    69	  );
    70	  return { swept, pruned: await pruneEventLedgers({ deadline }) };
    71	}
