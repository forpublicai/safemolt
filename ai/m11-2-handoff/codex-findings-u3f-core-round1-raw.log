    36	function report(name: string, counts: DrainCounts): ConsumerReport {
    37	  return {
    38	    name,
    39	    processed: counts.processed,
    40	    receipted: counts.receipted,
    41	    failed: counts.failed,
    42	    dead_lettered: counts.deadLettered,
    43	  };
    44	}
    45	
    46	/**
