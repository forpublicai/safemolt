   652	/**
   653	 * M11-1b D6 — a decline as ONE gated statement.
   654	 *
   655	 * Ownership and status WERE checked before D6 (correcting this chunk's own problem statement); the
   656	 * defect was that the three writes that followed were unconditional and separately committed, so a
   657	 * crash between them split offer, application and audit, and a concurrent decline could run the
   658	 * whole sequence twice. The checks now live inside the decisive predicate and the other two writes
   659	 * hang off its `RETURNING`, so zero rows is a clean no-op.
   660	 *
   661	 * @param actor `agent` authorizes by owning the offer; `human` by an active `user_agents` link.
   662	 */
   663	function declineOfferStatement(
   664	  offerId: string,
   665	  actor: { type: "agent"; agentId: string } | { type: "human"; humanUserId: string },
   666	  events?: readonly PreparedEvent[]
   667	) {
   668	  const actorId = actor.type === "agent" ? actor.agentId : actor.humanUserId;
   669	  const emitted = emitEventCtes(events, "declined", { firstParamIndex: 3, overrides: events?.length ? [{ rowSource: "declined", columnSql: { secondary_subject_id: sqlColumn("declined.application_id", "text") } }] : [] });
   670	  return sql!(`
   671	    WITH locked_agent AS (
   672	      -- Agents first, for the reason spelled out on createOfferDb: agent deletion locks the agent
   673	      -- and cascades INTO offers and applications, so a writer that goes the other way deadlocks
   674	      -- with it. Consuming this CTE below is what forces the order — sibling CTE evaluation order
   675	      -- is not guaranteed on its own.
   676	      SELECT a.id FROM admissions_offers o JOIN agents a ON a.id = o.agent_id
   677	      WHERE o.id = $1
   678	      FOR KEY SHARE OF a
   679	    ), declined AS (
   680	      UPDATE admissions_offers o
   681	      SET status = 'declined'
   682	      FROM locked_agent la
   683	      WHERE o.id = $1 AND o.agent_id = la.id AND o.status = 'pending'
   684	        -- Both ownership rules are parameterised into one predicate rather than composed from SQL
   685	        -- fragments: this driver's tagged template has no fragment type, so an interpolated
   686	        -- template would be bound as a VALUE and silently stop authorizing anything.
   687	        AND (
   688	          ('${actor.type}'::text = 'agent' AND o.agent_id = $2)
   689	          OR ('${actor.type}'::text = 'human' AND EXISTS (
   690	                SELECT 1 FROM user_agents ua WHERE ua.user_id = $2 AND ua.agent_id = o.agent_id
   691	              ))
   692	        )
   693	      RETURNING o.id, o.agent_id, o.application_id
   694	    )${emitted.ctes.length ? `, ${emitted.ctes.join(", ")}` : ""}, released AS (
   695	      UPDATE admissions_applications
   696	      SET state = 'in_pool', updated_at = NOW()
   697	      WHERE id IN (SELECT application_id FROM declined WHERE application_id IS NOT NULL)
   698	      RETURNING id
   699	    )
   700	    INSERT INTO admissions_audit (offer_id, application_id, agent_id, actor_type, actor_id, action, detail)
   701	    SELECT d.id, d.application_id, d.agent_id, '${actor.type}', $2, 'decline', '{}'::jsonb
   702	    FROM declined d
   703	    RETURNING offer_id
   704	  `, [offerId, actorId, ...emitted.params]);
   705	}
