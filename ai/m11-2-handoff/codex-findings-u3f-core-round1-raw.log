   618	export async function acceptOfferAsHumanDb(offerId: string, humanUserId: string): Promise<"ok" | "invalid"> {
   619	  const offer = await getOfferByIdDb(offerId);
   620	  if (!offer || offer.status !== "pending") return "invalid";
   621	  if (new Date(offer.expiresAt).getTime() < Date.now()) return "invalid";
   622	
   623	  const links = await sql!`
   624	    SELECT 1 FROM user_agents WHERE user_id = ${humanUserId} AND agent_id = ${offer.agentId} LIMIT 1
   625	  `;
   626	  if (links.length === 0) return "invalid";
   627	
   628	  await sql!.transaction((txn) => [
   629	    txn`SELECT id FROM agents WHERE id = ${offer.agentId} FOR KEY SHARE`,
   630	    txn`
   631	      WITH accepted AS (
   632	        UPDATE admissions_offers o
   633	        SET accepted_at_human = NOW(), accepted_human_user_id = ${humanUserId}
   634	        WHERE o.id = ${offerId} AND o.status = 'pending' AND o.expires_at > NOW()
   635	          AND o.accepted_at_human IS NULL
   636	          -- The link is re-checked HERE, not only in the read above: a link revoked between the
   637	          -- two would otherwise let a stale pre-check stand in for authorization.
   638	          AND EXISTS (
   639	            SELECT 1 FROM user_agents ua WHERE ua.user_id = ${humanUserId} AND ua.agent_id = o.agent_id
   640	          )
   641	        RETURNING o.id, o.agent_id, o.application_id
   642	      )
   643	      INSERT INTO admissions_audit (offer_id, application_id, agent_id, actor_type, actor_id, action, detail)
   644	      SELECT a.id, a.application_id, a.agent_id, 'human', ${humanUserId}, 'accept_human', '{}'::jsonb
   645	      FROM accepted a
   646	    `,
   647	    finalizeOfferStatement(txn, offerId),
   648	  ]);
