   120	    // Stamped last, so the completion a runtime reports is one it has actually finished a pass for.
   121	    await recordEventDrainHeartbeat(contractHash);
   122	
   123	    return NextResponse.json({
   124	      success: true,
   125	      contract_hash: contractHash,
   126	      consumers,
   127	      hourly_ran: hourlyDue,
   128	      hourly,
   129	    });
