   434	export async function acceptOfferAsAgentMem(offerId: string, agentId: string, events?: readonly PreparedEvent[]): Promise<"ok" | "invalid"> {
   435	  const offer = offers.get(offerId);
   436	  if (!offer || offer.agentId !== agentId || offer.status !== "pending") return "invalid";
   437	  if (new Date(offer.expiresAt).getTime() < Date.now()) return "invalid";
   438	  // Idempotent, matching db mode: only the FIRST acceptance writes a timestamp and an audit row.
   439	  // Repeating the call is still "ok" — the offer is accepted — it simply records nothing new.
   440	  if (!offer.acceptedAtAgent) {
   441	    const batch = prepareEventBatch(events);
   442	    offers.set(offerId, { ...offer, acceptedAtAgent: new Date().toISOString() });
   443	    recordAudit({
   444	      offerId,
   445	      applicationId: offer.applicationId,
   446	      agentId,
   447	      actorType: "agent",
   448	      actorId: agentId,
   449	      action: "accept_agent",
   450	      detail: {},
   451	    });
   452	    await appendPreparedBatch(batch).dispatched;
   453	  }
   454	  await tryFinalizeOfferMem(offerId);
   455	  return "ok";
   456	}
