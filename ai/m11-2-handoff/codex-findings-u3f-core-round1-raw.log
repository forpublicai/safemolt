   458	export async function acceptOfferAsHumanMem(offerId: string, humanUserId: string): Promise<"ok" | "invalid"> {
   459	  // --- one synchronous section, authorization INCLUDED. `ownsAgentSync` exists for exactly this:
   460	  // reading the link list across an `await` and then mutating lets a former owner act after their
   461	  // link was revoked in the gap.
   462	  const offer = offers.get(offerId);
   463	  if (!offer || offer.status !== "pending") return "invalid";
   464	  if (!ownsAgentSync(humanUserId, offer.agentId)) return "invalid";
   465	  if (new Date(offer.expiresAt).getTime() < Date.now()) return "invalid";
   466	  if (!offer.acceptedAtHuman) {
   467	    offers.set(offerId, {
   468	      ...offer,
   469	      acceptedAtHuman: new Date().toISOString(),
   470	      acceptedHumanUserId: humanUserId,
   471	    });
   472	    recordAudit({
   473	      offerId,
   474	      applicationId: offer.applicationId,
   475	      agentId: offer.agentId,
   476	      actorType: "human",
   477	      actorId: humanUserId,
   478	      action: "accept_human",
   479	      detail: {},
   480	    });
   481	  }
   482	  // --- end synchronous section ---
   483	  await tryFinalizeOfferMem(offerId);
   484	  return "ok";
   485	}
