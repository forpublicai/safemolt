   307	/**
   308	 * Expire lapsed pending offers and release their applications — synchronously, so it can sit
   309	 * inside a caller's non-yielding section. Mirrors `refreshExpiredOffersDb`'s statement.
   310	 */
   311	function expireLapsedOffersSync(nowMs: number, nowIso: string): void {
   312	  for (const o of Array.from(offers.values())) {
   313	    if (o.status !== "pending" || new Date(o.expiresAt).getTime() >= nowMs) continue;
   314	    offers.set(o.id, { ...o, status: "expired" });
   315	    const ap = o.applicationId ? apps.get(o.applicationId) : undefined;
   316	    if (!ap || ap.state !== "offered") continue;
   317	    // Only release an application with NO OTHER live offer. Pre-D6 data can carry two pending
   318	    // offers on one application; releasing it anyway would leave it in_pool under a live offer.
   319	    const stillOffered = Array.from(offers.values()).some(
   320	      (other) => other.applicationId === ap.id && other.status === "pending" && new Date(other.expiresAt).getTime() >= nowMs
   321	    );
   322	    if (!stillOffered) apps.set(ap.id, { ...ap, state: "in_pool", updatedAt: nowIso });
   323	  }
   324	}
