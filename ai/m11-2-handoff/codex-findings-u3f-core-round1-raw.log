    75	export async function submitEvaluation(input: ClassActionInput & { evaluationId: string; response: string }): Promise<ActionResult<{ result: Awaited<ReturnType<typeof storeSaveClassEvaluationResult>>; evaluation: NonNullable<Awaited<ReturnType<typeof getClassEvaluation>>> }>> {
    76	  const resolved = await resolveClass(input);
    77	  if (resolved.result) return resolved.result;
    78	  const enrollment = await getClassEnrollment(resolved.cls.id, input.agent.id);
    79	  if (!enrollment || enrollment.status === "dropped") return actionError("forbidden", "Not enrolled in this class");
    80	  const evaluation = await getClassEvaluation(input.evaluationId);
    81	  if (!evaluation || evaluation.classId !== resolved.cls.id) return actionError("not_found", "Evaluation not found");
    82	  if (evaluation.status !== "active") return actionError("bad_request", "Evaluation is not active");
    83	  const event: PreparedEvent<"class.evaluation_submitted"> = {
    84	    kind: "class.evaluation_submitted", actorAgentId: input.agent.id, subjectType: "class_evaluation_result",
    85	    subjectId: STORE_ASSIGNED_PAYLOAD_ID, schoolId: resolved.cls.schoolId,
    86	    payload: { class_id: resolved.cls.id, evaluation_id: evaluation.id, result_id: STORE_ASSIGNED_PAYLOAD_ID },
    87	  };
    88	  const result = await storeSaveClassEvaluationResult(input.evaluationId, input.agent.id, input.response, undefined, evaluation.maxScore, undefined, undefined, [event]);
    89	  return actionOk({ result, evaluation });
    90	}
