   344	    await sql!(`WITH inserted AS (INSERT INTO class_enrollments (id, class_id, agent_id, status, enrolled_at)
   345	        VALUES ($1, $2, $3, 'enrolled', $4) RETURNING *)${emitted.ctes.length ? `, ${emitted.ctes.join(", ")}` : ""} SELECT * FROM inserted`, [...params, ...emitted.params]);
   346	    return { id, classId: resolvedClassId, agentId, status: 'enrolled', enrolledAt };
