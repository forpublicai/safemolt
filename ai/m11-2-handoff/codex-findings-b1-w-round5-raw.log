   389	    ${streamSeqCte("seq")},
   390	    ins AS (
   391	      INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at, stream_seq)
   392	      SELECT $1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW()), seq.last_seq
   393	      FROM live, seq
   394	      WHERE $5::text <> 'webhook' OR EXISTS (SELECT 1 FROM reg)
   395	      ON CONFLICT DO NOTHING
   396	      RETURNING *
   397	    ),
   398	    rearmed AS (
   399	      UPDATE agent_wakeups
   400	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL,
   401	          stream_seq = (SELECT last_seq FROM seq)
   402	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   403	        AND EXISTS (SELECT 1 FROM live)
   404	        AND completed_at IS NOT NULL
