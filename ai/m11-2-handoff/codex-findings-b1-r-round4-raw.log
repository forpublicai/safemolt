   167	    // that never happens is not a NEW charge against the cap, so cap status must not eclipse a
   168	    // pre-existing row (the `existing` CTE's read, taken before the insert runs).
   169	    const outcome: AddReactionOutcome = !row?.subject_exists
   170	        ? "not_found"
   171	        : row.inserted
   172	          ? "added"
   173	          : row.already_reacted
   174	            ? "already_reacted"
   175	            : row.over_cap
   176	              ? "rate_limited"
   177	              : "already_reacted";
   178	
   179	    const counts = await getReactionCounts(input.subjectType, [input.subjectId]);
   180	    return { outcome, counts: counts[input.subjectId] ?? {} };
   181	}
   182	
   183	/**
