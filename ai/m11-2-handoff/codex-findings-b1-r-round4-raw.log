     6	 * with no FK to anchor it. The daily cap cannot reuse the comment shape verbatim: a reaction
     7	 * has a natural `ON CONFLICT DO NOTHING` path a comment lacks, so the cap must gate the INSERT
     8	 * rather than being charged unconditionally — a cap-first CTE would charge quota for a duplicate.
     9	 */
    10	import { sql } from "@/lib/db";
    11	import type { PreparedEvent } from "@/lib/events/kinds";
    12	import { emitEventCtes } from "../events/statement";
    13	import { buildExecutionGuardCte, type ExecutionGuard } from "../execution-guard";
    14	
    15	export interface AddReactionInput {
    16	    agentId: string;
    17	    subjectType: "post" | "comment";
    18	    subjectId: string;
    19	    emoji: string;
    20	    dailyLimit: number;
    21	}
    22	
    23	export interface RemoveReactionInput {
    24	    agentId: string;
    25	    subjectType: "post" | "comment";
    26	    subjectId: string;
    27	    emoji: string;
    28	}
    29	
    30	export type AddReactionOutcome =
    31	    | "added"
    32	    | "already_reacted"
    33	    | "not_found"
    34	    | "rate_limited"
    35	    | "execution_guard_failed";
    36	export type RemoveReactionOutcome = "removed" | "not_found" | "execution_guard_failed";
    37	
    38	interface AddReactionRow {
    39	    subject_exists: boolean;
    40	    inserted: boolean;
    41	    already_reacted: boolean;
    42	    over_cap: boolean;
    43	    guard_passed?: number;
    44	}
    45	
    46	/**
    47	 * Statement 1 of `addReaction`: lock the live SUBJECT alone, no write (codex round 3, F2). Run
    48	 * before the seed, so the seed's own actor-FK `FOR KEY SHARE` (statement 2) always comes AFTER
    49	 * this — keeping the global order posts -> comments -> agents instead of a reaction seeding its
    50	 * rate row (locking the agent) before it ever touches the post, which crossed a withdrawal's own
    51	 * posts -> agents order and deadlocked (40P01).
    52	 */
    53	function subjectOnlyLockStatementText(subjectType: "post" | "comment"): string {
    54	    return subjectType === "post"
    55	        ? `/* race:b1r-add-post-lock */ SELECT id FROM posts WHERE id = $1 AND deleted_at IS NULL FOR SHARE`
    56	        : `/* race:b1r-add-post-lock */ SELECT p.id FROM posts p
    57	       WHERE p.id = (SELECT post_id FROM comments WHERE id = $1) AND p.deleted_at IS NULL
    58	       FOR SHARE`;
    59	}
    60	
    61	/**
    62	 * Statement 3's CTE text (the decisive statement), branched by subject type rather than
    63	 * interpolated. `$1` agent, `$2` subject, `$3` emoji, `$4` daily limit. Re-takes the subject lock
    64	 * statement 1 already holds — free, within the same transaction.
    65	 */
    66	function addReactionStatementText(subjectType: "post" | "comment", eventCtes: string, guardCte: string | null): string {
    67	    const livePostCte =
    68	        subjectType === "post"
    69	            ? `SELECT id FROM posts WHERE id = $2 AND deleted_at IS NULL FOR SHARE`
    70	            : `SELECT p.id FROM posts p
    71	         WHERE p.id = (SELECT post_id FROM comments WHERE id = $2) AND p.deleted_at IS NULL
    72	         FOR SHARE`;
    73	    const subjectCte =
    74	        subjectType === "post"
    75	            ? `SELECT id FROM live_post`
    76	            : `SELECT c.id FROM live_post lp JOIN comments c ON c.post_id = lp.id WHERE c.id = $2 FOR KEY SHARE`;
    77	    const subjectTypeLiteral = subjectType === "post" ? "'post'" : "'comment'";
    78	    const ctes = [
    79	        // `pre` only reads and locks; `rate_updated` below is the sole writer of `agent_rate_limits`
    80	        // here (Postgres refuses two data-modifying CTEs writing the same row in one statement).
    81	        // FOR NO KEY UPDATE, not FOR UPDATE (codex round 2, F1): the latter conflicts with the
    82	        // FOR KEY SHARE a withdrawal's own FK check takes on this row.
    83	        `pre AS (
    84	      /* race:b1r-pre-lock */
    85	      SELECT CASE WHEN reaction_count_date <> CURRENT_DATE THEN 0 ELSE reaction_count END AS current_count
    86	      FROM agent_rate_limits WHERE agent_id = $1 FOR NO KEY UPDATE
    87	    )`,
    88	        ...(guardCte ? [guardCte] : []),
    89	        `live_post AS ( ${livePostCte} )`,
    90	        `subject AS ( ${subjectCte} )`,
    91	        `under_cap AS ( SELECT 1 FROM pre WHERE current_count < $4 )`,
    92	        // Read BEFORE the insert, so a cap breach never masks a real pre-existing duplicate — the
    93	        // insert's WHERE requires under_cap, so ON CONFLICT never fires to tell them apart.
    94	        `existing AS (
    95	      SELECT 1 FROM content_reactions
    96	      WHERE agent_id = $1 AND subject_type = ${subjectTypeLiteral} AND subject_id = $2 AND emoji = $3
    97	    )`,
    98	        `inserted AS (
    99	      INSERT INTO content_reactions (agent_id, subject_type, subject_id, emoji, created_at)
   100	      SELECT $1, ${subjectTypeLiteral}, $2, $3, NOW() FROM subject, under_cap${guardCte ? ", guard" : ""}
   101	      ON CONFLICT (agent_id, subject_type, subject_id, emoji) DO NOTHING
   102	      RETURNING *
   103	    )`,
   104	        // The ONLY write to agent_rate_limits: rolls the day and adds 1 iff the insert landed.
   105	        `rate_updated AS (
   106	      UPDATE agent_rate_limits
   107	      SET reaction_count = (SELECT current_count FROM pre)
   108	            + (CASE WHEN EXISTS (SELECT 1 FROM inserted) THEN 1 ELSE 0 END),
   109	          reaction_count_date = CURRENT_DATE
   110	      WHERE agent_id = $1
   111	      RETURNING reaction_count
   112	    )`,
   113	    ];
   114	    return `
   115	    WITH ${ctes.join(",\n    ")}${eventCtes}
   116	    SELECT (SELECT 1 FROM subject) IS NOT NULL AS subject_exists,
   117	           (SELECT 1 FROM inserted) IS NOT NULL AS inserted,
   118	           (SELECT 1 FROM existing) IS NOT NULL AS already_reacted,
   119	           (SELECT 1 FROM pre WHERE current_count >= $4) IS NOT NULL AS over_cap${
   120	               guardCte ? ",\n           (SELECT count(*) FROM guard)::int AS guard_passed" : ""
   121	           }
   122	  `;
   123	}
   124	
   125	/**
   126	 * Add a reaction: a three-statement `sql.transaction` (codex round 3, F2). Statement 1 locks the
   127	 * live subject alone; statement 2 seeds+locks the rate row, whose actor FK now comes after the
   128	 * subject lock; statement 3 is decisive and may re-take both locks for free. Events are rendered
   129	 * — and validated — before any statement runs, so a bad event leaves no seed behind.
   130	 */
   131	export async function addReaction(
   132	    input: AddReactionInput,
   133	    events?: readonly PreparedEvent[],
   134	    executionGuard?: ExecutionGuard
   135	): Promise<{ outcome: AddReactionOutcome; counts: Record<string, number> }> {
   136	    const params: unknown[] = [input.agentId, input.subjectId, input.emoji, input.dailyLimit];
   137	    const emitted = emitEventCtes(events, "inserted", { firstParamIndex: params.length + 1 });
   138	    // Rendered LAST, after every event param, so its own placeholder numbering never moves
   139	    // (mirrors `sendDm`/`createComment`).
   140	    const guard = buildExecutionGuardCte(executionGuard, params.length + 1 + emitted.params.length);
   141	    const eventCtes = emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : "";
   142	
   143	    const results = await sql!.transaction((txn) => [
   144	        txn(subjectOnlyLockStatementText(input.subjectType), [input.subjectId]),
   145	        // The no-op update targets `reaction_count`, never `agent_id` (codex round 2, F1): writing
   146	        // back the row's own key column forces Postgres's strongest tuple lock regardless of the
   147	        // explicit mode elsewhere, reopening the withdrawal deadlock the weaker mode avoids.
   148	        txn`
   149	      /* race:b1r-seed-lock */
   150	      INSERT INTO agent_rate_limits (agent_id, reaction_count_date, reaction_count)
   151	      VALUES (${input.agentId}, CURRENT_DATE, 0)
   152	      ON CONFLICT (agent_id) DO UPDATE SET reaction_count = agent_rate_limits.reaction_count
   153	    `,
   154	        txn(addReactionStatementText(input.subjectType, eventCtes, guard.cte), [
   155	            ...params,
   156	            ...emitted.params,
   157	            ...guard.params,
   158	        ]),
   159	    ]);
   160	    const row = (results[2] as AddReactionRow[])[0];
   161	
   162	    // Checked first, matching `sendDm`/`createComment`: it precedes every other refusal causally.
   163	    if (executionGuard && Number(row?.guard_passed ?? 0) === 0) {
   164	        return { outcome: "execution_guard_failed", counts: {} };
   165	    }
