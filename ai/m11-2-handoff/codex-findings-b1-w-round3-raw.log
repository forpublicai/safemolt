   194	            w.reason, w.event_id, w.payload,
   195	            h.url, h.secret, h.disabled_at
   196	     FROM claimed c
   197	     JOIN agent_wakeups w ON w.id = c.wakeup_id
   198	     LEFT JOIN agent_webhooks h ON h.agent_id = c.agent_id`,
