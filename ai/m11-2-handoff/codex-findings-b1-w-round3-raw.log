    34	  const claimed = await claimNextWebhookDelivery({ claimToken: randomUUID(), leaseMs: LEASE_MS });
    35	  if (!claimed) return "empty";
    36	  if (claimed.url === null || claimed.secret === null || claimed.disabledAt !== null) {
    37	    await recordWebhookAttempt({ id: claimed.id, claimToken: claimed.claimToken, status: null, ok: false });
    38	    return "failed";
    39	  }
    40	  const result = await deliverWakeup({
    41	    url: claimed.url,
    42	    secret: claimed.secret,
    43	    wakeupId: claimed.wakeupId,
    44	    eventId: claimed.eventId,
    45	    payload: {
    46	      reason: claimed.reason,
    47	      wakeup_id: claimed.wakeupId,
    48	      ...(claimed.eventId !== null ? { event_id: claimed.eventId } : {}),
    49	      subject: claimed.payload,
    50	      context_href: "/",
    51	    },
    52	  });
    53	  await recordWebhookAttempt({
    54	    id: claimed.id,
    55	    claimToken: claimed.claimToken,
    56	    status: result.status,
    57	    ok: result.ok,
