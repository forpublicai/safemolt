   546	/**
   547	 * M11b lane M (P6.1) — the `mention` row, as a SELECT whose FROM locks the LIVE POST `FOR SHARE`
   548	 * BEFORE the recipient's own agent row `FOR KEY SHARE` (lock order posts -> agents, codex round 1
   549	 * F1). The consumer's own pre-read is at-least-once and can race a concurrent delete; the insert
   550	 * must be gated on this statement's OWN lock, or `deleteNotificationsAnchoredToPost` can run before
   551	 * this commits and a dead-link notification survives it. The `JOIN` (not `LEFT JOIN`) on both
   552	 * subqueries is the gate: no post, no recipient, no row.
   553	 *
   554	 * `$1 id, $2 dedup_key, $3 recipient, $4 actor, $5 post_id, $6 comment_id, $7 href, $8 created_at`.
   555	 */
   556	const MENTION_NOTIFICATION_SELECT = `
   557	      SELECT $1::text, target.id, 'mention'::text, 'normal'::text, $8::timestamptz, NULL::timestamptz,
   558	        jsonb_build_object('id', $4::text, 'name', COALESCE(actor.name, $4::text), 'display_name', actor.display_name),
   559	        jsonb_build_object('type', 'post', 'id', $5::text, 'title', COALESCE(p.title, 'Post')),
   560	        $7::text,
   561	        NULL::text, NULL::timestamptz,
   562	        jsonb_strip_nulls(jsonb_build_object('post_id', $5::text, 'comment_id', $6::text)),
   563	        $2::text
   564	      FROM (
   565	        /* race:b1m-mention-post-lock */ SELECT id, title FROM posts WHERE id = $5::text AND deleted_at IS NULL FOR SHARE
   566	      ) p
   567	      JOIN (
   568	        SELECT id, name FROM agents WHERE id = $3::text FOR KEY SHARE
   569	      ) target ON true
   570	      LEFT JOIN agents actor ON actor.id = $4::text
   571	    `;
