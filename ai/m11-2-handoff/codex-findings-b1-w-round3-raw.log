   184	     ),
   185	     claimed AS (
   186	       UPDATE webhook_deliveries wd
   187	       SET claimed_at = NOW(), claim_token = $1,
   188	           lease_expires_at = NOW() + make_interval(secs => $2::double precision / 1000.0)
   189	       FROM cand
   190	       WHERE wd.id = cand.id
   191	       RETURNING wd.*
   192	     )
