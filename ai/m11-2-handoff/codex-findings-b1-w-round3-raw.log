   107	  const [deletedRows] = await sql!.transaction((txn) => [
   108	    txn`DELETE FROM agent_webhooks WHERE agent_id = ${agentId} RETURNING agent_id`,
   109	    txn`
   110	      WITH terminalized AS (
   111	        UPDATE webhook_deliveries wd
   112	        SET terminal_reason = 'webhook_removed'
   113	        WHERE wd.agent_id = ${agentId}
   114	          AND wd.terminal_reason IS NULL
   115	          AND (wd.claimed_at IS NULL OR wd.lease_expires_at < NOW())
   116	        RETURNING wd.wakeup_id
   117	      )
   118	      UPDATE agent_wakeups w
   119	      SET completed_at = NOW(), result = 'webhook_removed'
   120	      FROM terminalized t
   121	      WHERE w.id = t.wakeup_id
   122	        AND w.delivery = 'webhook'
   123	        AND w.completed_at IS NULL
   124	      RETURNING w.id
   125	    `,
   126	  ]);
