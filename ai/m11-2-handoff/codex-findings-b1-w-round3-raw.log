   280	       SELECT h.agent_id, h.disabled_at, h.failure_count
   281	       FROM agent_webhooks h
   282	       WHERE h.agent_id = (SELECT wd.agent_id FROM webhook_deliveries wd WHERE wd.id = $1::bigint)
   283	       ${regLock}
   284	     ),
   285	     target AS (
   286	       SELECT wd.id, wd.wakeup_id, wd.agent_id, wd.attempts, w.delivery AS wakeup_delivery
   287	       FROM webhook_deliveries wd
   288	       JOIN agent_wakeups w ON w.id = wd.wakeup_id
   289	       WHERE wd.id = $1::bigint AND wd.claim_token = $2::text AND wd.terminal_reason IS NULL
   290	       FOR UPDATE OF wd
   291	     ),
   292	     outcome AS (
   293	       SELECT
   294	         t.id, t.wakeup_id, t.agent_id, t.attempts, t.wakeup_delivery,
   295	         CASE
   296	           WHEN $3::boolean THEN 'success'
   297	           WHEN r.agent_id IS NULL THEN 'gone'
   298	           WHEN r.disabled_at IS NOT NULL THEN 'disabled'
   299	           WHEN (r.failure_count + 1 >= 10) THEN 'disabled'
   300	           WHEN t.attempts + 1 >= 3 THEN 'exhausted'
