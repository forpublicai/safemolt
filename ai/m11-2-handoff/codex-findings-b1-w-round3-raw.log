     1	-- M11b Lane W (P5.1) — webhook registrations and the per-wakeup delivery ledger.
     2	--
     3	-- `agent_webhooks` is one row per agent: the https URL, the HMAC secret (rotated on re-POST), the
     4	-- channel mode (`primary` — webhook is the resolved delivery; `both` — webhook fires ALONGSIDE an
     5	-- internal-primary tick), and the auto-disable bookkeeping (`failure_count`, `disabled_at`).
     6	--
     7	-- `webhook_deliveries` is the channel-state ledger P5.1 requires: `agent_wakeups` never carries
     8	-- delivery attempt/claim state itself, so each webhook-bearing wakeup gets exactly one ledger row
     9	-- (`UNIQUE (wakeup_id)`, idempotent under concurrent router/drain passes). `terminal_reason` is the
    10	-- ledger's own terminal marker (`delivered | exhausted | webhook_removed | webhook_disabled`, NULL =
    11	-- still live) — kept separate from `agent_wakeups.result` because a `mode='both'` ledger terminalizes
    12	-- independently of the internal-primary wakeup it rides beside. `next_attempt_at` is the exponential
    13	-- backoff clock the claim scan reads.
    14	--
    15	-- Idempotent (M8 invariant): `IF NOT EXISTS` everywhere, and re-running is the recovery path.
    16	
    17	CREATE TABLE IF NOT EXISTS agent_webhooks (
    18	  agent_id TEXT PRIMARY KEY REFERENCES agents(id) ON DELETE CASCADE,
    19	  url TEXT NOT NULL,
    20	  secret TEXT NOT NULL,
    21	  mode TEXT NOT NULL DEFAULT 'primary',
    22	  disabled_at TIMESTAMPTZ,
    23	  failure_count INT NOT NULL DEFAULT 0,
    24	  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    25	);
    26	
    27	CREATE TABLE IF NOT EXISTS webhook_deliveries (
    28	  id BIGSERIAL PRIMARY KEY,
    29	  wakeup_id BIGINT NOT NULL UNIQUE REFERENCES agent_wakeups(id) ON DELETE CASCADE,
    30	  agent_id TEXT NOT NULL REFERENCES agents(id) ON DELETE CASCADE,
    31	  attempts INT NOT NULL DEFAULT 0,
    32	  last_attempt_at TIMESTAMPTZ,
    33	  delivered_at TIMESTAMPTZ,
    34	  last_status INT,
    35	  claimed_at TIMESTAMPTZ,
    36	  claim_token TEXT,
    37	  lease_expires_at TIMESTAMPTZ,
    38	  terminal_reason TEXT,
    39	  next_attempt_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
    40	);
    41	
    42	-- Named by the plan verbatim: the claim scan's lease-reclaim predicate reads both columns.
    43	CREATE INDEX IF NOT EXISTS idx_webhook_deliveries_lease
    44	  ON webhook_deliveries(lease_expires_at, delivered_at);
    45	
    46	-- Serves `claimNextWebhookDelivery`'s actual WHERE clause: nonterminal AND due. Partial on
    47	-- `terminal_reason IS NULL` so a terminal row (the majority, over time) never enters the index.
    48	CREATE INDEX IF NOT EXISTS idx_webhook_deliveries_claim_scan
    49	  ON webhook_deliveries(next_attempt_at)
