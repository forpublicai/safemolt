   248	/**
   249	 * Lock order: registration (`reg`) → ledger (`target`/`updated_delivery`) → wakeup
   250	 * (`completed_wakeup`) — the same order `deleteAgentWebhook` and every enqueue/re-arm take (F4).
   251	 * `success`/`gone`/`disabled`/`exhausted` complete the webhook-primary wakeup in this SAME statement
   252	 * as the ledger (CLAUDE.md's coupling rule); a `mode='both'` ledger's internal wakeup is untouched.
   253	 * F2: the disposition sweep for this agent's OTHER ledger rows is a SEPARATE statement below, run
   254	 * after this one commits, so it sees a fresh snapshot rather than reusing this statement's own.
   255	 */
   256	export async function recordWebhookAttempt(
   257	  input: RecordWebhookAttemptInput
   258	): Promise<RecordWebhookAttemptOutcome> {
   259	  const params: unknown[] = [input.id, input.claimToken, input.ok, input.status];
   260	  // Always rendered; the insert's own `WHERE EXISTS (SELECT 1 FROM disabled_now)` gate (built into
   261	  // `emitEventCtes`/`emitEventStatement`) is what makes it a no-op on every attempt that does not
   262	  // cross the threshold — the event is never a JS-side conditional. F8: subject/payload come from
   263	  // `disabled_now.agent_id`, the token-fenced row's own agent — never from a caller-supplied one.
   264	  const events: PreparedEvent<"webhook.disabled">[] = [buildWebhookDisabledEvent()];
