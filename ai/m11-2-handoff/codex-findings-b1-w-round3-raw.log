    51	
    52	CREATE INDEX IF NOT EXISTS idx_webhook_deliveries_agent ON webhook_deliveries(agent_id);
    53	
    54	-- Retrofit FKs for an environment that ran an earlier, pre-FK version of this file this session
    55	-- (checked by constraint name, since ADD CONSTRAINT has no IF NOT EXISTS). A fresh install's inline
    56	-- REFERENCES above already satisfies this and the DO block is a silent no-op there.
    57	DO $$
    58	BEGIN
    59	  IF NOT EXISTS (
    60	    SELECT 1 FROM pg_constraint WHERE conname = 'agent_webhooks_agent_id_fkey'
    61	  ) THEN
    62	    ALTER TABLE agent_webhooks ADD CONSTRAINT agent_webhooks_agent_id_fkey
    63	      FOREIGN KEY (agent_id) REFERENCES agents(id) ON DELETE CASCADE;
    64	  END IF;
    65	  IF NOT EXISTS (
    66	    SELECT 1 FROM pg_constraint WHERE conname = 'webhook_deliveries_wakeup_id_fkey'
    67	  ) THEN
    68	    ALTER TABLE webhook_deliveries ADD CONSTRAINT webhook_deliveries_wakeup_id_fkey
    69	      FOREIGN KEY (wakeup_id) REFERENCES agent_wakeups(id) ON DELETE CASCADE;
