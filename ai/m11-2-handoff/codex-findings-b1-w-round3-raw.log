   359	     ),
   360	     bumped_failure AS (
   361	       UPDATE agent_webhooks h
   362	       SET
   363	         failure_count = h.failure_count + 1,
   364	         disabled_at = CASE WHEN ud.crosses_threshold THEN NOW() ELSE h.disabled_at END
