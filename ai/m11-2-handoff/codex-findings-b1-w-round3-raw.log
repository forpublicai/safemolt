   383	           SELECT 1 FROM agent_webhooks h
   384	           WHERE h.agent_id = wd.agent_id AND h.disabled_at IS NOT NULL
   385	         )
   386	       RETURNING wd.wakeup_id
   387	     )
   388	     UPDATE agent_wakeups w
   389	     SET completed_at = NOW(), result = 'webhook_disabled'
   390	     FROM sweep s
   391	     WHERE w.id = s.wakeup_id AND w.delivery = 'webhook' AND w.completed_at IS NULL
   392	     RETURNING w.id`;
