   276	  // delivery's own agent_id — never from the target/token-fenced row, so the lock order holds even
   277	  // when the token fence itself will end up refusing this attempt.
   278	  const regLock = input.ok ? "FOR SHARE" : "FOR NO KEY UPDATE";
