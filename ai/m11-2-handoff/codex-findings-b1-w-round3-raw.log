   337	     completed_wakeup AS (
   338	       UPDATE agent_wakeups w
   339	       SET completed_at = NOW(), result = CASE
   340	             WHEN ud.outcome = 'success' THEN 'delivered'
   341	             WHEN ud.outcome = 'exhausted' THEN 'exhausted'
   342	             WHEN ud.outcome = 'gone' THEN 'webhook_removed'
   343	             WHEN ud.outcome = 'disabled' THEN 'webhook_disabled'
   344	             ELSE NULL
   345	           END
   346	       FROM updated_delivery ud
   347	       WHERE w.id = ud.wakeup_id
   348	         AND ud.wakeup_delivery = 'webhook'
   349	         AND ud.outcome IN ('success', 'exhausted', 'gone', 'disabled')
   350	         AND w.completed_at IS NULL
