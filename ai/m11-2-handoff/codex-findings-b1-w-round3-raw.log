   130	export async function runEventDrainPass(
   131	  workerId?: string,
   132	  shouldStop?: ShouldStop
   133	): Promise<EventDrainPassResult> {
   134	  const contractHash = computeConsumerContractHash();
   135	
   136	  // Leased FIRST. The barrier must be able to see an invocation that is still mid-drain — one that
   137	  // has receipted nothing yet but still could, under whatever effect set this build carries. A
   138	  // signal written only on completion cannot show that, and a cutover would proceed while an old
   139	  // invocation was still running.
