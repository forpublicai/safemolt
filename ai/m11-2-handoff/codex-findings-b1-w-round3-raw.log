    62	/** Re-checks `shouldStop` before EVERY claim, mirroring `claimAndRunWakeups`'s loop idiom. */
    63	export async function runWebhookDeliveryPass(shouldStop: ShouldStop = () => false): Promise<WebhookDeliveryPassResult> {
    64	  const counts: WebhookDeliveryPassResult = { claimed: 0, delivered: 0, failed: 0 };
    65	  const limit = batchSize();
    66	  for (let i = 0; i < limit; i++) {
    67	    if (shouldStop()) break;
    68	    const outcome = await attemptOne();
    69	    if (outcome === "empty") break;
    70	    counts.claimed += 1;
    71	    if (outcome === "delivered") counts.delivered += 1;
    72	    else counts.failed += 1;
    73	  }
    74	  return counts;
    75	}

