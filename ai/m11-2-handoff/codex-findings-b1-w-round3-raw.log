   304	         (r.failure_count + 1 >= 10) AS crosses_threshold
   305	       FROM target t
   306	       LEFT JOIN reg r ON r.agent_id = t.agent_id
   307	     ),
   308	     updated_delivery AS (
   309	       UPDATE webhook_deliveries wd
   310	       SET
   311	         attempts = wd.attempts + 1,
   312	         last_status = $4::int,
   313	         last_attempt_at = NOW(),
   314	         delivered_at = CASE WHEN o.outcome = 'success' THEN NOW() ELSE wd.delivered_at END,
   315	         terminal_reason = CASE
   316	           WHEN o.outcome = 'success' THEN 'delivered'
   317	           WHEN o.outcome = 'gone' THEN 'webhook_removed'
   318	           WHEN o.outcome = 'disabled' THEN 'webhook_disabled'
   319	           WHEN o.outcome = 'exhausted' THEN 'exhausted'
   320	           ELSE NULL
   321	         END,
   322	         next_attempt_at = CASE
   323	           WHEN o.outcome = 'retry' THEN NOW() + (
   324	             CASE WHEN o.attempts + 1 <= 1 THEN interval '1 minute'
   325	                  WHEN o.attempts + 1 = 2 THEN interval '10 minutes'
   326	                  ELSE interval '60 minutes' END
   327	           )
   328	           ELSE wd.next_attempt_at
   329	         END,
   330	         claimed_at = CASE WHEN o.outcome = 'retry' THEN NULL ELSE wd.claimed_at END,
   331	         claim_token = CASE WHEN o.outcome = 'retry' THEN NULL ELSE wd.claim_token END,
   332	         lease_expires_at = CASE WHEN o.outcome = 'retry' THEN NULL ELSE wd.lease_expires_at END
   333	       FROM outcome o
   334	       WHERE wd.id = o.id
