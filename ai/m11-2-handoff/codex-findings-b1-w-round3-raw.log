   175	    `WITH cand AS (
   176	       SELECT wd.id
   177	       FROM webhook_deliveries wd
   178	       WHERE wd.terminal_reason IS NULL
   179	         AND (wd.claimed_at IS NULL OR wd.lease_expires_at < NOW())
   180	         AND wd.next_attempt_at <= NOW()
   181	       ORDER BY wd.next_attempt_at
   182	       LIMIT 1
