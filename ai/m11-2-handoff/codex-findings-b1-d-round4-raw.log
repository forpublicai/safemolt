   341	describe("send-vs-block linearization — staged so the FIFO queue's order is the PREDETERMINED outcome", () => {
   342	  /**
   343	   * Which one is staged first now DECIDES the outcome, rather than describing it after the fact:
   344	   * a send staged before the block still sees the flag unset (the block commits after) and a send
   345	   * staged after an already-committed block sees it set. Both operation orders, both directions —
   346	   * four deterministic cases replacing the two response-order-branching ones (codex round 3, F2).
   347	   */
   348	  async function raceSendAgainstBlock(
   349	    order: "send-first" | "block-first",
   350	    sendArgs: Parameters<typeof sendDm>[0],
   351	    blockerId: string,
   352	    targetId: string
   353	  ): Promise<{ sendOutcome: SendDmOutcome; blockChanged: boolean }> {
   354	    const { agentLow, agentHigh } = canonicalPair(sendArgs.senderId, sendArgs.recipientId);
   355	    // The pair row must exist before a raw connection can lock it.
   356	    await seedConversation(sendArgs.senderId, sendArgs.recipientId);
   357	
   358	    const send = () => sendDm(sendArgs);
   359	    const block = () => setDmBlock(blockerId, targetId, true);
   360	    const { firstResult, secondResult } =
   361	      order === "send-first" ? await stageRace(agentLow, agentHigh, send, block) : await stageRace(agentLow, agentHigh, block, send);
   362	
   363	    return order === "send-first"
   364	      ? { sendOutcome: firstResult as SendDmOutcome, blockChanged: secondResult as boolean }
   365	      : { sendOutcome: secondResult as SendDmOutcome, blockChanged: firstResult as boolean };
   366	  }
