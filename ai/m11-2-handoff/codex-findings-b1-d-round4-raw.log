   436	describe("mark-read racing a held send — a real held-lock barrier", () => {
   437	  /**
   438	   * `markDmRead` is queued FIRST (confirmed via `waitForWaiterCount` before the send even starts),
   439	   * so Postgres's FIFO row-lock queue grants it before the send — deterministic, not a guess: the
   440	   * cursor is set from `last_message_seq` as it stood BEFORE the send's `bumped` CTE committed, so
   441	   * the still-in-flight message must stay unread (codex round 2, F2 — replaces a same-sender burst
   442	   * that raced its OWN cooldown, since a rate-limited attempt resolving early proved nothing).
   443	   */
   444	  it("a read granted before a held send commits does not count the in-flight message as read", async () => {
   445	    const a = await seedAgent();
   446	    const b = await seedAgent();
   447	    // One message the reader has already seen, so the cursor starts above zero. Cleared after: the
   448	    // held send below is from the SAME sender, and DMs share the per-sender comment cooldown.
   449	    expect((await sendDm({ senderId: a.id, recipientId: b.id, content: "seen" })).outcome).toBe("inserted");
   450	    expect(await markDmRead(b.id, a.id)).toBe(true);
   451	    await clearRateWindow(a.id);
   452	
   453	    const { agentLow, agentHigh } = canonicalPair(a.id, b.id);
   454	    const { pRead, pSend, firstCount, secondCount } = await withHeldPairRow(agentLow, agentHigh, async () => {
   455	      const read = markDmRead(b.id, a.id);
   456	      const first = await waitForBlockedCount(1);
   457	      const send = sendDm({ senderId: a.id, recipientId: b.id, content: "still in flight" });
   458	      const second = await waitForBlockedCount(2);
   459	      return { pRead: read, pSend: send, firstCount: first, secondCount: second };
   460	    });
   461	    expect(firstCount).toBeGreaterThanOrEqual(1);
   462	    expect(secondCount).toBeGreaterThanOrEqual(2);
   463	
   464	    const [readResult, sendResult] = await Promise.all([pRead, pSend]);
   465	    expect(readResult).toBe(true);
   466	    expect(sendResult.outcome).toBe("inserted");
   467	
   468	    // The read's cursor predates the send's commit — the new message is excluded, not "stranded".
   469	    expect(await countUnreadDms(b.id)).toBe(1);
   470	  });
   471	});
