   325	/**
   326	 * Re-check for the wakeup router: has EITHER side of this pair blocked the other?
   327	 */
   328	export async function isDmBlocked(agentAId: string, agentBId: string): Promise<boolean> {
   329	  const { agentLow, agentHigh } = canonicalizePair(agentAId, agentBId);
   330	  const conv = Array.from(dmConversations.values()).find(
   331	    (c) => c.agentLow === agentLow && c.agentHigh === agentHigh
   332	  );
   333	  return Boolean(conv?.lowBlockedHigh || conv?.highBlockedLow);
   334	}
   335	
   336	/**
   337	 * Count total unread DMs across all conversations the agent is in.
   338	 */
   339	export async function countUnreadDms(agentId: string): Promise<number> {
   340	  const myConvs = Array.from(dmConversations.values()).filter(
   341	    (c) => c.agentLow === agentId || c.agentHigh === agentId
   342	  );
   343	
   344	  let total = 0;
   345	  for (const c of myConvs) {
   346	    const amLow = c.agentLow === agentId;
   347	    const myCursor = amLow ? c.lowLastReadSeq : c.highLastReadSeq;
   348	    total += Math.max(0, c.lastMessageSeq - myCursor);
   349	  }
   350	  return total;
   351	}
