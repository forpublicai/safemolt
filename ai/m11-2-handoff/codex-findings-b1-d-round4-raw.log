   383	/**
   384	 * A thread's messages, paginated by `seq DESC`. Isolation is structural, not a checked guard:
   385	 * the query is always scoped to `(agentId, otherId)`'s own canonicalized pair, so there is no
   386	 * conversation id a caller could pass to reach a pair they are not part of.
   387	 */
   388	export async function listDmMessages(
   389	  agentId: string,
   390	  otherId: string,
   391	  options: { limit?: number; beforeSeq?: number } = {}
   392	): Promise<StoredDmMessage[]> {
   393	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   394	  const limit = options.limit ?? 50;
   395	  const beforeSeq = options.beforeSeq ?? null;
   396	  const rows = await sql!`
   397	    SELECT m.id, m.conversation_id, m.seq, m.sender_agent_id, m.content, m.created_at
   398	    FROM dm_messages m
   399	    JOIN dm_conversations c ON c.id = m.conversation_id
   400	    WHERE c.agent_low = ${agentLow} AND c.agent_high = ${agentHigh}
   401	      AND (${beforeSeq}::bigint IS NULL OR m.seq < ${beforeSeq}::bigint)
   402	    ORDER BY m.seq DESC
   403	    LIMIT ${limit}
   404	  `;
   405	  return (rows as Record<string, unknown>[]).map(rowToDmMessage);
   406	}
   407	
   408	/** Re-check for the wakeup router (a block committing after the send must still suppress the wakeup). */
   409	export async function isDmBlocked(agentAId: string, agentBId: string): Promise<boolean> {
   410	  const { agentLow, agentHigh } = canonicalizePair(agentAId, agentBId);
   411	  const rows = await sql!`
   412	    SELECT low_blocked_high, high_blocked_low FROM dm_conversations
   413	    WHERE agent_low = ${agentLow} AND agent_high = ${agentHigh}
   414	  `;
   415	  const row = rows[0] as { low_blocked_high?: boolean; high_blocked_low?: boolean } | undefined;
   416	  return Boolean(row?.low_blocked_high || row?.high_blocked_low);
   417	}
   418	
   419	/** Total unread across every conversation the agent is in. */
   420	export async function countUnreadDms(agentId: string): Promise<number> {
   421	  const rows = await sql!`
   422	    SELECT COALESCE(SUM(
   423	      CASE WHEN agent_low = ${agentId} THEN last_message_seq - low_last_read_seq
   424	           ELSE last_message_seq - high_last_read_seq END
   425	    ), 0)::int AS unread
   426	    FROM dm_conversations
   427	    WHERE agent_low = ${agentId} OR agent_high = ${agentId}
   428	  `;
   429	  return Number((rows[0] as { unread?: number } | undefined)?.unread ?? 0);
   430	}

