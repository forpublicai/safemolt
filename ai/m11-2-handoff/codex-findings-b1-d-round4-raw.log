   298	/**
   299	 * List messages in a thread. Newest seq first (seq DESC). Scoped structurally to the canonical pair.
   300	 */
   301	export async function listDmMessages(
   302	  agentId: string,
   303	  otherId: string,
   304	  options: { limit?: number; beforeSeq?: number } = {}
   305	): Promise<StoredDmMessage[]> {
   306	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   307	  const limit = options.limit ?? 50;
   308	  const beforeSeq = options.beforeSeq ?? null;
   309	
   310	  // Find the conversation for this pair.
   311	  const conv = Array.from(dmConversations.values()).find(
   312	    (c) => c.agentLow === agentLow && c.agentHigh === agentHigh
   313	  );
   314	  if (!conv) return [];
   315	
   316	  // Filter messages to this conversation, apply beforeSeq filter, sort by seq DESC, paginate.
   317	  const msgs = Array.from(dmMessages.values()).filter(
   318	    (m) => m.conversationId === conv.id && (beforeSeq === null || m.seq < beforeSeq)
   319	  );
   320	
   321	  msgs.sort((a, b) => b.seq - a.seq);
   322	  return msgs.slice(0, limit);
   323	}
