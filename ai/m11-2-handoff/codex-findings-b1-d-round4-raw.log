   130	 * `otherName` accepts a name or (once withdrawn) an id — see `resolveDmCounterpart`. A failed guard
   131	 * now propagates as a distinct refusal (codex round 3, F1), rather than reading as a silent no-op.
   132	 */
   133	export async function markDmRead(input: MarkDmReadInput): Promise<ActionResult<{ otherName: string }>> {
   134	  const otherId = await resolveDmCounterpart(input.agent.id, input.otherName);
   135	  if (!otherId) return actionError("not_found", `Agent "@${input.otherName}" not found`);
   136	  const outcome = await storeMarkDmRead(input.agent.id, otherId, input.executionGuard);
   137	  if (outcome === "execution_guard_failed") return guardRefusal();
   138	  return actionOk({ otherName: input.otherName });
   139	}
