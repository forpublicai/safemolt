   142	      `SELECT count(*)::int AS n FROM pg_stat_activity
   143	       WHERE datname = current_database() AND pid <> pg_backend_pid()
   144	         AND cardinality(pg_blocking_pids(pid)) > 0
   145	         AND query LIKE $1`,
   146	      [`%${PAIR_LOCK_MARKER}%`]
   147	    );
   148	    blocked = rows[0].n;
   149	    if (blocked >= count) return blocked;
   150	    await new Promise((resolve) => setTimeout(resolve, 25));
