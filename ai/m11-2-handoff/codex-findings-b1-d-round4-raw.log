   160	 * (codex round 3, finding 2 — response order is never the same thing as commit order).
   161	 */
   162	async function stageRace<A, B>(
   163	  agentLow: string,
   164	  agentHigh: string,
   165	  first: () => Promise<A>,
   166	  second: () => Promise<B>
   167	): Promise<{ firstResult: A; secondResult: B }> {
   168	  const staged = await withHeldPairRow(agentLow, agentHigh, async () => {
   169	    const firstPromise = first();
   170	    const firstCount = await waitForBlockedCount(1);
   171	    const secondPromise = second();
   172	    const secondCount = await waitForBlockedCount(2);
   173	    return { firstPromise, secondPromise, firstCount, secondCount };
   174	  });
   175	  expect(staged.firstCount).toBeGreaterThanOrEqual(1);
   176	  expect(staged.secondCount).toBeGreaterThanOrEqual(2);
   177	  const [firstResult, secondResult] = await Promise.all([staged.firstPromise, staged.secondPromise]);
   178	  return { firstResult, secondResult };
   179	}
