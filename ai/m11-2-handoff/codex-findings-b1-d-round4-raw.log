   141	export interface BlockAgentInput {
   142	  agent: StoredAgent;
   143	  targetName: string;
   144	  /** M11-2 P3.3: populated ONLY by `agent-pulse/runner.ts` (codex round 2, F1). */
   145	  executionGuard?: ExecutionGuard;
   146	}
   147	
   148	function blockEvent(kind: "dm.blocked" | "dm.unblocked", blockerId: string, targetId: string): PreparedEvent {
   149	  return {
   150	    kind,
   151	    actorAgentId: blockerId,
   152	    subjectType: "dm_conversation",
   153	    subjectId: STORE_ASSIGNED_PAYLOAD_ID,
   154	    secondarySubjectId: targetId,
   155	    schoolId: null,
   156	    payload: { conversation_id: STORE_ASSIGNED_PAYLOAD_ID, target_agent_id: targetId },
   157	  };
   158	}
   159	
   160	/**
   161	 * Block a target (name or id — see `resolveDmCounterpart`). A failed guard is now a distinct
   162	 * refusal (codex round 3, F1), never the same `actionOk` an already-blocked no-op would answer.
   163	 */
   164	export async function blockAgent(input: BlockAgentInput): Promise<ActionResult<{ targetName: string }>> {
   165	  const targetId = await resolveDmCounterpart(input.agent.id, input.targetName);
   166	  if (!targetId) return actionError("not_found", `Agent "@${input.targetName}" not found`);
   167	  if (targetId === input.agent.id) return actionError("bad_request", "Cannot block yourself");
   168	
   169	  const outcome = await storeSetDmBlock(
   170	    input.agent.id,
   171	    targetId,
   172	    true,
   173	    [blockEvent("dm.blocked", input.agent.id, targetId)],
   174	    input.executionGuard
   175	  );
   176	  if (outcome === "execution_guard_failed") return guardRefusal();
   177	  return actionOk({ targetName: input.targetName });
   178	}
   179	
   180	export interface UnblockAgentInput {
   181	  agent: StoredAgent;
   182	  targetName: string;
   183	  /** M11-2 P3.3: populated ONLY by `agent-pulse/runner.ts` (codex round 2, F1). */
   184	  executionGuard?: ExecutionGuard;
   185	}
   186	
   187	/** Unblock a target (name or id), mirroring `blockAgent`'s guard handling (no self-check needed). */
   188	export async function unblockAgent(input: UnblockAgentInput): Promise<ActionResult<{ targetName: string }>> {
   189	  const targetId = await resolveDmCounterpart(input.agent.id, input.targetName);
   190	  if (!targetId) return actionError("not_found", `Agent "@${input.targetName}" not found`);
   191	
   192	  const outcome = await storeSetDmBlock(
   193	    input.agent.id,
   194	    targetId,
   195	    false,
   196	    [blockEvent("dm.unblocked", input.agent.id, targetId)],
   197	    input.executionGuard
   198	  );
   199	  if (outcome === "execution_guard_failed") return guardRefusal();
