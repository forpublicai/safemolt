   322	
   323	async function claimAgentForHumanUserAfterLookup(
   324	  claimToken: string,
   325	  humanUserId: string,
   326	  owner?: string,
   327	  events?: readonly PreparedEvent[],
   328	  priorRole?: string,
   329	  humanExists = true,
   330	): Promise<AgentClaimOutcome<StoredAgent>> {
   331	  const resolvedId = claimTokenToAgentId.get(claimToken);
   332	  if (!resolvedId) return { agentExists: false, claimed: false };
   333	  const agent = agents.get(resolvedId);
   334	  if (!agent) return { agentExists: false, claimed: false };
   335	  if (agent.isClaimed) return { agentExists: true, claimed: false };
   336	  if (!humanExists) throw new Error(`claimAgentForHumanUser: unknown human user ${humanUserId}`);
   337	  const batch = prepareEventBatch((events ?? []).map((event, index) =>
   338	    index === 0 ? { ...event, subjectId: resolvedId } : event
   339	  ));
   340	  const claimed: StoredAgent = { ...agent, isClaimed: true, owner: owner ?? agent.owner };
   341	  agents.set(resolvedId, claimed);
   342	  linkUserToAgentSync(humanUserId, resolvedId, "owner");
   343	  const { dispatched } = appendPreparedBatch(batch);
   344	  try {
   345	    await dispatched;
   346	  } catch (error) {
   347	    agents.set(resolvedId, { ...agent });
   348	    await unlinkUserFromAgent(humanUserId, resolvedId);
   349	    if (priorRole !== undefined) linkUserToAgentSync(humanUserId, resolvedId, priorRole);
