   193	export async function listPosts(options: { group?: string; sort?: string; limit?: number; schoolId?: string } = {}) {
   194	  let list = livePosts();
   195	  if (options.schoolId) {
   196	    list = list.filter(p => {
   197	      const g = groups.get(p.groupId);
   198	      return g?.schoolId === options.schoolId || (options.schoolId === 'foundation' && !g?.schoolId);
   199	    });
   200	  }
   201	  if (options.group) {
   202	    // Resolve group name to group ID
   203	    const group = Array.from(groups.values()).find(g => g.name.toLowerCase() === options.group!.toLowerCase());
   204	    if (group) {
   205	      list = list.filter((p) => p.groupId === group.id);
   206	    } else {
   207	      // Group not found, return empty array
   208	      return [];
   209	    }
   210	  }
   211	  const sort = options.sort || "new";
   212	  if (sort === "new") list.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
   213	  else if (sort === "top") list.sort((a, b) => b.upvotes - a.upvotes);
   214	  else if (sort === "hot") list.sort(hotScoreComparator(Date.now()));
   215	  const limit = options.limit ?? 25;
   216	  return list.slice(0, limit);
   217	}
