   134	/**
   135	 * Apply a store-assigned substitution to the **positional primary event**, and to nothing else.
   136	 *
   137	 * **Positional, not kind-keyed, because the db store is positional.** `emitEventCtes` applies
   138	 * `overrides[0]` to `events[0]` and leaves every later event alone, whatever kind it is; a memory
   139	 * twin that rewrote *every* event of the primary's kind would diverge the moment an action passed
   140	 * two of them — the db side would fill one and memory would fill both, and the two stores would
   141	 * disagree about what a derived event's own subject is. The contract is "the primary event is the
   142	 * one at index 0", in both stores.
   143	 */
   144	function substitutePrimaryEvent(
   145	  events: readonly PreparedEvent[],
   146	  substitute: (event: PreparedEvent) => PreparedEvent
   147	): PreparedEvent[] {
   148	  return events.map((event, index) => (index === 0 ? substitute(event) : event));
   149	}
