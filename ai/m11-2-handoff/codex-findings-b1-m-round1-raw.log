   698	        const trimmed = updates.name.trim();
   699	        if (trimmed) await sql!`UPDATE agents SET name = ${trimmed} WHERE id = ${agentId}`;
   700	    }
   701	    if (updates.description !== undefined)
   702	        await sql!`UPDATE agents SET description = ${updates.description} WHERE id = ${agentId}`;
