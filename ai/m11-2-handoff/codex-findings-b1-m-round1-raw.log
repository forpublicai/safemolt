     8	/** Raw SQL for `ORDER BY`. `nowPlaceholder` is the caller's own `$N` for `now`; `colPrefix` is an
     9	 * optional table alias (e.g. `"p."`) for call sites that join. */
    10	export function hotScoreOrderBy(nowPlaceholder: string, colPrefix: string = ""): string {
