   708	/**
   709	 * Merge a metadata delta **inside the statement**.
   710	 *
   711	 * An application-level merge cannot be correct here. Every writer used to read the agent, spread
   712	 * the whole metadata object, and hand the entire result to `updateAgent`, which wrote it verbatim
   713	 * — so a write that read old metadata, lost a race to a credential write, and then wrote its stale
   714	 * copy back would silently revoke the credential. Doing the merge in SQL closes that from every
   715	 * side at once, which is why every platform writer converts, not just the caller-facing PATCH.
   716	 *
   717	 * The `COALESCE` is load-bearing, not decoration: `agents.metadata` is nullable and Postgres's
   718	 * `||` is strict, so a bare `agents.metadata || $delta` yields **NULL** for every agent that has
   719	 * never had metadata — the update would silently erase the write it was asked to make.
   720	 */
   800	              ]
   801	            : [],
   802	    });
   803	
   804	    const rows = await sql!(
   805	        `
   806	    WITH prior AS (
   807	      SELECT * FROM agents WHERE id = $1::text FOR NO KEY UPDATE
   808	    ),
   809	    updated AS (
   810	      UPDATE agents a
   811	      SET description  = CASE WHEN $2::boolean THEN $3::text ELSE a.description END,
   812	          display_name = CASE WHEN $4::boolean THEN NULLIF(BTRIM($5::text), '') ELSE a.display_name END,
   813	          metadata     = CASE WHEN $6::boolean THEN COALESCE(a.metadata, '{}'::jsonb) || $7::jsonb
   814	                              ELSE a.metadata END
   815	      FROM prior p
   816	      WHERE a.id = p.id
   817	        AND (
   818	          ($2::boolean AND p.description IS DISTINCT FROM $3::text)
   819	          OR ($4::boolean AND p.display_name IS DISTINCT FROM NULLIF(BTRIM($5::text), ''))
   820	          OR ($6::boolean AND p.metadata IS DISTINCT FROM (COALESCE(p.metadata, '{}'::jsonb) || $7::jsonb))
   821	        )
   822	      RETURNING a.*
   823	    ),
   824	    moved AS (
   825	      SELECT f.field
   826	      FROM updated u JOIN prior p ON p.id = u.id
   827	      CROSS JOIN LATERAL (VALUES
   828	        ('description', u.description IS DISTINCT FROM p.description),
   829	        ('display_name', u.display_name IS DISTINCT FROM p.display_name),
   830	        ('metadata', u.metadata IS DISTINCT FROM p.metadata)
   831	      ) AS f(field, changed)
   832	      WHERE f.changed
   833	    )${emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : ""}
   834	    SELECT (SELECT to_jsonb(u) FROM updated u) AS updated_row,
   835	           (SELECT to_jsonb(p) FROM prior p) AS prior_row,
   836	           (SELECT COALESCE(jsonb_agg(field ORDER BY field), '[]'::jsonb) FROM moved) AS changed_fields
   837	  `,
   838	        [...params, ...emitted.params]
   839	    );
   840	
   841	    const row = (rows[0] ?? {}) as {
   842	        updated_row?: Record<string, unknown> | null;
   843	        prior_row?: Record<string, unknown> | null;
   844	        changed_fields?: string[] | null;
   845	    };
   846	    const written = row.updated_row ?? row.prior_row ?? null;
   847	    return {
   848	        agent: written ? rowToAgent(written) : null,
   849	        changedFields: row.updated_row ? (row.changed_fields ?? []) : [],
   850	    };
   851	}
