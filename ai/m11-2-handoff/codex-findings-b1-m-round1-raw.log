   342	    const rows = await sql!(
   343	        `
   344	    WITH claimed AS (
   345	      UPDATE agents
   346	      SET is_claimed = true,
   347	          owner = COALESCE($2::text, owner),
   348	          x_follower_count = COALESCE($3::int, x_follower_count)
   349	      WHERE id = $1::text AND is_claimed = false
   350	      RETURNING id
   351	    )${emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : ""}
   352	    SELECT id FROM claimed
   353	  `,
   354	        [...params, ...emitted.params]
   355	    );
   356	    return rows.length > 0;
   357	}
