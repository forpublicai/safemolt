+ */
+const WEBHOOK_DISABLED_NOTIFICATION_SELECT = `
+      SELECT $1::text, target.id, 'webhook_disabled'::text, 'normal'::text, $4::timestamptz, NULL::timestamptz,
+        '{"id":"system","name":"SafeMolt"}'::jsonb,
