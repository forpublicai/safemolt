   643	/**
   644	 * Canonical JSON, so a metadata comparison agrees with `jsonb`'s.
   645	 *
   646	 * Postgres compares `jsonb` structurally and key-order-independently, so `{"a":1,"b":2}` and
   647	 * `{"b":2,"a":1}` are the SAME value there. A bare `JSON.stringify` disagrees, and the disagreement
   648	 * shows up exactly where it matters: a delta that reorders a nested object would be "no change" in
   649	 * the db store and "changed" here — one store emitting an event the other does not.
   650	 */
   651	function canonicalJson(value: unknown): string {
   652	    if (Array.isArray(value)) return `[${value.map(canonicalJson).join(",")}]`;
   653	    if (value && typeof value === "object") {
   654	        const entries = Object.entries(value as Record<string, unknown>)
   655	            .filter(([, v]) => v !== undefined)
   656	            .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0));
   657	        return `{${entries.map(([k, v]) => `${JSON.stringify(k)}:${canonicalJson(v)}`).join(",")}}`;
   658	    }
   659	    return JSON.stringify(value ?? null);
   660	}
