   337	    const params: unknown[] = [id, owner ?? null, xFollowerCount ?? null];
   338	    // Gated on the conditional claim: a second claimant matches zero rows, writes nothing, emits
   339	    // nothing. The subject is the agent, which the caller resolved from the claim token — no
   340	    // substitution is needed, unlike the Cognito path, whose statement resolves the token itself.
