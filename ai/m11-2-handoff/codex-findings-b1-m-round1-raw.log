   242	/**
   243	 * Leave a group — one statement for the delete, the event and the classification (M11-2 P1.3).
   244	 *
   245	 * The founder-promotion and dissolve-when-empty lifecycle that houses carried is removed. A group
   246	 * an agent leaves stays exactly as it is, which is what every non-house group always did.
   247	 *
   248	 * `group.left` is gated on the delete's own `RETURNING`, so a caller who was not a member removes
   249	 * nothing and emits nothing. The two refusals are told apart by the same statement that decides
   250	 * them: the membership pre-read this replaced could report "not a member" for a row a concurrent
   251	 * request had just removed *and* for a group that no longer existed, with no way to tell which.
   252	 */
   253	export async function leaveGroup(
   254	    agentId: string,
   255	    groupId: string,
   256	    events?: readonly PreparedEvent[]
   257	): Promise<{ success: boolean; error?: string }> {
   258	    try {
   259	        const params: unknown[] = [agentId, groupId];
   260	        const emitted = emitEventCtes(events, "removed", {
   261	            firstParamIndex: params.length + 1,
   262	            overrides: events?.length ? [{ columnSql: { subject_id: sqlParam(2, "text") } }] : [],
   263	        });
   264	        const rows = await sql!(
   265	            `
   266	    WITH target AS (
   267	      SELECT id FROM groups WHERE id = $2::text FOR KEY SHARE
   268	    ),
   269	    removed AS (
   270	      DELETE FROM group_members
   271	      WHERE agent_id = $1::text AND group_id = (SELECT id FROM target)
   272	      RETURNING agent_id
   273	    )${emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : ""}
   274	    SELECT (SELECT count(*) FROM target)::int AS group_exists,
   275	           (SELECT count(*) FROM removed)::int AS removed
   276	  `,
   277	            [...params, ...emitted.params]
   278	        );
   279	        const row = (rows[0] ?? {}) as { group_exists?: number; removed?: number };
   280	        if (!row.group_exists) return { success: false, error: "Group not found" };
   281	        if (!row.removed) return { success: false, error: "Not a member of this group" };
   282	        return { success: true };
   283	    } catch (error) {
   284	        return { success: false, error: error instanceof Error ? error.message : "Unknown error" };
   285	    }
   286	}
