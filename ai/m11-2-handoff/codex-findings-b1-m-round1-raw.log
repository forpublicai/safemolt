   269	/**
   270	 * Authenticate by api key and stamp `last_active_at` in **one** statement.
   271	 *
   272	 * The predicate above treats `last_active_at IS NULL` as "never authenticated", so authentication
   273	 * and cleanup contend on exactly that column. Reading the agent and then touching it — two
   274	 * statements, as `getAgentFromRequest` used to do — leaves a window where a brand-new agent's very
   275	 * first authenticated request reads its row, loses to a concurrent same-name registration's
   276	 * cleanup, and has its touch land on zero rows: destroyed *after* it authenticated, which is the
   277	 * one outcome C4 promises cannot happen. One statement makes the two serialize on the row.
   278	 *
   279	 * The fast path is a plain `SELECT`: the write only has to happen when the stamp is actually
   280	 * stale, and a fresh agent is by definition not the one at risk.
   281	 */
   282	export async function authenticateAndTouchByApiKey(
   283	    apiKey: string,
   284	    staleAfterMs = 5 * 60 * 1000
   285	): Promise<StoredAgent | null> {
   286	    try {
   287	        const staleSeconds = Math.ceil(staleAfterMs / 1000);
   288	        const updated = await sql!`
   289	      UPDATE agents
   290	      SET last_active_at = NOW()
   291	      WHERE api_key = ${apiKey}
   292	        AND (
   293	          last_active_at IS NULL
   294	          OR last_active_at < NOW() - make_interval(secs => ${staleSeconds})
   295	        )
   296	      RETURNING *
   297	    `;
   298	        const touched = updated[0] as Record<string, unknown> | undefined;
   299	        if (touched) return rowToAgent(touched);
   300	
   301	        // Zero rows means either "no such key" or "stamp is fresh"; only a read tells them apart.
   302	        const rows = await sql!`SELECT * FROM agents WHERE api_key = ${apiKey} LIMIT 1`;
   303	        const r = rows[0] as Record<string, unknown> | undefined;
   304	        if (!r) {
   305	            const maskedKey = apiKey ? `${apiKey.slice(0, 12)}...${apiKey.slice(-4)}` : "empty";
   306	            console.log(`[Auth] No agent found for key: ${maskedKey}`);
   307	        }
   308	        return r ? rowToAgent(r) : null;
   309	    } catch (error) {
   310	        console.error("[Auth] Database error in authenticateAndTouchByApiKey:", error);
   311	        return null;
   312	    }
   313	}
