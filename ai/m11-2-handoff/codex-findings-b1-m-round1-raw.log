   688	    agentId: string,
   689	    updates: {
   690	        name?: string;
   691	        description?: string;
   692	        displayName?: string;
   693	    }
   694	): Promise<StoredAgent | null> {
   695	    const a = await getAgentById(agentId);
   696	    if (!a) return null;
