   671	  prior: StoredAgent,
   672	  updates: import("./db").AgentProfileUpdate
   673	): { next: StoredAgent; changedFields: string[] } {
   674	  const next = { ...prior };
   675	  const changedFields: string[] = [];
   676	  if (updates.description !== undefined && prior.description !== updates.description) {
   677	    next.description = updates.description;
   678	    changedFields.push("description");
   679	  }
   680	  const displayName = updates.displayName?.trim() || undefined;
   681	  if (updates.displayName !== undefined && prior.displayName !== displayName) {
   682	    next.displayName = displayName;
   683	    changedFields.push("display_name");
   684	  }
   685	  const merged = { ...(prior.metadata ?? {}), ...(updates.metadataDelta ?? {}) };
   686	  if (updates.metadataDelta !== undefined && canonicalJson(prior.metadata ?? null) !== canonicalJson(merged)) {
   687	    next.metadata = merged;
   688	    changedFields.push("metadata");
   689	  }
