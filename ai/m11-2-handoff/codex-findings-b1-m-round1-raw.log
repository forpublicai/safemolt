     1	import { NextRequest } from "next/server";
     2	import { requireAgent, checkRateLimitAndRespond } from "@/lib/auth";
     3	import { listFeed, listPosts, getAgentById, getGroup, isGroupMember, getGroupMemberCount, getReactionCounts } from "@/lib/store";
     4	import { jsonResponse, errorResponse } from "@/lib/auth";
     5	import { isTestContent } from "@/lib/test-content";
     6	
     7	export async function GET(request: NextRequest) {
     8	  try {
     9	    const access = await requireAgent(request);
    10	    if (!access.ok) return access.response;
    11	    const agent = access.agent;
    12	    const rateLimitResponse = checkRateLimitAndRespond(agent);
    13	    if (rateLimitResponse) return rateLimitResponse;
    14	    const sort = request.nextUrl.searchParams.get("sort") || "hot";
    15	    const limit = Math.min(50, parseInt(request.nextUrl.searchParams.get("limit") || "25", 10) || 25);
    16	    // Over-fetch slightly so explicit test-content filtering does not leave the
    17	    // page short. Posts and authors with metadata.{test|system}===true or
    18	    // metadata.source==="test" are filtered via the shared predicate.
    19	    const personalized = await listFeed(agent.id, { sort, limit: limit + 25 });
    20	    // Cold start (P4.1's fallback, mirrored here): an agent with no groups and no
    21	    // follows gets the global feed instead of a permanently empty one.
    22	    const usedFallback = personalized.length === 0;
    23	    const list = usedFallback ? await listPosts({ sort, limit: limit + 25 }) : personalized;
    24	    const feedMode: "personalized" | "fallback" = usedFallback ? "fallback" : "personalized";
    25	    const reactionCounts = await getReactionCounts("post", list.map((p) => p.id));
    26	    const dataRaw = await Promise.all(
    27	      list.map(async (p) => {
    28	        const author = await getAgentById(p.authorId);
    29	        const g = await getGroup(p.groupId);
    30	        if (isTestContent(p) || isTestContent(author)) return null;
    31	        return {
    32	          id: p.id,
    33	          title: p.title,
    34	          content: p.content,
    35	          url: p.url,
    36	          author: author ? { name: author.name } : null,
    37	          group: g ? { name: g.name, display_name: g.displayName } : null,
    38	          upvotes: p.upvotes,
    39	          downvotes: p.downvotes,
    40	          reactions: reactionCounts[p.id] ?? {},
    41	          comment_count: p.commentCount,
    42	          created_at: p.createdAt,
    43	        };
    44	      })
    45	    );
    46	    const data = dataRaw.filter((x): x is NonNullable<typeof x> => x !== null).slice(0, limit);
    47	
    48	    // Cold-start hint: if the feed is empty, tell the agent why and how to fix it
    49	    // (UX2: non-silent feed). We surface the suggestion via meta and a top-level
    50	    // `suggestion` alias so old clients see it too.
    51	    if (data.length === 0) {
    52	      const generalGroup = await getGroup("general");
    53	      let emptyReason: "no_memberships" | "no_posts_in_memberships" = "no_memberships";
    54	      let suggestion: { action: string; group: string; hint: string } | null = null;
    55	      if (generalGroup) {
    56	        const alreadyMember = await isGroupMember(agent.id, generalGroup.id);
    57	        if (alreadyMember) {
    58	          const memberCount = await getGroupMemberCount(generalGroup.id);
    59	          emptyReason = "no_posts_in_memberships";
    60	          suggestion = {
    61	            action: "create_post",
    62	            group: generalGroup.name,
    63	            hint: `You are subscribed to '${generalGroup.name}' but no posts match yet (${memberCount} members). Try posting to /api/v1/posts with group="${generalGroup.name}", or follow agents to widen your feed.`,
    64	          };
    65	        } else {
    66	          suggestion = {
    67	            action: "join_group",
    68	            group: generalGroup.name,
    69	            hint: `You are not yet a member of any group. Join '${generalGroup.name}' via POST /api/v1/groups/${generalGroup.name}/join, or follow agents to populate your feed.`,
    70	          };
    71	        }
    72	      }
    73	      return jsonResponse({
    74	        success: true,
    75	        data,
    76	        meta: { count: 0, sort, empty_reason: emptyReason, suggestion, feed_mode: feedMode },
    77	        // Legacy top-level alias so unmigrated clients still receive the hint.
    78	        suggestion,
    79	      });
    80	    }
    81	
    82	    return jsonResponse({
    83	      success: true,
    84	      data,
    85	      meta: { count: data.length, sort, feed_mode: feedMode },
    86	    });
    87	  } catch {
    88	    return errorResponse("Failed to load feed", undefined, 500);
    89	  }
    90	}
