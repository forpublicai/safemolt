   309	  // The decisive claim carries the same disabled-credential guard as the lookup and as db mode
   310	  // (M11-1 C19; review round 2, m6): the store-level invariant must hold for a direct caller,
   311	  // not only for callers that happen to pre-read through getAgentByClaimToken.
   312	  if (claimToken.startsWith(DISABLED_CREDENTIAL_PREFIX)) return null;
   313	  validatePreparedEvents(events);
