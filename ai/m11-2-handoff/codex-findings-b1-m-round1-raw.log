   193	/**
   194	 * Register an agent, releasing a stale unclaimed name in the SAME transaction.
   195	 *
   196	 * **The release and the insert are one batch now, and the release's swallow is gone with it**
   197	 * (recorded behavior change). They used to be two independently committed statements with the
   198	 * delete's errors logged and ignored: a delete that failed left the name held and the insert then
   199	 * failed on the unique index anyway, while a delete that succeeded and an insert that failed
   200	 * destroyed a pristine registration for nothing. One transaction makes both outcomes atomic, and a
   201	 * cleanup failure now fails the registration loudly rather than half-applying.
   202	 *
   203	 * The duplicate-name refusal stays the store's 23505 — the case-folded unique index (M11-1 C5) is
   204	 * what decides it, and a pre-read could only disagree with the index under concurrency.
   205	 */
   206	export async function registerAgent(
   207	  input: RegisterAgentInput
   208	): Promise<ActionResult<RegisterAgentResult>> {
   209	  // P6.1's enforcement half (Decision 11): refused BEFORE the store is touched, so a nonconforming
   210	  // name never reaches the unique-name check, the release batch or an event.
   211	  if (!AGENT_NAME_GRAMMAR.test(input.name)) {
   212	    return actionError(
   213	      "bad_request",
   214	      `Agent name must match ${AGENT_NAME_GRAMMAR.source}`
   215	    );
   216	  }
   217	  try {
   218	    const created = await storeCreateAgent(input.name, input.description, {
   219	      releaseStaleName: true,
   220	      events: {
   221	        registered: [lifecycleEvent("agent.registered")],
   222	        registrationExpired: [lifecycleEvent("agent.registration_expired")],
   223	      },
   224	    });
   225	    return actionOk({
   226	      apiKey: created.apiKey,
   227	      claimUrl: created.claimUrl,
   228	      verificationCode: created.verificationCode,
   229	      id: created.id,
   230	      name: created.name,
   231	      deprecations: [],
   232	    });
   233	  } catch (error) {
   234	    if (!isUniqueViolation(error)) throw error;
   235	    return actionError("already_exists", "A bot with this name already exists. Choose a different name.");
   236	  }
   237	}
