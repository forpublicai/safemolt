   192	/** The INSERT both write paths share, so the column list and the casts have one definition. */
   193	const INSERT_WAKEUP = `
   194	  INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at)
   195	  VALUES ($1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW()))
   196	  ON CONFLICT DO NOTHING
   197	`;
   198	
   199	function insertParams(input: EnqueueWakeupInput | CreateOrReArmWakeupInput): unknown[] {
   200	  return [
   201	    input.agentId,
   202	    input.reason,
   203	    input.eventId,
   204	    JSON.stringify(input.payload ?? {}),
   205	    input.delivery,
   206	    input.dueAt ?? null,
   207	  ];
   208	}
