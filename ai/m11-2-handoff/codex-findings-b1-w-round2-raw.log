    63	/** Re-checks `shouldStop` before EVERY claim, mirroring `claimAndRunWakeups`'s loop idiom. */
    64	export async function runWebhookDeliveryPass(shouldStop: ShouldStop = () => false): Promise<WebhookDeliveryPassResult> {
    65	  const counts: WebhookDeliveryPassResult = { claimed: 0, delivered: 0, failed: 0 };
    66	  const limit = batchSize();
    67	  for (let i = 0; i < limit; i++) {
    68	    if (shouldStop()) break;
    69	    const outcome = await attemptOne();
    70	    if (outcome === "empty") break;
    71	    counts.claimed += 1;
    72	    if (outcome === "delivered") counts.delivered += 1;
    73	    else counts.failed += 1;
    74	  }
    75	  return counts;
    76	}

