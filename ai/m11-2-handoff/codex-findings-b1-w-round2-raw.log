   163	    ? `ON CONFLICT (wakeup_id) DO UPDATE
   164	        SET attempts = 0, delivered_at = NULL, last_status = NULL, last_attempt_at = NULL,
   165	            terminal_reason = NULL, claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL,
   166	            next_attempt_at = NOW()
