   423	export async function getWakeupByAgentReasonEvent(
   424	  agentId: string,
   425	  reason: string,
   426	  eventId: number
   427	): Promise<StoredWakeup | null> {
   428	  const rows = await sql!(
   429	    `SELECT * FROM agent_wakeups
   430	     WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   431	     LIMIT 1`,
   432	    [agentId, reason, eventId]
   433	  );
   434	  return rows.length > 0 ? rowToWakeup(rows[0]) : null;
