   294	export interface CreateOrReArmPlaygroundRoundWakeupInput {
   295	  agentId: string;
   296	  /** ALWAYS non-null — this path is event-keyed dedup only, like `createOrReArmWakeup`. */
   297	  eventId: number;
   298	  payload: Record<string, unknown>;
   299	  delivery: WakeupDelivery;
   300	  dueAt?: string;
   301	  /** The session whose round this wakeup is for — the live-state gate's subject. */
   302	  sessionId: string;
   303	  round: number;
   304	}
   305	
   306	/**
   307	 * The one reason this gated path arms. A constant, not a parameter: the gate below reads playground
   308	 * tables, so the operation is playground-specific by nature, and both callers (the wakeup-router
   309	 * consumer and the deadline sweep) must spell the reason identically or the dedup triple splits.
   310	 */
   311	export const PLAYGROUND_ROUND_REASON = "playground_round";
   312	
   313	/**
   314	 * `createOrReArmWakeup`, but for `playground_round` — with the freshness check INSIDE the statement,
   315	 * under a lock (codex u5-C round 1 MAJOR).
   316	 *
   317	 * Both callers used to pre-read the session (active, `current_round` matches, agent un-acted) and
   318	 * then await other work before inserting. A pre-read that RETURNS competes with the decisive
   319	 * statement and loses (CLAUDE.md): a session advancing to round N+1 in that window let a stale
   320	 * round-N wakeup land beside the legitimate round-N+1 one — two claimable rows for one agent,
   321	 * double budget the moment P3.3's runner exists, because the event-keyed dedup index sees two
   322	 * different event ids.
   323	 *
   324	 * So `live` re-checks the session AND the agent's action at insert time, and takes the session row
   325	 * `FOR SHARE` — never a bare `EXISTS`, which is snapshot-evaluated and never re-checked. The
   326	 * advancement CAS is an `UPDATE` of that same row, so `FOR SHARE` either sees its committed round
   327	 * (and arms nothing) or blocks it until this statement commits (and the CAS then advances a session
   328	 * whose stale-round wakeup was never created). The action `NOT EXISTS` stays unlocked deliberately:
   329	 * a just-acted agent's wakeup is only wasted budget, and `submitAction`'s duplicate-per-round
   330	 * rejection already refuses the turn — the plan frames that check as budget protection, not
   331	 * correctness. Both arms — the insert AND the re-arm — gate on `live`, so a dead round can neither
   332	 * gain a new row nor resurrect a completed one.
   333	 *
   334	 * Lock order is `playground_sessions → agents` (the insert's FK takes `FOR KEY SHARE` on the
   335	 * agent), the same order `submitAction`'s gated insert takes; nothing in the tree takes an agent
   336	 * lock before a session lock, so no cycle is introduced.
   337	 */
   338	export async function createOrReArmPlaygroundRoundWakeup(
   339	  input: CreateOrReArmPlaygroundRoundWakeupInput
   340	): Promise<CreateOrReArmWakeupResult> {
   341	  const rows = await sql!(
   342	    `
   343	    /* p3.2:playground-round-arm */
   344	    WITH live AS (
   345	      SELECT s.id FROM playground_sessions s
   346	      WHERE s.id = $7 AND s.status = 'active' AND s.current_round = $8
   347	        AND NOT EXISTS (
   348	          SELECT 1 FROM playground_actions a
   349	          WHERE a.session_id = s.id AND a.agent_id = $1 AND a.round = $8
   350	        )
   351	      FOR SHARE OF s
   352	    ),
   353	    ins AS (
   354	      INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at)
   355	      SELECT $1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW())
   356	      FROM live
   357	      ON CONFLICT DO NOTHING
   358	      RETURNING *
   359	    ),
   360	    rearmed AS (
   361	      UPDATE agent_wakeups
   362	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   363	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   364	        AND EXISTS (SELECT 1 FROM live)
   365	        AND completed_at IS NOT NULL
   366	        AND result IS DISTINCT FROM 'acted'
   367	        AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   368	      RETURNING *
   369	    ),
   370	    ${webhookLedgerCte(["ins", "rearmed"], "wh", "rearmed")}
   371	    SELECT (SELECT to_jsonb(ins) FROM ins) AS created_row,
   372	           (SELECT to_jsonb(rearmed) FROM rearmed) AS rearmed_row
   373	  `,
   374	    [
   375	      ...insertParams({
   376	        agentId: input.agentId,
   377	        reason: PLAYGROUND_ROUND_REASON,
   378	        eventId: input.eventId,
   379	        payload: input.payload,
   380	        delivery: input.delivery,
   381	        dueAt: input.dueAt,
   382	      }),
   383	      input.sessionId,
   384	      input.round,
   385	    ]
   386	  );
   387	  const row = rows[0] as { created_row: unknown; rearmed_row: unknown } | undefined;
   388	  return {
   389	    created: row?.created_row != null,
   390	    reArmed: row?.rearmed_row != null,
   391	  };
   392	}
