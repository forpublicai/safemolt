   151	  // whether the rest ran at all.
   152	  const drainDeadline = Date.now() + phaseBudget;
   153	  const consumers = await Promise.all(
   154	    eventConsumers.map(async (consumer) =>
   155	      report(consumer.name, await drainEventConsumer(consumer, { batchSize: BATCH_SIZE, deadline: drainDeadline }))
   156	    )
   157	  );
