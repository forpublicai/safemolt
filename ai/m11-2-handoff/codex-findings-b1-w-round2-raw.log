   210	/**
   211	 * Plain insert. Never re-arms — a completed row stays completed.
   212	 *
   213	 * **The bare `ON CONFLICT DO NOTHING` carries no conflict target, and that is deliberate.** Postgres
   214	 * lets a plain `DO NOTHING` absorb a violation of *any* unique or exclusion constraint on the table,
   215	 * and exactly two partial unique indexes can fire here: `idx_wakeups_dedup_event` when `event_id IS
   216	 * NOT NULL`, and `idx_wakeups_dedup_idle` when `event_id IS NULL AND completed_at IS NULL`. Whichever
   217	 * applies to this row is the one that should suppress the insert, and the caller does not have to
   218	 * know which — naming a target would force it to, and would turn the other index's violation into a
   219	 * raised 23505.
   220	 *
   221	 * Note the asymmetry the two indexes encode: the event-keyed one is NOT partial on `completed_at`,
   222	 * so a completed event-keyed row blocks a second insert forever (only a re-arm reuses it), while a
   223	 * completed idle row stops blocking and a fresh idle wakeup may be enqueued again.
   224	 */
   225	export async function enqueueWakeup(input: EnqueueWakeupInput): Promise<EnqueueWakeupResult> {
   226	  const rows = await sql!(
   227	    `WITH ins AS (
   228	      ${INSERT_WAKEUP}
   229	      RETURNING *
   230	    ),
   231	    ${webhookLedgerCte(["ins"])}
   232	    SELECT ins.* FROM ins`,
   233	    insertParams(input)
   234	  );
   235	  if (rows.length === 0) return { created: false, wakeup: null };
   236	  return { created: true, wakeup: rowToWakeup(rows[0]) };
   237	}
   238	
   239	/**
   240	 * Find-or-create-or-re-arm in ONE statement, keyed by the dedup TRIPLE `(agent_id, reason,
   241	 * event_id)` — never by a numeric row id, because the caller does not know one yet.
   242	 *
   243	 * `eventId` is always non-null on this path, so the bare `ON CONFLICT DO NOTHING` in `ins` can only
   244	 * ever match `idx_wakeups_dedup_event`; the idle index cannot apply to a row with an event id.
   245	 *
   246	 * **The two CTEs are mutually exclusive by construction, so this needs no arbiter.** A freshly
   247	 * inserted row has `completed_at IS NULL`, which `rearmed`'s predicate cannot match, so there is no
   248	 * torn state and no deadlock shape for CLAUDE.md's "sibling data-modifying CTEs need an ARBITER"
   249	 * rule to apply to — the only reachable interleaving is the benign one below.
   250	 *
   251	 * **`created: false, reArmed: false` is a LEGITIMATE outcome, not a bug.** Two callers racing this
   252	 * statement for the same triple when no row exists yet — the router and the sweep reacting to one
   253	 * freshly drained `round_opened` — can BOTH answer false/false: the loser's `ins` correctly no-ops
   254	 * against the winner's now-committed row, while its own `rearmed` CTE is evaluated against a
   255	 * statement snapshot taken before that commit and therefore also sees nothing. After both statements
   256	 * complete exactly one row exists — never zero, never two, because the unique index says so — and
   257	 * that is the only invariant a best-effort nudge queue needs. Do NOT add `FOR UPDATE` or any other
   258	 * arbiter to force one caller to "win" and see it: that buys serialization contention for a
   259	 * reporting gap with no correctness payoff. The loser sees the row already in the state it wanted,
   260	 * next pass.
   261	 */
   262	export async function createOrReArmWakeup(
   263	  input: CreateOrReArmWakeupInput
   264	): Promise<CreateOrReArmWakeupResult> {
   265	  const rows = await sql!(
   266	    `
   267	    /* p3.2:create-or-rearm */
   268	    WITH ins AS (
   269	      ${INSERT_WAKEUP}
   270	      RETURNING *
   271	    ),
   272	    rearmed AS (
   273	      UPDATE agent_wakeups
   274	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   275	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   276	        AND completed_at IS NOT NULL
   277	        AND result IS DISTINCT FROM 'acted'
   278	        AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   279	      RETURNING *
   280	    ),
   281	    ${webhookLedgerCte(["ins", "rearmed"], "wh", "rearmed")}
   282	    SELECT (SELECT to_jsonb(ins) FROM ins) AS created_row,
   283	           (SELECT to_jsonb(rearmed) FROM rearmed) AS rearmed_row
   284	  `,
   285	    insertParams(input)
   286	  );
   287	  const row = rows[0] as { created_row: unknown; rearmed_row: unknown } | undefined;
   288	  return {
   289	    created: row?.created_row != null,
   290	    reArmed: row?.rearmed_row != null,
   291	  };
   292	}
