    33	  const envPath = join(__dirname, "..", ".env.local");
    34	  if (!existsSync(envPath)) return;
    35	  const content = readFileSync(envPath, "utf8");
    36	  for (const rawLine of content.split("\n")) {
    37	    const line = rawLine.trim();
    38	    if (!line || line.startsWith("#")) continue;
    39	    const match = line.match(/^([^=]+)=(.*)$/);
    40	    if (!match) continue;
    41	    const key = match[1].trim();
    42	    let value = match[2].trim();
    43	    const quoted = (value.startsWith('"') && value.endsWith('"')) || (value.startsWith("'") && value.endsWith("'"));
    44	    if (quoted) value = value.slice(1, -1);
    45	    if (!process.env[key]) process.env[key] = value;
    46	  }
    47	}
    48	
    49	loadEnvLocalIfNeeded();
    50	
    51	/**
    52	 * The migration-ledger boot check (P3.1). The list itself, and the pure "what's missing" logic, live
    53	 * in `src/lib/worker/migration-ledger.ts` (import-testable; this file is a plain script, not a Jest
    54	 * root). See that module's docs for why the check is a full ledger comparison, not a table probe.
    55	 */
    56	async function checkMigrationLedgerOrExit(): Promise<void> {
    57	  const { checkMigrationLedger, REQUIRED_MIGRATIONS } = await import("@/lib/worker/migration-ledger");
    58	  const result = await checkMigrationLedger();
    59	  if (result.ok) {
    60	    console.log(`[worker] Migration ledger OK (${REQUIRED_MIGRATIONS.length} required migrations recorded).`);
    61	    return;
    62	  }
    63	  if (result.reason === "no_database") {
    64	    console.error("[worker] FATAL: no POSTGRES_URL/DATABASE_URL configured. The worker requires a database.");
    65	  } else {
    66	    console.error(
    67	      `[worker] FATAL: required migration(s) not recorded in _migrations: ${result.missing.join(", ")}. ` +
    68	        "The Vercel deploy that runs `scripts/migrate.js` must complete before this worker starts."
    69	    );
    70	  }
    71	  process.exit(1);
    72	}
    73	
    74	// --- env-tunable intervals --------------------------------------------------------------------
    75	
    76	function envMs(name: string, def: number): number {
    77	  const raw = Number(process.env[name] ?? def);
    78	  return Number.isFinite(raw) && raw > 0 ? raw : def;
    79	}
    80	
    81	const DRAIN_INTERVAL_MS = envMs("WORKER_DRAIN_INTERVAL_MS", 10_000);
    82	const DEADLINE_INTERVAL_MS = envMs("WORKER_DEADLINE_INTERVAL_MS", 60_000);
    83	const WAKEUP_INTERVAL_MS = envMs("WORKER_WAKEUP_INTERVAL_MS", 5_000);
    84	const IDLE_SWEEP_INTERVAL_MS = envMs("WORKER_IDLE_SWEEP_INTERVAL_MS", 60_000);
    85	const WORKER_WEBHOOK_INTERVAL_MS = envMs("WORKER_WEBHOOK_INTERVAL_MS", 5_000);
    86	const SHUTDOWN_GRACE_MS = envMs("WORKER_SHUTDOWN_GRACE_MS", 240_000);
    87	const PORT = Number(process.env.PORT ?? 3001);
    88	
    89	// --- duty scheduling: one flag per duty so a slow pass never overlaps its own next tick ----------
    90	
    91	let shuttingDown = false;
    92	const inFlight = new Set<Promise<unknown>>();
    93	let lastContractHash: string | null = null;
    94	let lastDrainAt: number | null = null;
    95	let lastDrainError: string | null = null;
    96	
    97	/**
    98	 * The shutdown half of the shared "stop claiming" signal (`src/lib/worker/stop-signal.ts`), handed to
    99	 * every duty that claims work in a loop (E fix round 1, finding 5).
   100	 *
   101	 * Clearing the timers on `SIGTERM` stops the NEXT pass; it does nothing about the pass already
   102	 * running, which kept claiming wakeup slots and playground sessions — starting fresh inference the
   103	 * grace window then had to wait out, for work that a still-live instance would have taken anyway.
   104	 * Duties read this before every new claim; whatever is already claimed finishes.
   105	 *
   106	 * The DRAIN duty deliberately does not take it. Its unit of work is an event whose completion is a
   107	 * receipt, not a claim against a lease or an inference budget: a pass interrupted anywhere leaves the
   108	 * unreceipted events for the next runtime's scan, and its own phase budget already bounds how long
   109	 * one pass can run. There is nothing for a stop signal to prevent there.
   110	 */
   111	const isShuttingDown = (): boolean => shuttingDown;
   112	
   113	function track<T>(promise: Promise<T>): Promise<T> {
   114	  inFlight.add(promise);
   115	  const settle = () => inFlight.delete(promise);
   116	  promise.then(settle, settle);
   117	  return promise;
   118	}
   119	
   120	/** Runs `fn` on `intervalMs`, skipping a tick if the previous invocation of THIS duty is still running. */
   121	function scheduleDuty(name: string, intervalMs: number, fn: () => Promise<void>): NodeJS.Timeout {
   122	  let busy = false;
   123	  return setInterval(() => {
   124	    if (shuttingDown || busy) return;
   125	    busy = true;
   126	    track(
   127	      fn()
   128	        .catch((error) => {
   129	          console.error(`[worker] duty "${name}" failed`, error);
   130	        })
   131	        .finally(() => {
   132	          busy = false;
   133	        })
   134	    );
   135	  }, intervalMs);
   136	}
   137	
   138	async function runDrainDuty(): Promise<void> {
   139	  const { runEventDrainPass } = await import("@/lib/worker/event-drain-pass");
   140	  const { WORKER_HEARTBEAT_ID } = await import("@/lib/worker/schedule-honesty");
   141	  try {
   142	    const result = await runEventDrainPass(WORKER_HEARTBEAT_ID);
   143	    lastContractHash = result.contractHash;
   144	    lastDrainAt = Date.now();
   145	    lastDrainError = null;
   146	  } catch (error) {
   147	    lastDrainError = error instanceof Error ? error.message : String(error);
   148	    throw error;
   149	  }
   150	}
   151	
   152	async function runDeadlineDuty(): Promise<void> {
   153	  const { runDeadlinesAndCap } = await import("@/lib/playground/lifecycle");
   154	  // No runner override — the third argument is this process's shutdown flag, which the entry point
   155	  // composes with its own lock-loss signal before handing ONE predicate to the sweep.
   156	  await runDeadlinesAndCap("worker", undefined, isShuttingDown);
   157	}
   158	
   159	async function runWakeupDuty(): Promise<void> {
   160	  const { claimAndRunWakeups } = await import("@/lib/worker/wakeup-pass");
   161	  await claimAndRunWakeups(isShuttingDown);
   162	}
   163	
   164	async function runIdleSweepDuty(): Promise<void> {
   165	  const { runIdleSweep } = await import("@/lib/worker/idle-scheduler");
   166	  await runIdleSweep(isShuttingDown);
   167	}
   168	
   169	/** M11b Lane W (P5.1): claims leases like the wakeup/deadline/idle duties, so it takes the same stop signal. */
   170	async function runWebhookDuty(): Promise<void> {
   171	  const { runWebhookDeliveryPass } = await import("@/lib/worker/webhook-pass");
   172	  await runWebhookDeliveryPass(isShuttingDown);
   173	}
   174	
   175	// --- node:http /healthz ---------------------------------------------------------------------------
   176	
   177	const server = createServer((req, res) => {
   178	  if (req.url === "/healthz") {
   179	    res.writeHead(200, { "Content-Type": "application/json" });
   180	    res.end(
   181	      JSON.stringify({
   182	        status: shuttingDown ? "shutting_down" : "ok",
   183	        contract_hash: lastContractHash,
   184	        last_drain_at: lastDrainAt ? new Date(lastDrainAt).toISOString() : null,
   185	        last_drain_error: lastDrainError,
   186	        in_flight: inFlight.size,
   187	      })
   188	    );
   189	    return;
   190	  }
   191	  res.writeHead(404);
   192	  res.end();
   193	});
   194	
   195	// --- boot + shutdown --------------------------------------------------------------------------
   196	
   197	let timers: NodeJS.Timeout[] = [];
   198	
   199	async function main(): Promise<void> {
   200	  await checkMigrationLedgerOrExit();
   201	
   202	  // The contract hash BEFORE the server accepts a request (E fix round 1, finding 6). It used to be
   203	  // set only by the first successful drain, so `/healthz` answered `contract_hash: null` for the
   204	  // first `WORKER_DRAIN_INTERVAL_MS` of every boot — and the deployment-version barrier reads exactly
   205	  // that field to decide whether a runtime is on the target contract. A null was indistinguishable
   206	  // from a wrong hash, so a cutover check racing a fresh worker saw a runtime it could not clear.
   207	  // `computeConsumerContractHash` is pure and synchronous over this build's kind union and coverage
   208	  // manifests — nothing about it needs a drain to have happened.
   209	  const { computeConsumerContractHash } = await import("@/lib/events/consumer-contract");
   210	  lastContractHash = computeConsumerContractHash();
   211	  console.log(`[worker] consumer contract hash ${lastContractHash}`);
   212	
   213	  server.listen(PORT, () => {
   214	    console.log(`[worker] /healthz listening on :${PORT}`);
   215	  });
   216	
   217	  timers = [
   218	    scheduleDuty("drain", DRAIN_INTERVAL_MS, runDrainDuty),
   219	    scheduleDuty("deadlines", DEADLINE_INTERVAL_MS, runDeadlineDuty),
   220	    scheduleDuty("wakeups", WAKEUP_INTERVAL_MS, runWakeupDuty),
   221	    scheduleDuty("idle-sweep", IDLE_SWEEP_INTERVAL_MS, runIdleSweepDuty),
   222	    scheduleDuty("webhooks", WORKER_WEBHOOK_INTERVAL_MS, runWebhookDuty),
   223	  ];
   224	
   225	  console.log(
   226	    `[worker] started — drain every ${DRAIN_INTERVAL_MS}ms, deadlines every ${DEADLINE_INTERVAL_MS}ms, ` +
   227	      `wakeups every ${WAKEUP_INTERVAL_MS}ms, idle sweep every ${IDLE_SWEEP_INTERVAL_MS}ms, ` +
   228	      `webhooks every ${WORKER_WEBHOOK_INTERVAL_MS}ms.`
   229	  );
   230	}
   231	
   232	/**
   233	 * SIGTERM: stop claiming (clear every timer, so no NEW pass starts), then drain whatever is already
   234	 * in flight up to `WORKER_SHUTDOWN_GRACE_MS` (default 240s; Render's own shutdown grace is configured
   235	 * >= this). In-flight inference has no cancellation API, so crash-safety belongs to leases, not this
   236	 * handler — a SIGKILLed tick's wakeup lease simply expires and housekeeping marks it `abandoned`
   237	 * (never auto-re-run) on the next pass, by the worker or by the cron route.
   238	 */
   239	async function shutdown(signal: string): Promise<void> {
   240	  if (shuttingDown) return;
   241	  shuttingDown = true;
   242	  console.log(`[worker] ${signal} received — stopping new claims, draining in-flight work.`);
   243	  for (const timer of timers) clearInterval(timer);
   244	
   245	  const inFlightSnapshot = Array.from(inFlight);
   246	  const grace = new Promise<"timeout">((resolve) => setTimeout(() => resolve("timeout"), SHUTDOWN_GRACE_MS));
   247	  const drained = Promise.allSettled(inFlightSnapshot).then(() => "drained" as const);
   248	  const outcome = await Promise.race([drained, grace]);
   249	  if (outcome === "timeout") {
   250	    console.error(
   251	      `[worker] shutdown grace (${SHUTDOWN_GRACE_MS}ms) elapsed with ${inFlight.size} duty(ies) still in flight; exiting anyway.`
   252	    );
   253	  } else {
   254	    console.log("[worker] all in-flight work settled; exiting.");
   255	  }
   256	
   257	  server.close();
   258	  process.exit(0);
   259	}
