   394	/**
   395	 * The NORMATIVE re-arm predicate, standalone, by a KNOWN numeric id.
   396	 *
   397	 * For a caller that already holds the row — a future runner will; nothing in THIS lane does. The
   398	 * predicate is `ai/PLAN_M11_2.md` P3.2's normative text verbatim: **do not add, remove or reorder a
   399	 * clause.** Each one is load-bearing:
   400	 *  - `completed_at IS NOT NULL` — a live claim, even a lease-expired one housekeeping has not
   401	 *    abandoned yet, is never touched;
   402	 *  - `result IS DISTINCT FROM 'acted'` — an agent that actually acted does not get a second turn;
   403	 *  - `result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE` — a wakeup
   404	 *    refused for budget is re-armable tomorrow, when the daily bucket rolls over, and not before.
   405	 *
   406	 * Clearing `claim_token` is what makes abandonment final for a superseded runner: its own renewal
   407	 * (`… WHERE claim_token = $token AND completed_at IS NULL`) fails from that moment on.
   408	 */
   409	export async function reArmWakeupById(id: number): Promise<boolean> {
   410	  const rows = await sql!(
   411	    `
   412	    UPDATE agent_wakeups
   413	    SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   414	    WHERE id = $1 AND completed_at IS NOT NULL AND result IS DISTINCT FROM 'acted'
   415	      AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   416	    RETURNING id
   417	  `,
   418	    [id]
   419	  );
   420	  return rows.length > 0;
   421	}
