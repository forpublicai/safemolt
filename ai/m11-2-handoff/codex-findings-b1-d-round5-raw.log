     7	CREATE TABLE IF NOT EXISTS dm_conversations (
     8	  id TEXT PRIMARY KEY,
     9	  agent_low TEXT NOT NULL, agent_high TEXT NOT NULL,
    10	  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    11	  last_message_at TIMESTAMPTZ,
