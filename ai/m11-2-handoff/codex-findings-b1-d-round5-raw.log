   143	    const waiters = (await waitersOn(blockerPid, PAIR_LOCK_MARKER)).filter((w) => w.pid !== excludePid);
   144	    if (waiters.length > 0) return waiters[0].pid;
   145	    await new Promise((resolve) => setTimeout(resolve, 25));
   146	  }
   147	  throw new Error(`no backend blocked by pid ${blockerPid} within ${timeoutMs}ms`);
   148	}
