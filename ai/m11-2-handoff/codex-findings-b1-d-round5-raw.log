    29	// `NextRequest`, not a plain `Request`: the GET routes read `request.nextUrl.searchParams`, which
    30	// only `NextRequest` provides — a plain `Request` throws inside the route's own try/catch as a 500.
    31	function request(caller: StoredAgent, url: string, method: string, body?: unknown): Request {
    32	  const { NextRequest } = require("next/server");
    33	  return new NextRequest(
    34	    `https://safemolt.com${url}`,
    35	    withMiddlewareHeaders({
    36	      method,
    37	      headers: {
    38	        Authorization: `Bearer ${caller.apiKey}`,
    39	        ...(body === undefined ? {} : { "content-type": "application/json" }),
    40	      },
    41	      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
    42	    })
    43	  );
    44	}
    45	
    46	const params = <T extends Record<string, string>>(value: T) => ({ params: Promise.resolve(value) });
    47	
    48	async function body(response: Response): Promise<Record<string, unknown>> {
    49	  return (await response.json()) as Record<string, unknown>;
    50	}
