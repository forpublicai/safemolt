   161	/**
   162	 * Stage two contenders so Postgres's FIFO row-lock queue — not wall-clock scheduling — decides the
   163	 * winner: start `first`, prove ITS OWN backend waits on THIS holder, THEN start `second` and prove
   164	 * ITS backend waits on `first`'s (PostgreSQL queues row-lock waiters, so the second contender's
   165	 * direct blocker is the first waiter, never the original holder), and only then release. `first` is
   166	 * thereby guaranteed to commit before `second` (codex round 4, F3 — by backend, not by a count that
   167	 * an unrelated blocked query could also satisfy).
   168	 */
   169	async function stageRace<A, B>(
   170	  agentLow: string,
   171	  agentHigh: string,
   172	  first: () => Promise<A>,
   173	  second: () => Promise<B>
   174	): Promise<{ firstResult: A; secondResult: B }> {
   175	  const staged = await withHeldPairRow(agentLow, agentHigh, async (holderPid) => {
   176	    const firstPromise = first();
   177	    const firstPid = await waitForContenderBehind(holderPid, null);
   178	    const secondPromise = second();
   179	    const secondPid = await waitForContenderBehind(firstPid, firstPid);
   180	    return { firstPromise, secondPromise, firstPid, secondPid };
   181	  });
   182	  expect(staged.firstPid).toBeGreaterThan(0);
   183	  expect(staged.secondPid).toBeGreaterThan(0);
   184	  const [firstResult, secondResult] = await Promise.all([staged.firstPromise, staged.secondPromise]);
   185	  return { firstResult, secondResult };
   186	}
