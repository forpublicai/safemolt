   150	/** Like `waitForContenderBehind`, but waits for `count` distinct backends behind `blockerPid`. */
   151	async function waitForContenderCountBehind(blockerPid: number, count: number, timeoutMs = 5000): Promise<number[]> {
   152	  const deadline = Date.now() + timeoutMs;
   153	  while (Date.now() < deadline) {
   154	    const waiters = await waitersOn(blockerPid, PAIR_LOCK_MARKER);
   155	    if (waiters.length >= count) return waiters.map((w) => w.pid);
   156	    await new Promise((resolve) => setTimeout(resolve, 25));
   157	  }
   158	  throw new Error(`fewer than ${count} backends blocked by pid ${blockerPid} within ${timeoutMs}ms`);
   159	}
