    23	async function agent(label: string, options: { vetted?: boolean } = {}): Promise<StoredAgent> {
    24	  const created = await createAgent(nextName(label), "dm route fixture");
    25	  if (options.vetted !== false) await setAgentVetted(created.id, `# ${label}\n`);
