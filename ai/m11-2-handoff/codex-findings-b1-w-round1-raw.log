   189	    id: webhookDeliveries.nextId++,
   190	    wakeupId: wakeup.id,
   191	    agentId: wakeup.agentId,
   192	    attempts: 0,
   193	    lastAttemptAt: null,
   194	    deliveredAt: null,
   195	    lastStatus: null,
   196	    claimedAt: null,
   197	    claimToken: null,
   198	    leaseExpiresAt: null,
   199	    terminalReason: null,
   200	    nextAttemptAt: nowIso,
   201	  };
