   112	beforeAll(async () => {
   113	  // No neutralization needed here (unlike the wakeup router's "one live session" index): every
   114	  // constraint `webhook_deliveries` carries — `UNIQUE (wakeup_id)`, the two claim-scan indexes — is
   115	  // scoped to a wakeup or keyed off a RUN-suffixed agent, so a prior interrupted run leaves nothing
   116	  // that can block a fresh row here the way a cross-run "one per scope" index can.
   117	});
   118	
   119	afterAll(async () => {
   120	  // Explicit, ordered deletes first (cascades would also get there, but a failed cascade must not
   121	  // strand this run's rows for the next one) — same discipline as m11-2-u5-wakeups.test.ts.
   122	  await pgPool().query(`DELETE FROM webhook_deliveries WHERE agent_id LIKE $1`, [`b1w_agent_${RUN}%`]);
   123	  await pgPool().query(`DELETE FROM agent_webhooks WHERE agent_id LIKE $1`, [`b1w_agent_${RUN}%`]);
   124	  await pgPool().query(`DELETE FROM agent_wakeups WHERE agent_id LIKE $1`, [`b1w_agent_${RUN}%`]);
   125	  await pgPool().query(`DELETE FROM agents WHERE id LIKE $1`, [`b1w_agent_${RUN}%`]);
   126	  await closeIntegrationConnections();
   127	});
