   256	  const session = playgroundSessions.get(sessionId);
   257	  if (!session || session.status !== "active" || session.currentRound !== round) return false;
   258	  for (const action of playgroundActions.values()) {
   259	    if (action.sessionId === sessionId && action.agentId === agentId && action.round === round) {
   260	      return false;
   261	    }
   262	  }
   263	  return true;
   264	}
   265	
   266	/**
   267	 * See `db.ts`: `createOrReArmWakeup` for `playground_round`, with the freshness gate evaluated in
