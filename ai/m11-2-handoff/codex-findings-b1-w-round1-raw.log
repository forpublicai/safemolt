   309	/** See `db.ts`: the normative predicate, by a known numeric id. */
   310	export async function reArmWakeupById(id: number): Promise<boolean> {
   311	  const row = wakeupQueue.rows.get(id);
   312	  if (!row || !reArmable(row)) return false;
   313	  clearClaimAndCompletion(row);
   314	  return true;
   315	}
