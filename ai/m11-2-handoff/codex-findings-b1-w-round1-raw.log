   228	 * snapshot, and no `await` splits the check from the write.
   229	 */
   230	export async function createOrReArmWakeup(
   231	  input: CreateOrReArmWakeupInput
   232	): Promise<CreateOrReArmWakeupResult> {
   233	  const payload = normalizePayload(input.payload);
   234	  const existing = conflictingRow(input.agentId, input.reason, input.eventId);
   235	  if (!existing) {
   236	    const row = insertRow(input, payload);
   237	    createWebhookLedgerRowIfNeeded(row);
   238	    return { created: true, reArmed: false };
   239	  }
   240	  if (!reArmable(existing)) return { created: false, reArmed: false };
   241	  clearClaimAndCompletion(existing);
   242	  createWebhookLedgerRowIfNeeded(existing);
   243	  return { created: false, reArmed: true };
   244	}
   245	
   246	/**
   247	 * The memory twin of the db statement's `live` CTE (codex u5-C round 1 MAJOR): the session is
   248	 * active on THIS round and the agent has not acted in it.
   249	 *
   250	 * Read from the shared `_memory-state` registry — the sanctioned cross-domain path (the comments
   251	 * twin reads `posts` the same way) — and evaluated in the same synchronous section as the write, so
   252	 * no advancement can land between the check and the insert. The db side gets that guarantee from
   253	 * `FOR SHARE` on the session row; memory gets it from the section having no `await`.
   254	 */
