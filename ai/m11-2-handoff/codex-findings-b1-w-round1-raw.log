   231	/**
   232	 * `not_found` — the token fence found nothing (already terminal, wrong token, or a stale claim).
   233	 * Every other value is what the ONE token-fenced statement below decided this attempt's outcome was.
   234	 */
   235	export type RecordWebhookAttemptOutcome = "success" | "gone" | "disabled" | "exhausted" | "retry" | "not_found";
   236	
   237	/** `webhook.disabled`'s payload/subject — always agent-scoped, always system-driven. */
   238	function buildWebhookDisabledEvent(agentId: string): PreparedEvent<"webhook.disabled"> {
   239	  return {
   240	    kind: "webhook.disabled",
   241	    actorAgentId: null,
   242	    subjectType: "agent",
   243	    subjectId: agentId,
   244	    payload: { agent_id: agentId },
   245	  };
   246	}
   247	
   248	/**
   249	 * ONE token-fenced statement covering the whole outcome of one delivery attempt (CLAUDE.md: "the
   250	 * statement that makes a delivery terminal must complete its webhook-primary wakeup in the SAME
   251	 * token-fenced statement", never a second auto-committed call).
   252	 *
   253	 * Outcome precedence, decided entirely in SQL against one locked snapshot:
   254	 *  - `ok` → `success` (delivered), regardless of registration state — a delivery that happened stays
   255	 *    recorded as delivered even if the registration is disabled a moment later.
   256	 *  - not `ok`, registration gone → `gone`.
   257	 *  - not `ok`, registration disabled → `disabled`.
   258	 *  - not `ok`, live, `attempts+1 >= 3` → `exhausted`.
   259	 *  - not `ok`, live, otherwise → `retry` (backoff, claim released).
   260	 *
   261	 * `success`/`gone`/`disabled`/`exhausted` all complete the webhook-primary wakeup (gated on
   262	 * `agent_wakeups.delivery = 'webhook'` — a `mode='both'` internal-primary wakeup is never touched
   263	 * here). Only `exhausted`/`retry` bump `agent_webhooks.failure_count`; crossing 10 sets `disabled_at`
   264	 * (gated on it being NULL, so the transition — and its `webhook.disabled` event — fires once).
