    93	/**
    94	 * Deletes the registration and, in the SAME statement, terminalizes every UNCLAIMED ledger row for
    95	 * this agent whose wakeup is webhook-**primary** (`agent_wakeups.delivery = 'webhook'`) — completing
    96	 * each such wakeup too (CLAUDE.md's terminal-coupling rule: no committable state may pair a terminal
    97	 * delivery with a nonterminal webhook-primary wakeup).
    98	 *
    99	 * A `mode='both'` ledger's wakeup is `delivery = 'internal'` and is deliberately left untouched — the
   100	 * tick still owns it. A CLAIMED row is left alone too: it finishes its own attempt under its token,
   101	 * and `recordWebhookAttempt`'s fenced update — finding the registration gone — terminalizes it then.
   102	 */
   103	export async function deleteAgentWebhook(agentId: string): Promise<{ deleted: boolean }> {
   104	  const rows = await sql!(
   105	    `WITH deleted_reg AS (
   106	       DELETE FROM agent_webhooks WHERE agent_id = $1
   107	       RETURNING agent_id
   108	     ),
   109	     terminalized AS (
   110	       UPDATE webhook_deliveries wd
   111	       SET terminal_reason = 'webhook_removed'
   112	       FROM deleted_reg dr
   113	       WHERE wd.agent_id = dr.agent_id
   114	         AND wd.terminal_reason IS NULL
   115	         AND wd.claimed_at IS NULL
   116	       RETURNING wd.wakeup_id
   117	     ),
   118	     completed_wakeups AS (
   119	       UPDATE agent_wakeups w
   120	       SET completed_at = NOW(), result = 'webhook_removed'
   121	       FROM terminalized t
   122	       WHERE w.id = t.wakeup_id
   123	         AND w.delivery = 'webhook'
   124	         AND w.completed_at IS NULL
   125	       RETURNING w.id
   126	     )
   127	     SELECT (SELECT count(*) FROM deleted_reg)::int AS deleted_count`,
   128	    [agentId]
   129	  );
