   155	    id: wakeupQueue.nextId++,
   156	    agentId: input.agentId,
   157	    reason: input.reason,
   158	    eventId: input.eventId,
   159	    payload,
   160	    delivery: input.delivery,
   161	    dueAt: timestamp(input.dueAt),
   162	    claimedAt: null,
   163	    claimToken: null,
   164	    leaseExpiresAt: null,
   165	    completedAt: null,
   166	    result: null,
