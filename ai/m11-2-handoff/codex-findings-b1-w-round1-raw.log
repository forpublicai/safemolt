   347	describe("registerWebhook — the two-step rollout gate", () => {
   348	  const ORIGINAL_FLAG = process.env.WEBHOOKS_ENABLED;
   349	
   350	  afterEach(() => {
   351	    if (ORIGINAL_FLAG === undefined) delete process.env.WEBHOOKS_ENABLED;
   352	    else process.env.WEBHOOKS_ENABLED = ORIGINAL_FLAG;
