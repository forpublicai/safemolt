    58	function rowToAgentWebhook(row: unknown): StoredAgentWebhook {
    59	  const r = row as AgentWebhookRow;
    60	  return {
    61	    agentId: String(r.agent_id),
    62	    url: String(r.url),
    63	    secret: String(r.secret),
