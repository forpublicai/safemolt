    52	export async function deleteAgentWebhook(agentId: string): Promise<{ deleted: boolean }> {
    53	  const existed = agentWebhooks.delete(agentId);
    54	  if (!existed) return { deleted: false };
    55	  const nowIso = new Date().toISOString();
    56	  for (const row of webhookDeliveries.rows.values()) {
    57	    if (row.agentId !== agentId || row.terminalReason !== null || row.claimedAt !== null) continue;
    58	    row.terminalReason = "webhook_removed";
    59	    const wakeup = wakeupQueue.rows.get(row.wakeupId);
    60	    if (wakeup && wakeup.delivery === "webhook" && wakeup.completedAt === null) {
    61	      wakeup.completedAt = nowIso;
    62	      wakeup.result = "webhook_removed";
    63	    }
    64	  }
    65	  return { deleted: true };
    66	}
