   401	 * store's substitute for the db statement's row lock (see the section doc comment above).
   402	 *
   403	 * `candidates` mirrors the db shape exactly — `0`, or `1` with `claimed` either `null` (a budget
   404	 * refusal, terminalized in place) or the claimed row — because the db statement's `cand` CTE is
   405	 * `LIMIT 1` and this scan picks exactly one winner the same way.
   406	 *
   407	 * **The tiebreak (ascending `id`) is a MEMORY-ONLY addition.** The db statement's `ORDER BY w.due_at`
   408	 * names no explicit tiebreaker — Postgres's own tie order is unspecified — but a deterministic memory
   409	 * twin needs one for reproducible tests, so ties are broken by the memory queue's own insertion order
   410	 * (ascending `id`).
   411	 */
   412	export async function claimNextWakeup(input: ClaimNextWakeupInput): Promise<ClaimNextWakeupResult> {
   413	  const allRows = rows();
   414	  const inFlightAgents = new Set(
   415	    allRows.filter((row) => row.claimedAt !== null && row.completedAt === null).map((row) => row.agentId)
   416	  );
   417	  const nowMs = Date.now();
   418	  const candidates = allRows.filter((row) => {
   419	    if (row.completedAt !== null || row.claimedAt !== null) return false;
   420	    if (row.delivery !== "internal") return false;
   421	    if (Date.parse(row.dueAt) > nowMs) return false;
   422	    if (agentLoopState.get(row.agentId)?.enabled !== true) return false;
   423	    if (inFlightAgents.has(row.agentId)) return false;
   424	    return true;
   425	  });
   426	
   427	  if (candidates.length === 0) return { candidates: 0 };
   428	
   429	  candidates.sort((a, b) => Date.parse(a.dueAt) - Date.parse(b.dueAt) || a.id - b.id);
   430	  // `rows()` hands out the live map references, so `candidates[0]` IS the stored row — mutating it
   431	  // below mutates `wakeupQueue` directly, with no extra lookup.
   432	  const row = candidates[0];
   433	
   434	  const nowIso = new Date(nowMs).toISOString();
   435	  const bucket: "general" | "playground" = row.reason === PLAYGROUND_ROUND_REASON ? "playground" : "general";
   436	  const cap = bucket === "playground" ? input.playgroundCap : input.generalCap;
   437	  const key = budgetCounterKey(row.agentId, utcDay(nowIso), bucket);
   438	  const spent = pulseBudgetCounters.get(key) ?? 0;
