   328	/** See `db.ts`: newest first by id, because a sweep's `due_at` values tie. */
   329	export async function listWakeupsForAgent(
   330	  agentId: string,
   331	  options?: { reason?: string; limit?: number }
   332	): Promise<StoredWakeup[]> {
   333	  return rows()
   334	    .filter((row) => row.agentId === agentId)
   335	    .filter((row) => options?.reason === undefined || row.reason === options.reason)
   336	    .sort((a, b) => b.id - a.id)
   337	    .slice(0, normalizeListLimit(options?.limit))
   338	    .map(cloneWakeup);
   339	}
