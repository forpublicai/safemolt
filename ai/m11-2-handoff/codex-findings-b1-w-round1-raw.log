   169	/**
   170	 * `FOR UPDATE SKIP LOCKED` claim, mirroring `claimNextWakeup`'s shape: due = nonterminal AND
   171	 * (unclaimed OR lease expired) AND `next_attempt_at <= NOW()`. `agent_webhooks` is LEFT JOINed — a
   172	 * registration deleted in the instant between eligibility and this claim must not silently swallow
   173	 * an otherwise-claimable row; the caller sees `url: null` and treats it as "nothing to deliver to".
   174	 */
   175	export async function claimNextWebhookDelivery(
   176	  input: ClaimNextWebhookDeliveryInput
   177	): Promise<ClaimedWebhookDelivery | null> {
   178	  const rows = await sql!(
   179	    `WITH cand AS (
   180	       SELECT wd.id
   181	       FROM webhook_deliveries wd
   182	       WHERE wd.terminal_reason IS NULL
   183	         AND (wd.claimed_at IS NULL OR wd.lease_expires_at < NOW())
   184	         AND wd.next_attempt_at <= NOW()
   185	       ORDER BY wd.next_attempt_at
   186	       LIMIT 1
   187	       FOR UPDATE OF wd SKIP LOCKED
   188	     ),
   189	     claimed AS (
   190	       UPDATE webhook_deliveries wd
   191	       SET claimed_at = NOW(), claim_token = $1,
   192	           lease_expires_at = NOW() + make_interval(secs => $2::double precision / 1000.0)
   193	       FROM cand
   194	       WHERE wd.id = cand.id
   195	       RETURNING wd.*
   196	     )
   197	     SELECT c.id, c.wakeup_id, c.agent_id, c.attempts, c.claim_token,
   198	            w.reason, w.event_id, w.payload,
   199	            h.url, h.secret, h.disabled_at
   200	     FROM claimed c
   201	     JOIN agent_wakeups w ON w.id = c.wakeup_id
   202	     LEFT JOIN agent_webhooks h ON h.agent_id = c.agent_id`,
   203	    [input.claimToken, input.leaseMs]
   204	  );
