   129	describe("claimNextWebhookDelivery — exactly one claimant per row", () => {
   130	  it("lets exactly one of N concurrent callers claim a reclaimable (expired-lease) row", async () => {
   131	    const agent = await seedAgent();
   132	    await upsertAgentWebhook({ agentId: agent, url: "https://example.com/hook", secret: "s", mode: "primary" });
   133	    const wakeupId = await seedWebhookWakeup(agent);
   134	    const delivery = await ledgerRowForWakeup(wakeupId);
   135	
   136	    // Seed a claimed-but-expired row so every caller races the SAME reclaimable row, not an empty
   137	    // queue — a sharper proof of "exactly one winner" than claiming an unclaimed row once.
   138	    await pgPool().query(
   139	      `UPDATE webhook_deliveries SET claimed_at = NOW(), claim_token = $2, lease_expires_at = NOW() - INTERVAL '1 hour' WHERE id = $1`,
   140	      [delivery.id, "b1w_stale_seed_token"]
   141	    );
   142	
   143	    const tokens = Array.from({ length: 5 }, (_, i) => `b1w_claim_${RUN}_${i}`);
   144	    const outcomes = await runConcurrently(
   145	      tokens.map((claimToken) => () => claimNextWebhookDelivery({ claimToken, leaseMs: 30_000 }))
   146	    );
   147	
   148	    expect(rejections(outcomes)).toEqual([]);
   149	    const nonNull = outcomes.filter(
   150	      (o): o is { ok: true; value: NonNullable<Awaited<ReturnType<typeof claimNextWebhookDelivery>>> } =>
   151	        o.ok && o.value !== null
   152	    );
   153	    expect(nonNull).toHaveLength(1);
   154	    const winnerToken = nonNull[0].value.claimToken;
   155	    expect(tokens).toContain(winnerToken);
   156	
   157	    const finalRow = await ledgerRowForWakeup(wakeupId);
   158	    expect(finalRow.claim_token).toBe(winnerToken);
   159	  });
   160	});
