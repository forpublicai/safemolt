   162	describe("recordWebhookAttempt — the token fence", () => {
   163	  it("reclaims an expired lease and rejects the stale token's update", async () => {
   164	    const agent = await seedAgent();
   165	    await upsertAgentWebhook({ agentId: agent, url: "https://example.com/hook", secret: "s", mode: "primary" });
   166	    const wakeupId = await seedWebhookWakeup(agent);
   167	
   168	    const first = await claimNextWebhookDelivery({ claimToken: `b1w_tok1_${RUN}`, leaseMs: 30_000 });
   169	    expect(first).not.toBeNull();
   170	    await backdateLease(first!.id);
   171	
   172	    const second = await claimNextWebhookDelivery({ claimToken: `b1w_tok2_${RUN}`, leaseMs: 30_000 });
   173	    expect(second).not.toBeNull();
   174	    expect(second!.id).toBe(first!.id);
   175	    const afterReclaim = await ledgerRowForWakeup(wakeupId);
   176	    expect(afterReclaim.claim_token).toBe(`b1w_tok2_${RUN}`);
   177	
   178	    // The stale (first) token no longer fences anything — the row now belongs to the second claim.
   179	    const staleOutcome = await recordWebhookAttempt({
   180	      id: first!.id,
   181	      claimToken: first!.claimToken,
   182	      agentId: agent,
   183	      status: 500,
   184	      ok: false,
   185	    });
   186	    expect(staleOutcome).toBe("not_found");
   187	
   188	    // The stale call must not have mutated what the second claim left behind.
   189	    const afterStale = await ledgerRowForWakeup(wakeupId);
   190	    expect(afterStale.attempts).toBe(afterReclaim.attempts);
   191	    expect(afterStale.terminal_reason).toBe(afterReclaim.terminal_reason);
   192	    expect(afterStale.claim_token).toBe(`b1w_tok2_${RUN}`);
   193	  });
   194	});
