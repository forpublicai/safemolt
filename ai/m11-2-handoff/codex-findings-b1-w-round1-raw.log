   469	 * deliberate, minimal reuse of the existing `LoopDomain` — there is no dedicated `messages` domain
   470	 * yet (out-of-fence: `agent-runtime/index.ts` is outside this lane), and the domain only affects
   471	 * prompt guidance text here; `toolsNamed()` filters by the explicit `DM_TOOL_NAMES` set, not by
   472	 * domain, so the narrowing itself is exact regardless.
   473	 */
   474	async function runDmWakeup(agent: StoredAgent, wakeup: StoredWakeup, claimToken: string): Promise<WakeupOutcome> {
   475	  return runNarrowWakeup(agent, wakeup, claimToken, focusForWakeup(wakeup), {
   476	    toolNames: DM_TOOL_NAMES,
   477	    domain: "discussion",
   478	  });
   479	}
   480	
   481	/** Route one claimed wakeup by `reason`. Always completes it exactly once before returning. */
   482	async function runClaimedWakeup(wakeup: StoredWakeup, claimToken: string): Promise<WakeupOutcome> {
   483	  const agent = await getAgentById(wakeup.agentId);
   484	  if (!agent) {
   485	    // The agent no longer exists (withdrawn between claim and dispatch). Nothing to retry against;
   486	    // `error` is re-armable, but a re-arm will hit this same dead end — acceptable, since the
   487	    // alternative (a bespoke terminal outcome just for this case) adds a re-arm exception nothing
   488	    // else in the tree needs.
   489	    await completeWakeup(wakeup.id, claimToken, "error");
   490	    return "error";
   491	  }
   492	
   493	  if (wakeup.reason === IDLE_WAKEUP_REASON) return runIdleWakeup(agent, wakeup, claimToken);
   494	  if (wakeup.reason === PLAYGROUND_ROUND_REASON) return runPlaygroundRoundWakeup(agent, wakeup, claimToken);
   495	  if (REPLY_REASONS.has(wakeup.reason)) return runReplyWakeup(agent, wakeup, claimToken);
   496	  if (wakeup.reason === DM_REASON) return runDmWakeup(agent, wakeup, claimToken);
   497	
   498	  // An unrecognized reason (a future producer this dispatcher does not know yet): treat it as idle's
   499	  // full-discovery path rather than silently stranding the claim — the safest default for a reason
   500	  // this code was not written to expect.
   501	  return runIdleWakeup(agent, wakeup, claimToken);
   502	}
   503	
   504	// ---------------------------------------------------------------------------
   505	// Batch entry point
   506	// ---------------------------------------------------------------------------
   507	
   508	export interface PulseBatchResult {
   509	  /** Wakeups actually claimed and run this pass (excludes queue-empty misses). */
   510	  claimed: number;
   511	  results: { wakeupId: number; agentId: string; reason: string; outcome: WakeupOutcome }[];
   512	}
   513	
   514	/**
   515	 * Run due wakeups up to `maxSlots` — `agent-loop.ts`'s `runAgentLoopBatch` calls this with the same
   516	 * batch size cron always used. One claim per slot; a slot that finds the queue empty ends the pass
   517	 * early rather than spinning through the remaining slots (there is nothing left to claim).
   518	 *
   519	 * `shouldStop` (optional) is the shared "stop claiming" signal — the worker passes its `SIGTERM`
   520	 * flag (u6 E fix round 1, finding 5). Checked before EVERY claim, because a batch is where a
   521	 * shutdown otherwise fails to take effect: clearing the duty timers stops the NEXT pass, while the
   522	 * pass already running kept claiming and starting fresh inference for the rest of its slots, each
   523	 * one a tick the grace window then had to wait out. A wakeup already claimed runs to completion —
   524	 * leases, not this predicate, are what make a killed tick safe (P3.1) — so the only effect is that
   525	 * nothing new is claimed. Callers with no such signal pass nothing and the check is a no-op.
   526	 */
   527	export async function runPulseBatch(maxSlots: number, shouldStop?: ShouldStop): Promise<PulseBatchResult> {
   528	  const results: PulseBatchResult["results"] = [];
   529	  for (let slot = 0; slot < maxSlots; slot += 1) {
   530	    if (shouldStop?.()) break;
   531	    const claim = await claimOneWakeup();
   532	    if (!claim) break;
   533	    const { wakeup, claimToken } = claim;
   534	    let outcome: WakeupOutcome;
   535	    try {
   536	      outcome = await runClaimedWakeup(wakeup, claimToken);
   537	    } catch (e) {
   538	      // A defensive backstop: every path inside `runClaimedWakeup` already completes the wakeup
   539	      // before returning or throwing, but an outcome left uncompleted would strand the agent's
   540	      // one-inflight slot until `abandonExpiredWakeupLeases` catches it on the lease's own clock.
   541	      // Best-effort here closes it immediately instead of waiting out the lease.
   542	      console.error("[agent-pulse] uncaught error running claimed wakeup", wakeup.id, e);
   543	      await completeWakeup(wakeup.id, claimToken, "error").catch(() => {});
   544	      outcome = "error";
   545	    }
   546	    results.push({ wakeupId: wakeup.id, agentId: wakeup.agentId, reason: wakeup.reason, outcome });
   547	  }
   548	  return { claimed: results.length, results };
   549	}
   550	
   551	/**
   552	 * Housekeeping: abandon expired-lease claims and terminalize disabled agents' still-pending
   553	 * wakeups (P3.2 semantics). Cheap and idempotent; safe to call every pass.
   554	 */
   555	export async function runPulseMaintenance(): Promise<{ abandoned: number; autonomyDisabled: number }> {
   556	  const [abandoned, autonomyDisabled] = await Promise.all([
   557	    abandonExpiredWakeupLeases(),
   558	    terminalizeDisabledAgentWakeups(),
   559	  ]);
   560	  return { abandoned, autonomyDisabled };
   561	}
   562	
   563	/**
   564	 * Enqueue an `idle` wakeup for one agent whose posting-energy cooldown has elapsed, IF it is still
   565	 * loop-enabled (`resolveWakeupDelivery` — the one place delivery is resolved, per P3.2 semantics; a
   566	 * disabled agent, or one with no `agent_loop_state` row, gets nothing created for it). A thin wrapper
   567	 * over the plain `enqueueWakeup` path (event-less, deduped by `idx_wakeups_dedup_idle` — at most one
   568	 * PENDING idle row per agent at a time), called by `agent-loop.ts`'s idle-sweep. Not itself gated on
   569	 * the general budget bucket (P3.2's idle-scheduler text notes that check is enqueue-time ADVISORY —
   570	 * claim-time enforcement, inside `claimNextWakeup`, is authoritative); the caller is expected to only
   571	 * call this for agents it has already judged cooldown-eligible.
   572	 */
   573	export async function enqueueIdleWakeup(agentId: string): Promise<void> {
   574	  const delivery = await resolveWakeupDelivery(agentId);
   575	  if (!delivery) return;
   576	  await enqueueWakeup({ agentId, reason: IDLE_WAKEUP_REASON, eventId: null, payload: {}, delivery });
   577	}

