   206	  if (!row) return null;
   207	  return {
   208	    id: Number(row.id),
   209	    wakeupId: Number(row.wakeup_id),
   210	    agentId: String(row.agent_id),
   211	    attempts: Number(row.attempts),
   212	    claimToken: String(row.claim_token),
   213	    reason: String(row.reason),
   214	    eventId: row.event_id == null ? null : Number(row.event_id),
   215	    payload: row.payload ?? {},
   216	    url: row.url == null ? null : String(row.url),
   217	    secret: row.secret == null ? null : String(row.secret),
   218	    disabledAt: toIsoOrNull(row.disabled_at),
   219	  };
   220	}
