   353	export async function findRoundOpenedEventId(sessionId: string, round: number): Promise<number | null> {
   354	  if (!Number.isInteger(round)) return null;
   355	  for (let i = eventLog.rows.length - 1; i >= 0; i -= 1) {
   356	    const event = eventLog.rows[i];
   357	    if (event.kind !== ROUND_OPENED_KIND) continue;
   358	    if (event.subjectId !== sessionId) continue;
   359	    const payloadRound = (event.payload as { round?: unknown }).round;
   360	    if (typeof payloadRound !== "number" || payloadRound !== round) continue;
