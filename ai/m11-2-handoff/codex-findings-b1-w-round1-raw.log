   205	/** See `db.ts`: a plain insert that never re-arms, deduped by whichever index applies. */
   206	export async function enqueueWakeup(input: EnqueueWakeupInput): Promise<EnqueueWakeupResult> {
   207	  // Normalized FIRST, so a cyclic payload throws with nothing written — the db store serializes
   208	  // before it sends, so it refuses the same input the same way, dedup or no dedup.
   209	  const payload = normalizePayload(input.payload);
   210	  if (conflictingRow(input.agentId, input.reason, input.eventId)) {
   211	    return { created: false, wakeup: null };
   212	  }
   213	  const row = insertRow(input, payload);
   214	  createWebhookLedgerRowIfNeeded(row);
   215	  return { created: true, wakeup: cloneWakeup(row) };
   216	}
