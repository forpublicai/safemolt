    75	export async function upsertAgentWebhook(input: UpsertAgentWebhookInput): Promise<StoredAgentWebhook> {
    76	  const rows = await sql!(
    77	    `INSERT INTO agent_webhooks (agent_id, url, secret, mode, disabled_at, failure_count, created_at)
    78	     VALUES ($1, $2, $3, $4, NULL, 0, NOW())
    79	     ON CONFLICT (agent_id) DO UPDATE
    80	       SET url = EXCLUDED.url, secret = EXCLUDED.secret, mode = EXCLUDED.mode,
    81	           disabled_at = NULL, failure_count = 0
    82	     RETURNING *`,
    83	    [input.agentId, input.url, input.secret, input.mode]
    84	  );
    85	  return rowToAgentWebhook(rows[0]);
    86	}
