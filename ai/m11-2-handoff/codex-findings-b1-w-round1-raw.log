    25	export async function upsertAgentWebhook(input: UpsertAgentWebhookInput): Promise<StoredAgentWebhook> {
    26	  const existing = agentWebhooks.get(input.agentId);
    27	  const row: StoredAgentWebhook = {
    28	    agentId: input.agentId,
    29	    url: input.url,
    30	    secret: input.secret,
    31	    mode: input.mode,
    32	    disabledAt: null,
    33	    failureCount: 0,
    34	    // A re-POST rotates the secret and clears the disable state, but `created_at` is set once — the
    35	    // db's `ON CONFLICT DO UPDATE` never names that column, so it survives every rotation.
    36	    createdAt: existing?.createdAt ?? new Date().toISOString(),
    37	  };
    38	  agentWebhooks.set(input.agentId, row);
    39	  return cloneWebhook(row);
    40	}
