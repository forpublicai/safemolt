   448	  pulseBudgetCounters.set(key, spent + 1);
   449	  row.claimedAt = nowIso;
   450	  row.claimToken = input.claimToken;
   451	  row.leaseExpiresAt = new Date(nowMs + input.leaseMs).toISOString();
   452	  return { candidates: 1, claimed: cloneWakeup(row) };
   453	}
