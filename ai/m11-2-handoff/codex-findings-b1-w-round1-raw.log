   440	  // Matches the db statement's `b` CTE: a refused claim is terminalized in place and the counter is
   441	  // NOT incremented — "a blocked claim spends nothing" is the plan's own wording for this.
   442	  if (spent >= cap) {
   443	    row.completedAt = nowIso;
   444	    row.result = "budget_exhausted";
   445	    return { candidates: 1, claimed: null };
   446	  }
