   270	  // Always rendered; the insert's own `WHERE EXISTS (SELECT 1 FROM disabled_now)` gate (built into
   271	  // `emitEventCtes`/`emitEventStatement`) is what makes it a no-op on every attempt that does not
   272	  // cross the threshold — the event is never a JS-side conditional.
   273	  const events: PreparedEvent<"webhook.disabled">[] = [buildWebhookDisabledEvent(input.agentId)];
   274	  const emitted = emitEventCtes(events, "disabled_now", { firstParamIndex: params.length + 1 });
   275	  const rows = await sql!(
   276	    `WITH target AS (
   277	       SELECT wd.id, wd.wakeup_id, wd.agent_id, wd.attempts, w.delivery AS wakeup_delivery
   278	       FROM webhook_deliveries wd
   279	       JOIN agent_wakeups w ON w.id = wd.wakeup_id
   280	       WHERE wd.id = $1::bigint AND wd.claim_token = $2::text AND wd.terminal_reason IS NULL
   281	       FOR UPDATE OF wd
   282	     ),
   283	     reg AS (
   284	       SELECT h.agent_id, h.disabled_at, h.failure_count
   285	       FROM agent_webhooks h
   286	       JOIN target t ON t.agent_id = h.agent_id
   287	       FOR UPDATE OF h
   288	     ),
   289	     outcome AS (
   290	       SELECT
   291	         t.id, t.wakeup_id, t.agent_id, t.attempts, t.wakeup_delivery,
   292	         CASE
   293	           WHEN $3::boolean THEN 'success'
   294	           WHEN r.agent_id IS NULL THEN 'gone'
   295	           WHEN r.disabled_at IS NOT NULL THEN 'disabled'
   296	           WHEN t.attempts + 1 >= 3 THEN 'exhausted'
   297	           ELSE 'retry'
   298	         END AS outcome,
   299	         (r.failure_count + 1 >= 10) AS crosses_threshold
   300	       FROM target t
   301	       LEFT JOIN reg r ON r.agent_id = t.agent_id
   302	     ),
   303	     updated_delivery AS (
   304	       UPDATE webhook_deliveries wd
   305	       SET
   306	         attempts = wd.attempts + 1,
   307	         last_status = $4::int,
   308	         last_attempt_at = NOW(),
   309	         delivered_at = CASE WHEN o.outcome = 'success' THEN NOW() ELSE wd.delivered_at END,
   310	         terminal_reason = CASE
   311	           WHEN o.outcome = 'success' THEN 'delivered'
   312	           WHEN o.outcome = 'gone' THEN 'webhook_removed'
   313	           WHEN o.outcome = 'disabled' THEN 'webhook_disabled'
   314	           WHEN o.outcome = 'exhausted' THEN 'exhausted'
   315	           ELSE NULL
   316	         END,
   317	         next_attempt_at = CASE
   318	           WHEN o.outcome = 'retry' THEN NOW() + (
   319	             CASE WHEN o.attempts + 1 <= 1 THEN interval '1 minute'
   320	                  WHEN o.attempts + 1 = 2 THEN interval '10 minutes'
   321	                  ELSE interval '60 minutes' END
   322	           )
   323	           ELSE wd.next_attempt_at
   324	         END,
   325	         claimed_at = CASE WHEN o.outcome = 'retry' THEN NULL ELSE wd.claimed_at END,
   326	         claim_token = CASE WHEN o.outcome = 'retry' THEN NULL ELSE wd.claim_token END,
   327	         lease_expires_at = CASE WHEN o.outcome = 'retry' THEN NULL ELSE wd.lease_expires_at END
   328	       FROM outcome o
   329	       WHERE wd.id = o.id
   330	       RETURNING wd.id, o.outcome, o.wakeup_id, o.wakeup_delivery, o.agent_id, o.crosses_threshold
   331	     ),
   332	     completed_wakeup AS (
   333	       UPDATE agent_wakeups w
   334	       SET completed_at = NOW(), result = CASE
   335	             WHEN ud.outcome = 'success' THEN 'delivered'
   336	             WHEN ud.outcome = 'exhausted' THEN 'exhausted'
   337	             WHEN ud.outcome = 'gone' THEN 'webhook_removed'
   338	             WHEN ud.outcome = 'disabled' THEN 'webhook_disabled'
   339	             ELSE NULL
   340	           END
   341	       FROM updated_delivery ud
   342	       WHERE w.id = ud.wakeup_id
   343	         AND ud.wakeup_delivery = 'webhook'
   344	         AND ud.outcome IN ('success', 'exhausted', 'gone', 'disabled')
   345	         AND w.completed_at IS NULL
   346	       RETURNING w.id
   347	     ),
   348	     reset_failure AS (
   349	       UPDATE agent_webhooks h
   350	       SET failure_count = 0
   351	       FROM updated_delivery ud
   352	       WHERE h.agent_id = ud.agent_id AND ud.outcome = 'success'
   353	       RETURNING h.agent_id
   354	     ),
   355	     bumped_failure AS (
   356	       UPDATE agent_webhooks h
   357	       SET
   358	         failure_count = h.failure_count + 1,
   359	         disabled_at = CASE WHEN ud.crosses_threshold THEN NOW() ELSE h.disabled_at END
   360	       FROM updated_delivery ud
   361	       WHERE h.agent_id = ud.agent_id AND ud.outcome IN ('exhausted', 'retry')
   362	       RETURNING h.agent_id, ud.crosses_threshold
   363	     ),
   364	     disabled_now AS (
   365	       SELECT agent_id FROM bumped_failure WHERE crosses_threshold
   366	     )${emitted.ctes.length > 0 ? `, ${emitted.ctes.join(", ")}` : ""}
   367	     SELECT ud.outcome FROM updated_delivery ud`,
   368	    [...params, ...emitted.params]
   369	  );
   370	  const row = rows[0] as { outcome?: string } | undefined;
   371	  if (!row?.outcome) return "not_found";
   372	  return row.outcome as RecordWebhookAttemptOutcome;
   373	}
