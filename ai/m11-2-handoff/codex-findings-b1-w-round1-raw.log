   317	export async function getWakeupByAgentReasonEvent(
   318	  agentId: string,
   319	  reason: string,
   320	  eventId: number
   321	): Promise<StoredWakeup | null> {
   322	  const found = rows().find(
   323	    (row) => row.agentId === agentId && row.reason === reason && row.eventId === eventId
   324	  );
