    31	  id: number;
    32	  agentId: string;
    33	  reason: string;
    34	  eventId: number | null;
    35	  payload: Record<string, unknown>;
    36	  delivery: WakeupDelivery;
    37	  dueAt: string;
    38	  claimedAt: string | null;
    39	  claimToken: string | null;
    40	  leaseExpiresAt: string | null;
    41	  completedAt: string | null;
    42	  result: string | null;
    43	}
    44	
    45	export interface EnqueueWakeupInput {
    46	  agentId: string;
    47	  reason: string;
    48	  /** `null` => an idle-shaped row, deduped by `idx_wakeups_dedup_idle` rather than by event. */
    49	  eventId: number | null;
    50	  payload: Record<string, unknown>;
    51	  delivery: WakeupDelivery;
    52	  /** Defaults to now. */
    53	  dueAt?: string;
    54	}
    55	
    56	export interface EnqueueWakeupResult {
    57	  /** `false` = a dedup index already held this key; nothing was written. */
    58	  created: boolean;
    59	  /** The row, only when `created === true`. */
    60	  wakeup: StoredWakeup | null;
    61	}
    62	
    63	export interface CreateOrReArmWakeupInput {
    64	  agentId: string;
    65	  reason: string;
    66	  /** ALWAYS non-null here — this path is event-keyed dedup only. */
    67	  eventId: number;
    68	  payload: Record<string, unknown>;
    69	  delivery: WakeupDelivery;
    70	  dueAt?: string;
    71	}
    72	
    73	export interface CreateOrReArmWakeupResult {
    74	  created: boolean;
    75	  reArmed: boolean;
    76	}
    77	
    78	/** Page size when a caller states none. Shared with the memory store so the two cannot drift. */
    79	export const DEFAULT_WAKEUP_LIST_LIMIT = 50;
    80	
    81	/**
    82	 * The kind `findRoundOpenedEventId` looks for, as a plain string.
    83	 *
    84	 * Deliberately not typed as `EventKind`: this domain never imports the kind union (see the header),
    85	 * and a locator that reads one literal is not a producer of it. One definition, shared with the
    86	 * memory store, for the reason `rate-limit-windows.ts` exists — a literal spelled twice is a
    87	 * divergence Jest cannot see.
    88	 */
    89	export const ROUND_OPENED_KIND = "playground.round_opened";
    90	
    91	interface WakeupRow {
    92	  id: number | string;
    93	  agent_id: string;
    94	  reason: string;
    95	  event_id: number | string | null;
    96	  payload: Record<string, unknown> | null;
    97	  delivery: string;
    98	  due_at: unknown;
    99	  claimed_at: unknown;
   100	  claim_token: string | null;
   101	  lease_expires_at: unknown;
   102	  completed_at: unknown;
   103	  result: string | null;
   104	}
   105	
   106	/**
   107	 * One mapper for every read, so no reader can drift from another.
   108	 *
   109	 * `id` and `event_id` are BIGINT and arrive as strings from both drivers, so both are normalized
   110	 * through `Number()` here — the same rule `rowToEvent` follows, and for the same reason: callers
   111	 * compare these ids numerically and a string comparison would order `"10" < "9"`. Timestamps arrive
   112	 * as a `Date` or as a string depending on the driver path, which is what `toIsoOrNull` exists for.
   113	 */
   114	export function rowToWakeup(row: unknown): StoredWakeup {
   115	  const r = row as WakeupRow;
   116	  return {
   117	    id: Number(r.id),
   118	    agentId: String(r.agent_id),
   119	    reason: String(r.reason),
   120	    eventId: r.event_id == null ? null : Number(r.event_id),
   121	    payload: r.payload ?? {},
   122	    delivery: String(r.delivery) as WakeupDelivery,
   123	    dueAt: toIsoOrEmpty(r.due_at),
   124	    claimedAt: toIsoOrNull(r.claimed_at),
   125	    claimToken: r.claim_token == null ? null : String(r.claim_token),
   126	    leaseExpiresAt: toIsoOrNull(r.lease_expires_at),
   127	    completedAt: toIsoOrNull(r.completed_at),
   128	    result: r.result == null ? null : String(r.result),
   129	  };
   130	}
   131	
   132	/**
   133	 * M11b Lane W (P5.1) — the shared ledger-row CTE every enqueue/re-arm insert path splices in.
   134	 *
   135	 * A `webhook_deliveries` row rides the SAME statement as the wakeup it belongs to (`UNIQUE
   136	 * (wakeup_id)`, `ON CONFLICT DO NOTHING`) — never a second auto-committed call, which would let a
   137	 * crash between the two leave a webhook-primary wakeup with no ledger to claim it through. Reached
   138	 * by bare table name (`agent_webhooks`), never by importing `store/webhooks/*`: this module is
   139	 * "kind-agnostic on purpose" (see the file header) and a domain import here would be a layering edge.
   140	 *
   141	 * `rowCteNames` are UNION'd because `ins` and `rearmed` are mutually exclusive by construction (see
   142	 * `createOrReArmWakeup`'s own doc comment) — whichever one actually produced a row is the row this
   143	 * fires for. Gated on `delivery = 'webhook'` OR a live (`disabled_at IS NULL`) `mode = 'both'`
   144	 * registration, matching `resolveWakeupDelivery`'s precedence and P5.1's "mode='both' additionally
   145	 * creates a delivery-ledger row for internal-primary wakeups" rule.
   146	 */
   147	function webhookLedgerCte(rowCteNames: readonly string[], namePrefix = "wh"): string {
   148	  const rowName = `${namePrefix}_row`;
   149	  const union = rowCteNames.map((name) => `SELECT id, agent_id, delivery FROM ${name}`).join("\n      UNION ALL\n      ");
   150	  return `
   151	    ${rowName} AS (
   152	      ${union}
   153	    ),
   154	    ${namePrefix}_ledger AS (
   155	      INSERT INTO webhook_deliveries (wakeup_id, agent_id, next_attempt_at)
   156	      SELECT r.id, r.agent_id, NOW()
   157	      FROM ${rowName} r
   158	      WHERE r.delivery = 'webhook'
   159	         OR EXISTS (
   160	           SELECT 1 FROM agent_webhooks h
   161	           WHERE h.agent_id = r.agent_id AND h.mode = 'both' AND h.disabled_at IS NULL
   162	         )
   163	      ON CONFLICT (wakeup_id) DO NOTHING
   164	      RETURNING wakeup_id
   165	    )`;
   166	}
   167	
   168	/** The INSERT both write paths share, so the column list and the casts have one definition. */
   169	const INSERT_WAKEUP = `
   170	  INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at)
   171	  VALUES ($1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW()))
   172	  ON CONFLICT DO NOTHING
   173	`;
   174	
   175	function insertParams(input: EnqueueWakeupInput | CreateOrReArmWakeupInput): unknown[] {
   176	  return [
   177	    input.agentId,
   178	    input.reason,
   179	    input.eventId,
   180	    JSON.stringify(input.payload ?? {}),
   181	    input.delivery,
   182	    input.dueAt ?? null,
   183	  ];
   184	}
   185	
   186	/**
   187	 * Plain insert. Never re-arms — a completed row stays completed.
   188	 *
   189	 * **The bare `ON CONFLICT DO NOTHING` carries no conflict target, and that is deliberate.** Postgres
   190	 * lets a plain `DO NOTHING` absorb a violation of *any* unique or exclusion constraint on the table,
   191	 * and exactly two partial unique indexes can fire here: `idx_wakeups_dedup_event` when `event_id IS
   192	 * NOT NULL`, and `idx_wakeups_dedup_idle` when `event_id IS NULL AND completed_at IS NULL`. Whichever
   193	 * applies to this row is the one that should suppress the insert, and the caller does not have to
   194	 * know which — naming a target would force it to, and would turn the other index's violation into a
   195	 * raised 23505.
   196	 *
   197	 * Note the asymmetry the two indexes encode: the event-keyed one is NOT partial on `completed_at`,
   198	 * so a completed event-keyed row blocks a second insert forever (only a re-arm reuses it), while a
   199	 * completed idle row stops blocking and a fresh idle wakeup may be enqueued again.
   200	 */
   201	export async function enqueueWakeup(input: EnqueueWakeupInput): Promise<EnqueueWakeupResult> {
   202	  const rows = await sql!(
   203	    `WITH ins AS (
   204	      ${INSERT_WAKEUP}
   205	      RETURNING *
   206	    ),
   207	    ${webhookLedgerCte(["ins"])}
   208	    SELECT ins.* FROM ins`,
   209	    insertParams(input)
   210	  );
   211	  if (rows.length === 0) return { created: false, wakeup: null };
   212	  return { created: true, wakeup: rowToWakeup(rows[0]) };
   213	}
   214	
   215	/**
   216	 * Find-or-create-or-re-arm in ONE statement, keyed by the dedup TRIPLE `(agent_id, reason,
   217	 * event_id)` — never by a numeric row id, because the caller does not know one yet.
   218	 *
   219	 * `eventId` is always non-null on this path, so the bare `ON CONFLICT DO NOTHING` in `ins` can only
   220	 * ever match `idx_wakeups_dedup_event`; the idle index cannot apply to a row with an event id.
   221	 *
   222	 * **The two CTEs are mutually exclusive by construction, so this needs no arbiter.** A freshly
   223	 * inserted row has `completed_at IS NULL`, which `rearmed`'s predicate cannot match, so there is no
   224	 * torn state and no deadlock shape for CLAUDE.md's "sibling data-modifying CTEs need an ARBITER"
   225	 * rule to apply to — the only reachable interleaving is the benign one below.
   226	 *
   227	 * **`created: false, reArmed: false` is a LEGITIMATE outcome, not a bug.** Two callers racing this
   228	 * statement for the same triple when no row exists yet — the router and the sweep reacting to one
   229	 * freshly drained `round_opened` — can BOTH answer false/false: the loser's `ins` correctly no-ops
   230	 * against the winner's now-committed row, while its own `rearmed` CTE is evaluated against a
   231	 * statement snapshot taken before that commit and therefore also sees nothing. After both statements
   232	 * complete exactly one row exists — never zero, never two, because the unique index says so — and
   233	 * that is the only invariant a best-effort nudge queue needs. Do NOT add `FOR UPDATE` or any other
   234	 * arbiter to force one caller to "win" and see it: that buys serialization contention for a
   235	 * reporting gap with no correctness payoff. The loser sees the row already in the state it wanted,
   236	 * next pass.
   237	 */
   238	export async function createOrReArmWakeup(
   239	  input: CreateOrReArmWakeupInput
   240	): Promise<CreateOrReArmWakeupResult> {
   241	  const rows = await sql!(
   242	    `
   243	    /* p3.2:create-or-rearm */
   244	    WITH ins AS (
   245	      ${INSERT_WAKEUP}
   246	      RETURNING *
   247	    ),
   248	    rearmed AS (
   249	      UPDATE agent_wakeups
   250	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   251	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   252	        AND completed_at IS NOT NULL
   253	        AND result IS DISTINCT FROM 'acted'
   254	        AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   255	      RETURNING *
   256	    ),
   257	    ${webhookLedgerCte(["ins", "rearmed"])}
   258	    SELECT (SELECT to_jsonb(ins) FROM ins) AS created_row,
   259	           (SELECT to_jsonb(rearmed) FROM rearmed) AS rearmed_row
   260	  `,
   261	    insertParams(input)
   262	  );
   263	  const row = rows[0] as { created_row: unknown; rearmed_row: unknown } | undefined;
   264	  return {
   265	    created: row?.created_row != null,
   266	    reArmed: row?.rearmed_row != null,
   267	  };
   268	}
   269	
   270	export interface CreateOrReArmPlaygroundRoundWakeupInput {
   271	  agentId: string;
   272	  /** ALWAYS non-null — this path is event-keyed dedup only, like `createOrReArmWakeup`. */
   273	  eventId: number;
   274	  payload: Record<string, unknown>;
   275	  delivery: WakeupDelivery;
   276	  dueAt?: string;
   277	  /** The session whose round this wakeup is for — the live-state gate's subject. */
   278	  sessionId: string;
   279	  round: number;
   280	}
   281	
   282	/**
   283	 * The one reason this gated path arms. A constant, not a parameter: the gate below reads playground
   284	 * tables, so the operation is playground-specific by nature, and both callers (the wakeup-router
   285	 * consumer and the deadline sweep) must spell the reason identically or the dedup triple splits.
   286	 */
   287	export const PLAYGROUND_ROUND_REASON = "playground_round";
   288	
   289	/**
   290	 * `createOrReArmWakeup`, but for `playground_round` — with the freshness check INSIDE the statement,
   291	 * under a lock (codex u5-C round 1 MAJOR).
   292	 *
   293	 * Both callers used to pre-read the session (active, `current_round` matches, agent un-acted) and
   294	 * then await other work before inserting. A pre-read that RETURNS competes with the decisive
   295	 * statement and loses (CLAUDE.md): a session advancing to round N+1 in that window let a stale
   296	 * round-N wakeup land beside the legitimate round-N+1 one — two claimable rows for one agent,
   297	 * double budget the moment P3.3's runner exists, because the event-keyed dedup index sees two
   298	 * different event ids.
   299	 *
   300	 * So `live` re-checks the session AND the agent's action at insert time, and takes the session row
   301	 * `FOR SHARE` — never a bare `EXISTS`, which is snapshot-evaluated and never re-checked. The
   302	 * advancement CAS is an `UPDATE` of that same row, so `FOR SHARE` either sees its committed round
   303	 * (and arms nothing) or blocks it until this statement commits (and the CAS then advances a session
   304	 * whose stale-round wakeup was never created). The action `NOT EXISTS` stays unlocked deliberately:
   305	 * a just-acted agent's wakeup is only wasted budget, and `submitAction`'s duplicate-per-round
   306	 * rejection already refuses the turn — the plan frames that check as budget protection, not
   307	 * correctness. Both arms — the insert AND the re-arm — gate on `live`, so a dead round can neither
   308	 * gain a new row nor resurrect a completed one.
   309	 *
   310	 * Lock order is `playground_sessions → agents` (the insert's FK takes `FOR KEY SHARE` on the
   311	 * agent), the same order `submitAction`'s gated insert takes; nothing in the tree takes an agent
   312	 * lock before a session lock, so no cycle is introduced.
   313	 */
   314	export async function createOrReArmPlaygroundRoundWakeup(
   315	  input: CreateOrReArmPlaygroundRoundWakeupInput
   316	): Promise<CreateOrReArmWakeupResult> {
   317	  const rows = await sql!(
   318	    `
   319	    /* p3.2:playground-round-arm */
   320	    WITH live AS (
   321	      SELECT s.id FROM playground_sessions s
   322	      WHERE s.id = $7 AND s.status = 'active' AND s.current_round = $8
   323	        AND NOT EXISTS (
   324	          SELECT 1 FROM playground_actions a
   325	          WHERE a.session_id = s.id AND a.agent_id = $1 AND a.round = $8
   326	        )
   327	      FOR SHARE OF s
   328	    ),
   329	    ins AS (
   330	      INSERT INTO agent_wakeups (agent_id, reason, event_id, payload, delivery, due_at)
   331	      SELECT $1, $2, $3, $4::jsonb, $5, COALESCE($6::timestamptz, NOW())
   332	      FROM live
   333	      ON CONFLICT DO NOTHING
   334	      RETURNING *
   335	    ),
   336	    rearmed AS (
   337	      UPDATE agent_wakeups
   338	      SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   339	      WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   340	        AND EXISTS (SELECT 1 FROM live)
   341	        AND completed_at IS NOT NULL
   342	        AND result IS DISTINCT FROM 'acted'
   343	        AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   344	      RETURNING *
   345	    ),
   346	    ${webhookLedgerCte(["ins", "rearmed"])}
   347	    SELECT (SELECT to_jsonb(ins) FROM ins) AS created_row,
   348	           (SELECT to_jsonb(rearmed) FROM rearmed) AS rearmed_row
   349	  `,
   350	    [
   351	      ...insertParams({
   352	        agentId: input.agentId,
   353	        reason: PLAYGROUND_ROUND_REASON,
   354	        eventId: input.eventId,
   355	        payload: input.payload,
   356	        delivery: input.delivery,
   357	        dueAt: input.dueAt,
   358	      }),
   359	      input.sessionId,
   360	      input.round,
   361	    ]
   362	  );
   363	  const row = rows[0] as { created_row: unknown; rearmed_row: unknown } | undefined;
   364	  return {
   365	    created: row?.created_row != null,
   366	    reArmed: row?.rearmed_row != null,
   367	  };
   368	}
   369	
   370	/**
   371	 * The NORMATIVE re-arm predicate, standalone, by a KNOWN numeric id.
   372	 *
   373	 * For a caller that already holds the row — a future runner will; nothing in THIS lane does. The
   374	 * predicate is `ai/PLAN_M11_2.md` P3.2's normative text verbatim: **do not add, remove or reorder a
   375	 * clause.** Each one is load-bearing:
   376	 *  - `completed_at IS NOT NULL` — a live claim, even a lease-expired one housekeeping has not
   377	 *    abandoned yet, is never touched;
   378	 *  - `result IS DISTINCT FROM 'acted'` — an agent that actually acted does not get a second turn;
   379	 *  - `result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE` — a wakeup
   380	 *    refused for budget is re-armable tomorrow, when the daily bucket rolls over, and not before.
   381	 *
   382	 * Clearing `claim_token` is what makes abandonment final for a superseded runner: its own renewal
   383	 * (`… WHERE claim_token = $token AND completed_at IS NULL`) fails from that moment on.
   384	 */
   385	export async function reArmWakeupById(id: number): Promise<boolean> {
   386	  const rows = await sql!(
   387	    `
   388	    UPDATE agent_wakeups
   389	    SET claimed_at = NULL, claim_token = NULL, lease_expires_at = NULL, completed_at = NULL, result = NULL
   390	    WHERE id = $1 AND completed_at IS NOT NULL AND result IS DISTINCT FROM 'acted'
   391	      AND (result IS DISTINCT FROM 'budget_exhausted' OR completed_at::date < CURRENT_DATE)
   392	    RETURNING id
   393	  `,
   394	    [id]
   395	  );
   396	  return rows.length > 0;
   397	}
   398	
   399	export async function getWakeupByAgentReasonEvent(
   400	  agentId: string,
   401	  reason: string,
   402	  eventId: number
   403	): Promise<StoredWakeup | null> {
   404	  const rows = await sql!(
   405	    `SELECT * FROM agent_wakeups
   406	     WHERE agent_id = $1 AND reason = $2 AND event_id = $3
   407	     LIMIT 1`,
   408	    [agentId, reason, eventId]
   409	  );
   410	  return rows.length > 0 ? rowToWakeup(rows[0]) : null;
   411	}
   412	
   413	/**
   414	 * One agent's wakeups, newest first.
   415	 *
   416	 * Ordered by `id`, not by `due_at`: a sweep arms a whole round's participants from one `NOW()`, so
   417	 * `due_at` ties are the ordinary case and an order that can tie makes a limited read
   418	 * nondeterministic. This is a diagnostic/adjacent-caller read, not the runner's scan — the runner's
   419	 * scan is `idx_wakeups_due` and belongs to P3.3.
   420	 */
   421	export async function listWakeupsForAgent(
   422	  agentId: string,
   423	  options?: { reason?: string; limit?: number }
   424	): Promise<StoredWakeup[]> {
   425	  const rows = await sql!(
   426	    `SELECT * FROM agent_wakeups
   427	     WHERE agent_id = $1 AND ($2::text IS NULL OR reason = $2::text)
   428	     ORDER BY id DESC
   429	     LIMIT $3`,
   430	    [agentId, options?.reason ?? null, normalizeListLimit(options?.limit)]
   431	  );
   432	  return (rows as unknown[]).map(rowToWakeup);
   433	}
   434	
   435	/** Shared by both stores: a limit is at least 1, an integer, and defaults to the page size. */
   436	export function normalizeListLimit(limit: number | undefined): number {
   437	  return Math.max(1, Math.floor(limit ?? DEFAULT_WAKEUP_LIST_LIMIT));
   438	}
   439	
   440	/**
   441	 * The `playground.round_opened` event id for `(sessionId, round)` — real or reconstructed — newest
   442	 * first.
   443	 *
   444	 * There should only ever be one per (session, round): the producers' gating and the rollout bridge's
   445	 * `idem_key` both say so. "Newest first, limit 1" is the defensive read against a history that
   446	 * nonetheless holds two.
   447	 *
   448	 * A plain `SELECT` with no lock: `events` is an append-only log and this is a read. The session id
   449	 * is matched on the `subject_id` COLUMN — the payload's `session_id` copy exists so a consumer can
   450	 * re-verify the two agree (the `requireCorrelation` pattern), and re-verifying it here would refuse
   451	 * to locate an otherwise valid event whose payload copy is absent. The round has no column of its
   452	 * own and must be read out of the payload.
   453	 */
   454	export async function findRoundOpenedEventId(sessionId: string, round: number): Promise<number | null> {
   455	  // `payload.round` is a jsonb NUMBER and every producer writes an integer, so a non-integer cannot
   456	  // match anything. Answered here rather than by casting to `int` in SQL, which ROUNDS — `2.7::int`
   457	  // would silently look up round 3, and the memory store would answer something else.
   458	  if (!Number.isInteger(round)) return null;
   459	  const rows = await sql!(
   460	    `SELECT id FROM events
   461	     WHERE kind = $1 AND subject_id = $2 AND payload->'round' = to_jsonb($3::int)
   462	     ORDER BY id DESC
   463	     LIMIT 1`,
   464	    [ROUND_OPENED_KIND, sessionId, round]
   465	  );
   466	  return rows.length > 0 ? Number((rows[0] as { id: number | string }).id) : null;
   467	}
   468	
   469	/**
   470	 * Delivery resolution, in ONE place. **P5.1 joins it here**: loop-enabled ⇒ `internal`; else a live
   471	 * (`disabled_at IS NULL`) `agent_webhooks` row ⇒ `webhook`; else `null` — the caller creates nothing.
   472	 * `none` stays unresolved by design (P5.1: "a row nobody consumes is bloat").
   473	 */
   474	export async function resolveWakeupDelivery(agentId: string): Promise<"internal" | "webhook" | null> {
   475	  const state = await getLoopState(agentId);
   476	  if (state?.enabled === true) return "internal";
   477	  const rows = await sql!(
   478	    `SELECT 1 FROM agent_webhooks WHERE agent_id = $1 AND disabled_at IS NULL LIMIT 1`,
   479	    [agentId]
   480	  );
   481	  return rows.length > 0 ? "webhook" : null;
   482	}
   483	
   484	/**
   485	 * M11-2 P3.3 (train a4) — the wakeup runner's claim, lease-renewal, completion and housekeeping
   486	 * writers, joining P3.2's enqueue/re-arm exports above in the same module.
   487	 *
   488	 * `claimNextWakeup` is `ai/PLAN_M11_2.md`'s P3.3 claim statement, TRANSCRIBED — not redesigned. The
   489	 * plan writes its four inputs as named placeholders; they became real params here (`$1`=claimToken,
   490	 * `$2`=leaseMs, `$3`=playgroundCap, `$4`=generalCap) and nothing else about the SQL shape changed.
   491	 *
   492	 * Every runner-owned write below is TOKEN-FENCED — `WHERE id = $id AND claim_token = $token AND
   493	 * completed_at IS NULL` — per CLAUDE.md's documented pattern for this family: lease renewal and every
   494	 * completion write carry it, so a stale runner that resumed after abandonment + re-arm gets zero rows
   495	 * back from every one of them and can neither complete the row nor extend its lease out from under
   496	 * the new claimant. The two housekeeping sweeps at the bottom are deliberately NOT token-fenced: they
   497	 * are system-driven, hold no runner's token to fence with, and their whole job is to close out rows
   498	 * whose owning runner is presumed gone (an expired lease) or whose agent went disabled mid-queue.
   499	 */
   500	
   501	export interface ClaimNextWakeupInput {
