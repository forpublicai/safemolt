     1	/**
     2	 * M11b Lane W (P5.1) `[integration]` — the webhook registration + delivery ledger against a real
     3	 * Postgres. What only a database can show:
     4	 *  - `claimNextWebhookDelivery`'s `FOR UPDATE SKIP LOCKED` exactly-one-winner shape;
     5	 *  - the token fence on `recordWebhookAttempt` refusing a stale claim after a reclaim;
     6	 *  - the terminal-ledger / webhook-primary-wakeup coupling, decided by real `RETURNING` gates, not
     7	 *    by application code;
     8	 *  - the `ON DELETE CASCADE` FKs on agent withdrawal.
     9	 *
    10	 * `agent_webhooks.agent_id`, `webhook_deliveries.agent_id` and `webhook_deliveries.wakeup_id` all
    11	 * carry `REFERENCES ... ON DELETE CASCADE` (P5.1 Decision 10), so every fixture row hangs off a real
    12	 * seeded agent, exactly as `m11-2-u5-wakeups.test.ts` (this file's template) requires for
    13	 * `agent_wakeups`.
    14	 */
    15	import {
    16	  claimNextWebhookDelivery,
    17	  deleteAgentWebhook,
    18	  getAgentWebhook,
    19	  recordWebhookAttempt,
    20	  upsertAgentWebhook,
    21	} from "@/lib/store/webhooks/db";
    22	import { enqueueWakeup } from "@/lib/store/wakeups/db";
    23	import { deleteAgent } from "@/lib/store/agents/db";
    24	import { registerWebhook } from "@/lib/actions/webhooks";
    25	import type { StoredAgent } from "@/lib/store-types";
    26	import { closeIntegrationConnections, pgPool } from "./helpers/db";
    27	import { rejections, runConcurrently } from "./helpers/concurrency";
    28	
    29	const RUN = `${Date.now().toString(36)}_${Math.floor(Math.random() * 1e6).toString(36)}`;
    30	let seq = 0;
    31	const nextId = (kind: string) => `b1w_${kind}_${RUN}_${(seq += 1)}`;
    32	
    33	/**
    34	 * A fresh BIGINT for `agent_wakeups.event_id` / `reason` dedup — never a real `events` row, exactly
    35	 * like `m11-2-u5-wakeups.test.ts`'s `nextEventId`. Each call gets a distinct value so the wakeup
    36	 * dedup indexes (`idx_wakeups_dedup_event`) never collide across this file's own tests.
    37	 */
    38	let syntheticEventId = 950_000_000;
    39	const nextEventId = () => (syntheticEventId += 1);
    40	
    41	async function seedAgent(): Promise<string> {
    42	  const id = nextId("agent");
    43	  await pgPool().query(
    44	    `INSERT INTO agents (id, name, description, api_key, points, vote_points, evaluation_points,
    45	                         legacy_unattributed_points, follower_count, is_claimed, created_at, is_vetted)
    46	     VALUES ($1, $1, '', $2, 0, 0, 0, 0, 0, false, NOW(), true)`,
    47	    [id, `b1w_key_${id}`]
    48	  );
    49	  return id;
    50	}
    51	
    52	/** A webhook-primary wakeup, via the real enqueue path — its ledger row rides the same statement. */
    53	async function seedWebhookWakeup(agentId: string): Promise<number> {
    54	  const result = await enqueueWakeup({
    55	    agentId,
    56	    reason: "b1w_reason",
    57	    eventId: nextEventId(),
    58	    payload: { run: RUN },
    59	    delivery: "webhook",
    60	  });
    61	  if (!result.wakeup) throw new Error("expected a fresh wakeup row");
    62	  return result.wakeup.id;
    63	}
    64	
    65	/** An internal-primary wakeup — only gets a ledger row when the agent's registration is `mode='both'`. */
    66	async function seedInternalWakeup(agentId: string): Promise<number> {
    67	  const result = await enqueueWakeup({
    68	    agentId,
    69	    reason: "b1w_internal_reason",
    70	    eventId: nextEventId(),
    71	    payload: { run: RUN },
    72	    delivery: "internal",
    73	  });
    74	  if (!result.wakeup) throw new Error("expected a fresh wakeup row");
    75	  return result.wakeup.id;
    76	}
    77	
    78	async function ledgerRowForWakeup(wakeupId: number): Promise<Record<string, unknown>> {
    79	  const { rows } = await pgPool().query(`SELECT * FROM webhook_deliveries WHERE wakeup_id = $1`, [wakeupId]);
    80	  if (rows.length === 0) throw new Error(`expected a ledger row for wakeup ${wakeupId}`);
    81	  return rows[0] as Record<string, unknown>;
    82	}
    83	
    84	async function wakeupRow(wakeupId: number): Promise<Record<string, unknown>> {
    85	  const { rows } = await pgPool().query(`SELECT * FROM agent_wakeups WHERE id = $1`, [wakeupId]);
    86	  return rows[0] as Record<string, unknown>;
    87	}
    88	
    89	async function backdateLease(deliveryId: number): Promise<void> {
    90	  await pgPool().query(
    91	    `UPDATE webhook_deliveries SET lease_expires_at = NOW() - INTERVAL '1 hour' WHERE id = $1`,
    92	    [deliveryId]
    93	  );
    94	}
    95	
    96	/**
    97	 * The coupling gate, reusable across the three terminal paths: a terminal ledger row may never pair
    98	 * with a nonterminal webhook-primary wakeup, and — the opposite direction, exercised by a `mode='both'`
    99	 * ledger — a terminal ledger must never complete a wakeup that is not itself webhook-primary.
   100	 */
   101	async function assertLedgerWakeupCoupling(wakeupId: number): Promise<void> {
   102	  const ledger = await ledgerRowForWakeup(wakeupId);
   103	  const wakeup = await wakeupRow(wakeupId);
   104	  expect(ledger.terminal_reason).not.toBeNull();
   105	  if (wakeup.delivery === "webhook") {
   106	    expect(wakeup.completed_at).not.toBeNull();
   107	  } else {
   108	    expect(wakeup.completed_at).toBeNull();
   109	  }
   110	}
