   114	    return rows().find(
   115	      (row) => row.agentId === agentId && row.reason === reason && row.eventId === eventId
   116	    );
   117	  }
   118	  return rows().find(
   119	    (row) =>
   120	      row.agentId === agentId &&
   121	      row.reason === reason &&
   122	      row.eventId === null &&
   123	      row.completedAt === null
   124	  );
   125	}
