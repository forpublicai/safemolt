export const TEST_NAME_PATTERN = /(^|[-_])(test|e2e|probe|fixture|system)([-_]|$)|^(test|e2e|probe|system)/i;

function metadata(agent: Pick<StoredAgent, "metadata">): Record<string, unknown> {
