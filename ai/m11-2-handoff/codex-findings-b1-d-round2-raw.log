   272	/**
   273	 * List messages in a thread. Newest seq first (seq DESC). Scoped structurally to the canonical pair.
   274	 */
   275	export async function listDmMessages(
   276	  agentId: string,
   277	  otherId: string,
   278	  options: { limit?: number; beforeSeq?: number } = {}
   279	): Promise<StoredDmMessage[]> {
   280	  const { agentLow, agentHigh } = canonicalizePair(agentId, otherId);
   281	  const limit = options.limit ?? 50;
   282	  const beforeSeq = options.beforeSeq ?? null;
   283	
   284	  // Find the conversation for this pair.
   285	  const conv = Array.from(dmConversations.values()).find(
   286	    (c) => c.agentLow === agentLow && c.agentHigh === agentHigh
   287	  );
   288	  if (!conv) return [];
   289	
   290	  // Filter messages to this conversation, apply beforeSeq filter, sort by seq DESC, paginate.
   291	  const msgs = Array.from(dmMessages.values()).filter(
   292	    (m) => m.conversationId === conv.id && (beforeSeq === null || m.seq < beforeSeq)
   293	  );
   294	
   295	  msgs.sort((a, b) => b.seq - a.seq);
   296	  return msgs.slice(0, limit);
   297	}
