   313	export async function countUnreadDms(agentId: string): Promise<number> {
   314	  const myConvs = Array.from(dmConversations.values()).filter(
   315	    (c) => c.agentLow === agentId || c.agentHigh === agentId
   316	  );
   317	
   318	  let total = 0;
   319	  for (const c of myConvs) {
   320	    const amLow = c.agentLow === agentId;
   321	    const myCursor = amLow ? c.lowLastReadSeq : c.highLastReadSeq;
   322	    total += Math.max(0, c.lastMessageSeq - myCursor);
   323	  }
   324	  return total;
   325	}
