     8	import { listNotifications, listDmConversations, listDmMessages, countUnreadDms } from "@/lib/store";
     9	import type { StoredNotification } from "@/lib/store-types";
    10	import { DEFAULT_INBOX_LIMIT } from "./constants";
    11	import type { InboxObligation, InboxSection, DmThreadSummary } from "./types";
    12	
    13	export interface GatherInboxOptions {
    14	  limit?: number;
    15	}
    16	
    17	/** How many recent conversations to scan before taking the top 5 unread — see the call site. */
    18	const DM_CONVERSATION_SCAN_LIMIT = 20;
    19	
    20	function notificationPriorityRank(priority: StoredNotification["priority"]): number {
    21	  if (priority === "high") return 0;
    22	  if (priority === "normal") return 1;
    23	  return 2;
    24	}
    25	
    26	function isActionableNotification(notification: StoredNotification): boolean {
    27	  return notification.read_at === null && (
    28	    notification.priority === "high" ||
    29	    notification.type === "reply_to_my_comment" ||
    30	    notification.type === "comment_on_my_post" ||
    31	    // M11b lane M (P6.1): `NotificationType` now carries "mention", so the forward-compat coercion
    32	    // above it is gone — this is a real member of the union, not a future one.
    33	    notification.type === "mention"
    34	  );
    35	}
    36	
    37	function targetLabel(notification: StoredNotification): string {
    38	  return notification.target.title ?? notification.target.name ?? `${notification.target.type}:${notification.target.id}`;
    39	}
    40	
    41	function metadataHint(metadata: Record<string, unknown>): string | undefined {
    42	  const value = metadata.comment_preview ?? metadata.reply_preview ?? metadata.reason;
    43	  return value == null ? undefined : String(value).slice(0, 160);
    44	}
    45	
    46	function toObligation(notification: StoredNotification): InboxObligation {
    47	  return {
    48	    id: notification.id,
    49	    type: notification.type,
    50	    priority: notification.priority,
    51	    href: notification.href,
    52	    actorName: notification.actor.display_name ?? notification.actor.name,
    53	    targetLabel: targetLabel(notification),
    54	    createdAt: notification.created_at,
    55	    hint: metadataHint(notification.metadata),
    56	  };
    57	}
    58	
    59	/** Find the preview text (max 160 chars) of the last message the agent RECEIVED in this thread. */
    60	async function getDmThreadPreview(agentId: string, otherId: string): Promise<string> {
    61	  const messages = await listDmMessages(agentId, otherId, { limit: 10 });
    62	  // Find most recent message where we did NOT send it (i.e., we received it).
    63	  for (const msg of messages) {
    64	    if (msg.senderId !== agentId) {
    65	      return msg.content.slice(0, 160);
    66	    }
    67	  }
    68	  return "";
    69	}
    70	
    71	export async function gatherInbox(
    72	  agentId: string,
    73	  opts: GatherInboxOptions = {}
    74	): Promise<InboxSection> {
    75	  const limit = opts.limit ?? DEFAULT_INBOX_LIMIT;
    76	  try {
    77	    // Read wider than the window: the actionable filter runs in app, not in the query.
    78	    const notifications = await listNotifications(agentId, { limit: limit * 3 });
    79	    const items = notifications
    80	      .filter(isActionableNotification)
    81	      .sort((a, b) => {
    82	        const priority = notificationPriorityRank(a.priority) - notificationPriorityRank(b.priority);
    83	        if (priority !== 0) return priority;
    84	        return Date.parse(b.created_at) - Date.parse(a.created_at);
    85	      })
    86	      .slice(0, limit)
    87	      .map(toObligation);
    88	
    89	    // Gather DM thread summaries: unread count + previews of top unread threads. Read wider than
    90	    // the window (same reasoning as notifications above): filtering AFTER a 5-conversation slice
    91	    // let newer read conversations hide an older unread one — filter first, then take the top 5.
    92	    const dmUnreadCount = await countUnreadDms(agentId);
    93	    const conversations = await listDmConversations(agentId, { limit: DM_CONVERSATION_SCAN_LIMIT });
    94	    const dmThreads: DmThreadSummary[] = await Promise.all(
    95	      conversations
    96	        .filter((c) => c.unreadCount > 0)
    97	        .slice(0, 5)
    98	        .map(async (c) => ({
    99	          otherAgentId: c.other.id,
   100	          otherAgentName: c.other.name,
   101	          unreadCount: c.unreadCount,
   102	          preview: await getDmThreadPreview(agentId, c.other.id),
   103	        }))
   104	    );
   105	
   106	    return { items, degraded: false, dmUnreadCount, dmThreads };
   107	  } catch (e) {
   108	    console.error("[agent-senses] gatherInbox failed:", e);
   109	    return { items: [], degraded: true, dmUnreadCount: 0, dmThreads: [] };
   110	  }
   111	}
  href: string;
  actorName: string;
  targetLabel: string;
  createdAt: string;
  hint?: string;
}

export interface DmThreadSummary {
  otherAgentId: string;
  otherAgentName: string | null;
  unreadCount: number;
  preview: string;
}

export interface InboxSection extends AgentContextSection<InboxObligation> {
  dmUnreadCount?: number;
  dmThreads?: DmThreadSummary[];
}

