   184	    ? events.map((event, index) =>
   185	        index === 0
   186	          ? ({
   187	              ...event,
   188	              subjectId: conversationId,
   189	              payload: {
   190	                ...(event.payload as Record<string, unknown>),
   191	                conversation_id: conversationId,
   192	                target_agent_id: otherId,
   193	              },
   194	            } as PreparedEvent)
   195	          : event
   196	      )
   197	    : events;
   198	  const batch = prepareEventBatch(prepared);
   199	
   200	  const conv = existing ?? {
   201	    id: conversationId,
   202	    agentLow,
   203	    agentHigh,
   204	    lowBlockedHigh: false,
   205	    highBlockedLow: false,
   206	    lowLastReadSeq: 0,
   207	    highLastReadSeq: 0,
   208	    lastMessageSeq: 0,
   209	    createdAt: now,
   210	    lastMessageAt: null,
   211	  };
