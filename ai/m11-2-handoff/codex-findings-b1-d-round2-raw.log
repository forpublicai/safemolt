   221	/**
   222	 * List the agent's conversations. Newest activity first (by last_message_at DESC, then created_at DESC).
   223	 * Includes unread count (last_message_seq - my_last_read_seq). Other participant may be deleted.
   224	 */
   225	export async function listDmConversations(
   226	  agentId: string,
   227	  options: { limit?: number; offset?: number } = {}
   228	): Promise<StoredDmConversation[]> {
   229	  const limit = options.limit ?? 20;
   230	  const offset = options.offset ?? 0;
   231	
   232	  const myConvs = Array.from(dmConversations.values()).filter(
   233	    (c) => c.agentLow === agentId || c.agentHigh === agentId
   234	  );
   235	
   236	  // Compute unread for each and determine other agent.
   237	  const withUnread = myConvs.map((c) => {
   238	    const amLow = c.agentLow === agentId;
   239	    const otherId = amLow ? c.agentHigh : c.agentLow;
   240	    const myReadCursor = amLow ? c.lowLastReadSeq : c.highLastReadSeq;
   241	    const unread = Math.max(0, c.lastMessageSeq - myReadCursor);
   242	    return { conv: c, otherId, unread };
   243	  });
   244	
   245	  // Sort by last_message_at DESC, then created_at DESC (nulls last).
   246	  withUnread.sort((a, b) => {
   247	    if (a.conv.lastMessageAt === null && b.conv.lastMessageAt === null) {
   248	      return new Date(b.conv.createdAt).getTime() - new Date(a.conv.createdAt).getTime();
   249	    }
   250	    if (a.conv.lastMessageAt === null) return 1;
   251	    if (b.conv.lastMessageAt === null) return -1;
   252	    const timeDiff =
   253	      new Date(b.conv.lastMessageAt).getTime() - new Date(a.conv.lastMessageAt).getTime();
   254	    if (timeDiff !== 0) return timeDiff;
   255	    return new Date(b.conv.createdAt).getTime() - new Date(a.conv.createdAt).getTime();
   256	  });
   257	
   258	  // Paginate.
   259	  const page = withUnread.slice(offset, offset + limit);
   260	
   261	  return page.map(({ conv, otherId, unread }) => {
   262	    const otherAgent = agents.get(otherId);
   263	    return {
   264	      id: conv.id,
   265	      other: { id: otherId, name: otherAgent?.name ?? null, deleted: !otherAgent },
   266	      lastMessageAt: conv.lastMessageAt,
   267	      unreadCount: unread,
   268	    };
   269	  });
   270	}
