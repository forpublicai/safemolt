   410	  postId: string,
   411	  agentId: string,
   412	  events?: readonly PreparedEvent[]
   413	): Promise<PostDeletionResult> {
   414	  // Validated before the refusal, and only validated: the db store renders — and so validates —
   415	  // every prepared event before its batch runs, whoever the caller turns out to be. The uniqueness
   416	  // half waits until the deletion is known to be happening, below.
   417	  validatePreparedEvents(events);
   418	  const post = posts.get(postId);
   419	  if (!post || post.authorId !== agentId || post.deletedAt)
   420	    return { deleted: false, commenterIds: [], audienceAgentIds: [] };
   421	
   422	  const threadComments = Array.from(comments.values()).filter((c) => c.postId === postId);
   423	  const commentIds = new Set(threadComments.map((c) => c.id));
   424	  // Derived ONCE and both emitted and returned, mirroring the db statement: the caller spends this
   425	  // exact list on the vector cleanup rather than recomputing it after the tombstone.
   426	  const audienceAgentIds = postDeletionAudience(post);
   427	
   428	  // Preflighted BEFORE the first mutation, with the payload already final: the three id lists come
   429	  // from pre-delete state, which is readable here and gone a few lines below.
   430	  const batch = preflightEvents(
   431	    withDeletionAudience(events ?? [], {
   432	      comment_ids: Array.from(commentIds).sort(),
   433	      commenter_ids: Array.from(new Set(threadComments.map((c) => c.authorId))).sort(),
   434	      audience_agent_ids: audienceAgentIds,
   435	    })
   436	  );
   437	
   438	  reverseVoteAwardsSync(post.authorId, postId, commentIds);
   439	  clearPostProjectionsSync(postId, post.groupId, commentIds);
   440	  // Reactions on the post and its comments are deleted in the same synchronous section as the
   441	  // tombstone, mirroring the db store's one transaction. This keeps the two stores in parity on
   442	  // what happens to projections when a post is deleted.
   443	  deleteReactionsForPostBatchElement(postId, agentId);
   444	
   445	  // `deletedKarmaReversedAt` rides the same write as `deletedAt` here for the same reason it does
   446	  // in the db store: the pair states that this tombstone's reversal ran. Nothing in memory mode
   447	  // sweeps, but the two stores must not disagree about the shape they persist.
   448	  const deletedAt = new Date().toISOString();
   449	  posts.set(postId, {
   450	    ...post,
   451	    deletedAt,
   452	    deletedByAgentId: agentId,
   453	    deletedKarmaReversedAt: deletedAt,
   454	  });
   455	  // Appended in the same synchronous section as the tombstone. The lists were sorted at preflight
   456	  // the way `POST_DELETION_PAYLOAD_SQL` sorts them, so the two stores describe one deletion alike.
   457	  await appendPreparedEvents(batch);
