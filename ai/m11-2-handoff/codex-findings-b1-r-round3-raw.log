    33	/** Set REACTION_DAILY_LIMIT for the duration of `run`, restoring whatever was there before. */
    34	async function withDailyLimit<T>(limit: number, run: () => Promise<T>): Promise<T> {
    35	  const prev = process.env.REACTION_DAILY_LIMIT;
    36	  process.env.REACTION_DAILY_LIMIT = String(limit);
    37	  try {
    38	    return await run();
    39	  } finally {
    40	    if (prev === undefined) delete process.env.REACTION_DAILY_LIMIT;
    41	    else process.env.REACTION_DAILY_LIMIT = prev;
    42	  }
    43	}
