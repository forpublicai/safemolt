   421	    // row at all (a row that does not exist yet is simply invisible to it, never blocking).
   422	    expect((await addReaction({ agent: reactor, subjectType: "post", subjectId, emoji: "🎉" })).ok).toBe(true);
   423	    const { subjectId: secondSubject } = await makeSubject("post", author, group);
   424	
   425	    // codex round 2, finding 1: `pre`'s old `FOR UPDATE` conflicts with `FOR KEY SHARE`, so a
   426	    // reaction holding it while a withdrawal holds the actor's `agents` row (wanting THIS row via
   427	    // its `agent_rate_limits` FK check) deadlocked (40P01). `FOR NO KEY UPDATE` does not conflict.
   428	    const race = await raceAgainstHeldLock({
   429	      hold: async (holder) => {
   430	        await holder.query("SELECT agent_id FROM agent_rate_limits WHERE agent_id = $1 FOR KEY SHARE", [reactor.id]);
   431	      },
   432	      contend: () => addReaction({ agent: reactor, subjectType: "post", subjectId: secondSubject, emoji: "👍" }),
   433	      // `pre` (statement 2), not the seed (statement 1): the seed's own no-op update is already a
   434	      // non-key lock either way, so the deadlock's actual site is `pre`'s explicit lock mode.
   435	      contenderMarker: "race:b1r-pre-lock",
   436	    });
   437	
   438	    // Mutation check: reverting `pre` to `FOR UPDATE` (and the seed's no-op back to the key column)
   439	    // flips this to `true` — the reaction queues behind the held FOR KEY SHARE instead of proceeding.
   440	    expect(race.observedBlocked).toBe(false);
   441	    expect(race.result.ok).toBe(true);
   442	  });
   443	});
