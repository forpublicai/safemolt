   414	describe("F1: the seed's rate-row lock does not deadlock with a withdrawal's FK check", () => {
   415	  it("does NOT block a concurrent FOR KEY SHARE — the mode a withdrawal's own RI check takes", async () => {
   416	    const author = await seedAgent();
